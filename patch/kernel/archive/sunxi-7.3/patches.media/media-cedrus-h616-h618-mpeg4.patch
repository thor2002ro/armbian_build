diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_mpeg4.c b/drivers/staging/media/sunxi/cedrus/cedrus_mpeg4.c
new file mode 100644
--- /dev/null
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_mpeg4.c
@@ -0,0 +1,298 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/dma-mapping.h>
+#include <linux/reset.h>
+#include <linux/sizes.h>
+#include <linux/slab.h>
+#include <media/mpeg4-ctrls.h>
+#include <media/videobuf2-dma-contig.h>
+#include "cedrus.h"
+#include "cedrus_hw.h"
+#include "cedrus_regs.h"
+
+#define MP4_REG(n) (VE_ENGINE_DEC_MPEG + (n))
+#define MP4_IRQ_MASK 15
+
+int cedrus_mpeg4_validate(const struct v4l2_ctrl_mpeg4_frame *f)
+{
+	unsigned int i, total;
+
+	if (!f || f->width < 16 || f->width > 4096 ||
+	    f->height < 16 || f->height > 4096 || f->picture_type > 2 ||
+	    f->forward_code < 1 || f->forward_code > 7 ||
+	    f->backward_code < 1 || f->backward_code > 7 || f->backward_type > 1 ||
+	    (f->flags & ~31U) || f->reserved[0] || f->reserved[1] ||
+	    !f->bitstream_size || f->bitstream_size > SZ_16M ||
+	    !f->num_packets || f->num_packets > V4L2_MPEG4_MAX_PACKETS ||
+	    (f->picture_type && !f->reference_ts[0]) ||
+	    (f->picture_type == 2 && (!f->reference_ts[1] || !f->trd || f->trb >= f->trd)))
+		return -EINVAL;
+	if ((f->flags & V4L2_MPEG4_SHORT_HEADER) &&
+	    (f->picture_type == 2 ||
+	     (f->flags & (V4L2_MPEG4_MPEG_QUANT | V4L2_MPEG4_QUARTER_SAMPLE))))
+		return -EINVAL;
+	total = DIV_ROUND_UP(f->width, 16) * DIV_ROUND_UP(f->height, 16);
+	for (i = 0; i < f->num_packets; i++) {
+		const struct v4l2_mpeg4_packet *p = &f->packets[i];
+
+		if (p->bit_offset >= f->bitstream_size * 8 || p->first_mb >= total ||
+		    !p->quantizer || p->quantizer > 31 || p->intra_dc_threshold > 7 ||
+		    (!i && p->first_mb) ||
+		    (i && (p->first_mb <= f->packets[i - 1].first_mb ||
+			   p->bit_offset <= f->packets[i - 1].bit_offset)))
+			return -EINVAL;
+	}
+	if (f->flags & V4L2_MPEG4_MPEG_QUANT)
+		for (i = 0; i < 64; i++)
+			if (!f->intra_quant[i] || !f->inter_quant[i])
+				return -EINVAL;
+	return 0;
+}
+
+static void cedrus_mpeg4_packet(struct cedrus_ctx *ctx, bool first)
+{
+	const struct v4l2_ctrl_mpeg4_frame *f = ctx->codec.mpeg4.frame;
+	const struct v4l2_mpeg4_packet *p = &f->packets[ctx->codec.mpeg4.packet];
+	unsigned int end = ctx->codec.mpeg4.packet + 1 < f->num_packets ?
+		f->packets[ctx->codec.mpeg4.packet + 1].first_mb :
+		DIV_ROUND_UP(f->width, 16) * DIV_ROUND_UP(f->height, 16);
+	unsigned int width = DIV_ROUND_UP(f->width, 16);
+	struct cedrus_dev *dev = ctx->dev;
+	u32 header, length;
+
+	ctx->codec.mpeg4.count = min(end - ctx->codec.mpeg4.mb, 32767U);
+	header = f->backward_code | f->forward_code << 3 |
+		 p->intra_dc_threshold << 8 | f->picture_type << 18 |
+		 !!(f->flags & V4L2_MPEG4_NO_ROUNDING) << 17 |
+		 !!(f->flags & V4L2_MPEG4_MPEG_QUANT) << 24 |
+		 !!(f->flags & V4L2_MPEG4_QUARTER_SAMPLE) << 23 |
+		 !!(f->flags & V4L2_MPEG4_RESYNC_DISABLED) << 22;
+	if (f->picture_type == 2)
+		header |= f->backward_type << 28;
+	if (f->flags & V4L2_MPEG4_SHORT_HEADER) {
+		header &= ~GENMASK(19, 18);
+		header |= BIT(31) | BIT(16) | BIT(22) |
+			  (f->picture_type ? 2U << 18 : 0);
+	}
+	cedrus_write(dev, MP4_REG(4), header);
+	cedrus_write(dev, MP4_REG(0x10), ctx->codec.mpeg4.mb % width << 8 |
+		     ctx->codec.mpeg4.mb / width);
+	if (first)
+		cedrus_write(dev, MP4_REG(0x84), p->quantizer);
+	cedrus_write(dev, MP4_REG(0x1c), MP4_IRQ_MASK);
+	cedrus_write(dev, MP4_REG(0x2c), ctx->codec.mpeg4.offset);
+	length = ALIGN(f->bitstream_size * 8 - ctx->codec.mpeg4.offset, 32);
+	cedrus_write(dev, MP4_REG(0x30), length);
+	cedrus_write(dev, MP4_REG(0x18), BIT(26) | (first ? BIT(31) : 0) |
+		     ctx->codec.mpeg4.count << 8 | 0xd);
+}
+
+static enum cedrus_irq_status cedrus_mpeg4_irq_status(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	const struct v4l2_ctrl_mpeg4_frame *f = ctx->codec.mpeg4.frame;
+	u32 reg = cedrus_read(dev, MP4_REG(0x1c));
+	unsigned int end;
+	int ret;
+
+	if (!(reg & MP4_IRQ_MASK))
+		return CEDRUS_IRQ_NONE;
+	if ((reg & 6) || !f || !ctx->codec.mpeg4.dst)
+		return CEDRUS_IRQ_ERROR;
+	if (!(reg & BIT(0))) {
+		cedrus_write(dev, MP4_REG(0x1c), reg & MP4_IRQ_MASK);
+		return CEDRUS_IRQ_CONTINUE;
+	}
+	ret = readl_poll_timeout_atomic(dev->base + MP4_REG(0x1c), reg,
+		!(reg & (VE_DEC_MPEG_STATUS_MC_BUSY | VE_DEC_MPEG_STATUS_ROTATE_BUSY)),
+		1, 1000);
+	if (ret || (reg & 6))
+		return CEDRUS_IRQ_ERROR;
+	ctx->codec.mpeg4.mb += ctx->codec.mpeg4.count;
+	end = ctx->codec.mpeg4.packet + 1 < f->num_packets ?
+		f->packets[ctx->codec.mpeg4.packet + 1].first_mb :
+		DIV_ROUND_UP(f->width, 16) * DIV_ROUND_UP(f->height, 16);
+	if (ctx->codec.mpeg4.mb < end) {
+		ctx->codec.mpeg4.offset = cedrus_read(dev, MP4_REG(0x2c));
+		if (ctx->codec.mpeg4.offset >= f->bitstream_size * 8)
+			return CEDRUS_IRQ_ERROR;
+		cedrus_mpeg4_packet(ctx, false);
+		return CEDRUS_IRQ_CONTINUE;
+	}
+	if (++ctx->codec.mpeg4.packet < f->num_packets) {
+		ctx->codec.mpeg4.offset = f->packets[ctx->codec.mpeg4.packet].bit_offset;
+		cedrus_mpeg4_packet(ctx, true);
+		return CEDRUS_IRQ_CONTINUE;
+	}
+	ctx->codec.mpeg4.dst->codec.mpeg4.valid = true;
+	return CEDRUS_IRQ_OK;
+}
+
+static void cedrus_mpeg4_irq_clear(struct cedrus_ctx *ctx)
+{
+	cedrus_write(ctx->dev, MP4_REG(0x1c), MP4_IRQ_MASK);
+	ctx->codec.mpeg4.dst = NULL;
+}
+
+static void cedrus_mpeg4_irq_disable(struct cedrus_ctx *ctx)
+{
+	u32 reg = cedrus_read(ctx->dev, MP4_REG(0x14));
+
+	cedrus_write(ctx->dev, MP4_REG(0x14), reg & ~GENMASK(6, 3));
+}
+
+static void cedrus_mpeg4_invalidate(struct cedrus_ctx *ctx)
+{
+	struct vb2_queue *q = v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx);
+	unsigned int i;
+
+	for (i = 0; i < vb2_get_num_buffers(q); i++) {
+		struct vb2_buffer *vb = vb2_get_buffer(q, i);
+
+		if (vb)
+			vb2_to_cedrus_buffer(vb)->codec.mpeg4.valid = false;
+	}
+}
+
+static int cedrus_mpeg4_start(struct cedrus_ctx *ctx)
+{
+	unsigned int width = ALIGN(DIV_ROUND_UP(ctx->src_fmt.width, 16), 2);
+	unsigned int height = ALIGN(DIV_ROUND_UP(ctx->src_fmt.height, 16), 2);
+	size_t mb_size = height * (ctx->src_fmt.width > 2048 ? 4096 : 2048);
+	size_t dc_size = width * 64;
+	size_t nc_size = height * (ctx->src_fmt.width > 2048 ? 32 : 16);
+
+	ctx->codec.mpeg4.size = ALIGN(mb_size, 1024) + ALIGN(dc_size, 1024) +
+			       ALIGN(nc_size, 1024);
+	ctx->codec.mpeg4.aux = dma_alloc_coherent(ctx->dev->dev,
+		ctx->codec.mpeg4.size, &ctx->codec.mpeg4.aux_dma, GFP_KERNEL);
+	if (!ctx->codec.mpeg4.aux)
+		return -ENOMEM;
+	ctx->codec.mpeg4.frame = kmalloc(sizeof(*ctx->codec.mpeg4.frame), GFP_KERNEL);
+	if (!ctx->codec.mpeg4.frame) {
+		dma_free_coherent(ctx->dev->dev, ctx->codec.mpeg4.size,
+			ctx->codec.mpeg4.aux, ctx->codec.mpeg4.aux_dma);
+		ctx->codec.mpeg4.aux = NULL;
+		return -ENOMEM;
+	}
+	ctx->codec.mpeg4.dc_dma = ctx->codec.mpeg4.aux_dma + ALIGN(mb_size, 1024);
+	ctx->codec.mpeg4.nc_dma = ctx->codec.mpeg4.dc_dma + ALIGN(dc_size, 1024);
+	cedrus_mpeg4_invalidate(ctx);
+	return 0;
+}
+
+static void cedrus_mpeg4_stop(struct cedrus_ctx *ctx)
+{
+	cedrus_mpeg4_invalidate(ctx);
+	if (ctx->codec.mpeg4.aux)
+		dma_free_coherent(ctx->dev->dev, ctx->codec.mpeg4.size,
+			ctx->codec.mpeg4.aux, ctx->codec.mpeg4.aux_dma);
+	ctx->codec.mpeg4.aux = NULL;
+	kfree(ctx->codec.mpeg4.frame);
+	ctx->codec.mpeg4.frame = NULL;
+	ctx->codec.mpeg4.dst = NULL;
+}
+
+static int cedrus_mpeg4_setup(struct cedrus_ctx *ctx, struct cedrus_run *run)
+{
+	const struct v4l2_ctrl_mpeg4_frame *f = run->mpeg4.frame;
+	struct cedrus_dev *dev = ctx->dev;
+	struct vb2_buffer *src = &run->src->vb2_buf, *dst = &run->dst->vb2_buf;
+	struct vb2_queue *q = v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx);
+	struct vb2_buffer *refs[2] = { NULL, NULL };
+	dma_addr_t base = vb2_dma_contig_plane_dma_addr(src, 0);
+	size_t capacity = vb2_plane_size(src, 0);
+	unsigned int i, width = DIV_ROUND_UP(ctx->src_fmt.width, 16);
+	unsigned int height = DIV_ROUND_UP(ctx->src_fmt.height, 16);
+	int ret = cedrus_mpeg4_validate(f);
+	u32 control;
+
+	vb2_to_cedrus_buffer(dst)->codec.mpeg4.valid = false;
+	if (ret)
+		return ret;
+	if (f->width != ctx->src_fmt.width || f->height != ctx->src_fmt.height ||
+	    !!(f->flags & V4L2_MPEG4_SHORT_HEADER) !=
+	    (ctx->src_fmt.pixelformat == V4L2_PIX_FMT_H263_FRAME) ||
+	    f->bitstream_size > vb2_get_plane_payload(src, 0) ||
+	    ALIGN(f->bitstream_size, 4) > capacity || !capacity ||
+	    base + capacity - 1 > U32_MAX || !ctx->codec.mpeg4.aux ||
+	    !ctx->codec.mpeg4.frame ||
+	    ctx->codec.mpeg4.aux_dma + ctx->codec.mpeg4.size - 1 > U32_MAX)
+		return -EINVAL;
+	for (i = 0; i < (f->picture_type == 2 ? 2 : !!f->picture_type); i++) {
+		refs[i] = vb2_find_buffer(q, f->reference_ts[i]);
+		if (!refs[i] || refs[i] == dst ||
+		    !vb2_to_cedrus_buffer(refs[i])->codec.mpeg4.valid)
+			return -EINVAL;
+	}
+	ret = reset_control_reset(dev->rstc);
+	if (ret)
+		return ret;
+	ret = cedrus_engine_enable(ctx);
+	if (ret)
+		return ret;
+	for (i = 0; i < 2; i++) {
+		cedrus_write(dev, MP4_REG(0x50 + i * 8),
+			     refs[i] ? cedrus_dst_buf_addr(ctx, refs[i], 0) : 0);
+		cedrus_write(dev, MP4_REG(0x54 + i * 8),
+			     refs[i] ? cedrus_dst_buf_addr(ctx, refs[i], 1) : 0);
+	}
+	cedrus_dst_format_set(dev, &ctx->dst_fmt);
+	cedrus_write(dev, VE_PRIMARY_OUT_FMT,
+		     VE_PRIMARY_OUT_FMT_NV12 | VE_SECONDARY_OUT_FMT_EXT_NV12);
+	cedrus_write(dev, VE_CHROMA_BUF_LEN,
+		     VE_CHROMA_BUF_LEN_SDRT(ctx->dst_fmt.bytesperline *
+			ctx->dst_fmt.height / 4) | VE_CHROMA_WIDTH_ALIGN_8 |
+		     VE_SECONDARY_OUT_FMT_EXT);
+	cedrus_write(dev, MP4_REG(0), 0);
+	cedrus_write(dev, MP4_REG(8), (ALIGN(width, 2) & 0xff) << 16 |
+		     (width & 0xff) << 8 | (height & 0xff));
+	cedrus_write(dev, MP4_REG(0xc), (ALIGN(f->width, 16) & 0xfff) << 16 |
+		     (ALIGN(f->height, 16) & 0xfff));
+	cedrus_write(dev, MP4_REG(0x24), f->trd | f->trb << 16);
+	cedrus_write(dev, MP4_REG(0x38), ctx->codec.mpeg4.aux_dma);
+	cedrus_write(dev, MP4_REG(0x3c), ctx->codec.mpeg4.dc_dma);
+	cedrus_write(dev, MP4_REG(0x44), ctx->codec.mpeg4.nc_dma);
+	cedrus_write(dev, MP4_REG(0x48), cedrus_dst_buf_addr(ctx, dst, 0));
+	cedrus_write(dev, MP4_REG(0x4c), cedrus_dst_buf_addr(ctx, dst, 1));
+	cedrus_write(dev, MP4_REG(0xcc), cedrus_dst_buf_addr(ctx, dst, 0));
+	cedrus_write(dev, MP4_REG(0xd0), cedrus_dst_buf_addr(ctx, dst, 1));
+	cedrus_write(dev, MP4_REG(0xd4), 0x40620000);
+	cedrus_write(dev, MP4_REG(0x28), VE_DEC_MPEG_VLD_ADDR_BASE(base) | GENMASK(30, 28));
+	cedrus_write(dev, MP4_REG(0x34), base + capacity - 1);
+	cedrus_write(dev, MP4_REG(0xc4), 0);
+	cedrus_write(dev, MP4_REG(0xc8), 0);
+	if (f->flags & V4L2_MPEG4_MPEG_QUANT)
+		for (i = 0; i < 64; i++) {
+			cedrus_write(dev, MP4_REG(0x80), BIT(14) | i << 8 | f->intra_quant[i]);
+			cedrus_write(dev, MP4_REG(0x80), i << 8 | f->inter_quant[i]);
+		}
+	control = BIT(31) | BIT(19) | BIT(14) | BIT(8) | BIT(7) |
+		  VE_DEC_MPEG_CTRL_IRQ_MASK;
+	if (f->picture_type == 1)
+		control |= BIT(12);
+	if (f->flags & V4L2_MPEG4_QUARTER_SAMPLE) {
+		if (f->picture_type == 1)
+			control |= 0x1a00000;
+		else if (f->picture_type == 2)
+			control |= 0x2500000;
+	}
+	cedrus_write(dev, MP4_REG(0x14), control);
+	*ctx->codec.mpeg4.frame = *f;
+	ctx->codec.mpeg4.dst = vb2_to_cedrus_buffer(dst);
+	ctx->codec.mpeg4.mb = ctx->codec.mpeg4.packet = 0;
+	ctx->codec.mpeg4.offset = f->packets[0].bit_offset;
+	return 0;
+}
+
+static void cedrus_mpeg4_trigger(struct cedrus_ctx *ctx)
+{
+	cedrus_mpeg4_packet(ctx, true);
+}
+
+struct cedrus_dec_ops cedrus_dec_ops_mpeg4 = {
+	.irq_status = cedrus_mpeg4_irq_status,
+	.irq_clear = cedrus_mpeg4_irq_clear,
+	.irq_disable = cedrus_mpeg4_irq_disable,
+	.start = cedrus_mpeg4_start, .stop = cedrus_mpeg4_stop,
+	.setup = cedrus_mpeg4_setup, .trigger = cedrus_mpeg4_trigger,
+};
