diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_cavs.c b/drivers/staging/media/sunxi/cedrus/cedrus_cavs.c
new file mode 100644
--- /dev/null
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_cavs.c
@@ -0,0 +1,285 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/dma-mapping.h>
+#include <linux/reset.h>
+#include <linux/string.h>
+#include <media/cavs-ctrls.h>
+#include <media/videobuf2-dma-contig.h>
+#include <media/v4l2-mem2mem.h>
+#include "cedrus.h"
+#include "cedrus_hw.h"
+#include "cedrus_regs.h"
+
+#define CAVS_REG(n) (VE_ENGINE_DEC_H264 + (n))
+#define CAVS_MB_INFO_SIZE 0xc000
+#define CAVS_IRQ_MASK 7
+
+int cedrus_cavs_validate(const struct v4l2_ctrl_cavs_frame *f)
+{
+	unsigned int i;
+
+	if (!f || !f->width || f->width > 1920 || !f->height || f->height > 1088 ||
+	    (f->profile != 0x20 && f->profile != 0x48) ||
+	    f->picture_type < 1 || f->picture_type > 3 || f->picture_qp > 63 ||
+	    f->num_refs > 2 || (f->picture_type > 1 && !f->num_refs) ||
+	    (f->picture_type == 3 && f->num_refs != 2) ||
+	    ((f->flags & V4L2_CAVS_PROGRESSIVE) &&
+	     !(f->flags & V4L2_CAVS_FRAME_PICTURE)) ||
+	    (f->flags & ~(0x1fffU | V4L2_CAVS_TV_COMPAT)) ||
+	    f->quant_index > 2 || f->quant_model > 3 ||
+	    f->chroma_qp_delta_cb < -16 || f->chroma_qp_delta_cb > 16 ||
+	    f->chroma_qp_delta_cr < -16 || f->chroma_qp_delta_cr > 16 ||
+	    f->alpha_offset < -8 || f->alpha_offset > 8 ||
+	    f->beta_offset < -8 || f->beta_offset > 8 ||
+	    (f->profile == 0x20 && (f->flags & 0x1f00)))
+		return -EINVAL;
+	if (f->flags & V4L2_CAVS_TV_COMPAT) {
+		if (f->chroma_format > 1 || f->sample_precision > 1)
+			return -EINVAL;
+	} else if (f->chroma_format || f->sample_precision) {
+		return -EINVAL;
+	}
+	for (i = 0; i < 2; i++)
+		if (f->reference_flags[i] & ~7U)
+			return -EINVAL;
+	for (i = 0; i < sizeof(f->reserved); i++)
+		if (f->reserved[i])
+			return -EINVAL;
+	return 0;
+}
+
+static u32 cedrus_cavs_sequence_reg(const struct v4l2_ctrl_cavs_frame *f)
+{
+	u32 chroma = 1, precision = 1;
+
+	if (f->flags & V4L2_CAVS_TV_COMPAT) {
+		chroma = f->chroma_format;
+		precision = f->sample_precision;
+	}
+	return f->profile | f->level << 8 | chroma << 16 | precision << 18 |
+	       !!(f->flags & V4L2_CAVS_PB_FIELD_ENHANCED) << 22 |
+	       !!(f->flags & V4L2_CAVS_PB_ENHANCED) << 23 |
+	       !!(f->flags & V4L2_CAVS_AEC) << 24 |
+	       !!(f->flags & V4L2_CAVS_WEIGHTED_QUANT) << 25 |
+	       !!(f->flags & V4L2_CAVS_CHROMA_QUANT_DISABLED) << 26;
+}
+
+static u32 cedrus_cavs_quant1_reg(const struct v4l2_ctrl_cavs_frame *f)
+{
+	u32 reg = f->quant_model << 16 | f->quant_index << 18 |
+		  ((u32)f->chroma_qp_delta_cr & 63) << 20 |
+		  ((u32)f->chroma_qp_delta_cb & 63) << 26;
+
+	if (f->quant_index)
+		reg |= (u8)f->quant_param[0] << 8 | (u8)f->quant_param[1];
+	return reg;
+}
+
+static u32 cedrus_cavs_quant2_reg(const struct v4l2_ctrl_cavs_frame *f)
+{
+	if (!f->quant_index)
+		return 0;
+	return (u32)(u8)f->quant_param[2] << 24 |
+	       (u32)(u8)f->quant_param[3] << 16 |
+	       (u8)f->quant_param[4] << 8 | (u8)f->quant_param[5];
+}
+
+static u32 cedrus_cavs_picture_reg(const struct v4l2_ctrl_cavs_frame *f)
+{
+	u32 reg = ((u32)f->alpha_offset & 31) | ((u32)f->beta_offset & 31) << 8 |
+		  f->picture_qp << 16 | (u32)(f->picture_type - 1) << 30 |
+		  !!(f->flags & V4L2_CAVS_LOOP_FILTER_DISABLED) << 22 |
+		  !!(f->flags & V4L2_CAVS_FIXED_QP) << 23 |
+		  !!(f->flags & V4L2_CAVS_SKIP_MODE) << 24 |
+		  !!(f->flags & V4L2_CAVS_ADVANCED_PRED_DISABLED) << 25 |
+		  !!(f->flags & V4L2_CAVS_PICTURE_REFERENCE) << 26 |
+		  !!(f->flags & V4L2_CAVS_TOP_FIELD_FIRST) << 27 |
+		  !!(f->flags & V4L2_CAVS_PROGRESSIVE) << 28 |
+		  !!(f->flags & V4L2_CAVS_FRAME_PICTURE) << 29;
+	unsigned int i;
+
+	if (f->picture_type != 1)
+		for (i = 0; i < 2; i++)
+			reg |= !!(f->reference_flags[i] & V4L2_CAVS_REF_FRAME) << (5 + 8 * i) |
+			       !!(f->reference_flags[i] & V4L2_CAVS_REF_TOP_FIRST) << (6 + 8 * i) |
+			       !!(f->reference_flags[i] & V4L2_CAVS_REF_INTRA) << (7 + 8 * i);
+	return reg;
+}
+
+static u32 cedrus_cavs_distance_reg(const struct v4l2_ctrl_cavs_frame *f)
+{
+	if (f->picture_type == 3)
+		return f->picture_distance | f->reference_distance[1] << 8 |
+		       f->reference_distance[0] << 16 | f->reference_distance[2] << 24;
+	return f->picture_distance | f->reference_distance[0] << 8 |
+	       f->reference_distance[1] << 24;
+}
+
+static enum cedrus_irq_status cedrus_cavs_irq_status(struct cedrus_ctx *ctx)
+{
+	u32 status = cedrus_read(ctx->dev, CAVS_REG(0x28)) & CAVS_IRQ_MASK;
+
+	if (!status)
+		return CEDRUS_IRQ_NONE;
+	if ((status & 6) || cedrus_read(ctx->dev, CAVS_REG(0x2c)) <
+	    DIV_ROUND_UP(ctx->src_fmt.width, 16) *
+	    DIV_ROUND_UP(ctx->src_fmt.height, 16))
+		return CEDRUS_IRQ_ERROR;
+	return CEDRUS_IRQ_OK;
+}
+
+static void cedrus_cavs_irq_clear(struct cedrus_ctx *ctx)
+{
+	u32 status = cedrus_read(ctx->dev, CAVS_REG(0x28));
+
+	if (ctx->codec.cavs.dst)
+		ctx->codec.cavs.dst->codec.cavs.valid =
+			cedrus_cavs_irq_status(ctx) == CEDRUS_IRQ_OK;
+	ctx->codec.cavs.dst = NULL;
+	cedrus_write(ctx->dev, CAVS_REG(0x28), status & CAVS_IRQ_MASK);
+}
+
+static void cedrus_cavs_irq_disable(struct cedrus_ctx *ctx)
+{
+	cedrus_write(ctx->dev, CAVS_REG(0x20),
+		     cedrus_read(ctx->dev, CAVS_REG(0x20)) & ~CAVS_IRQ_MASK);
+}
+
+static int cedrus_cavs_setup(struct cedrus_ctx *ctx, struct cedrus_run *run)
+{
+	const struct v4l2_ctrl_cavs_frame *f = run->cavs.frame;
+	struct cedrus_buffer *dst = vb2_to_cedrus_buffer(&run->dst->vb2_buf);
+	struct vb2_buffer *src = &run->src->vb2_buf;
+	struct vb2_buffer *refs[2] = { &run->dst->vb2_buf, &run->dst->vb2_buf };
+	struct vb2_queue *q = v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx);
+	struct cedrus_dev *dev = ctx->dev;
+	dma_addr_t source = vb2_dma_contig_plane_dma_addr(src, 0);
+	struct v4l2_pix_format recon = cedrus_dst_frame_fmt(ctx);
+	size_t payload = vb2_get_plane_payload(src, 0);
+	unsigned int i;
+	int ret;
+
+	dst->codec.cavs.valid = false;
+	ret = cedrus_cavs_validate(f);
+	if (ret)
+		return ret;
+	if (f->width != ctx->src_fmt.width || f->height != ctx->src_fmt.height ||
+	    !f->bitstream_size || f->bitstream_offset > payload ||
+	    f->bitstream_size > payload - f->bitstream_offset ||
+	    f->bitstream_offset > 0xffffff || f->bitstream_size > 0xffffff ||
+	    (source & 15) || !vb2_plane_size(src, 0))
+		return -EINVAL;
+	for (i = 0; i < f->num_refs; i++) {
+		refs[i] = vb2_find_buffer(q, f->reference_ts[i]);
+		if (!refs[i] || refs[i] == &run->dst->vb2_buf ||
+		    !vb2_to_cedrus_buffer(refs[i])->codec.cavs.valid)
+			return -EINVAL;
+	}
+	if (f->num_refs == 1)
+		refs[1] = refs[0];
+	ret = reset_control_reset(dev->rstc);
+	if (ret)
+		return ret;
+	ret = cedrus_engine_enable(ctx);
+	if (ret)
+		return ret;
+	cedrus_dst_format_set(dev, &recon);
+	cedrus_write(dev, CAVS_REG(4), cedrus_cavs_sequence_reg(f));
+	cedrus_write(dev, CAVS_REG(0xc), cedrus_cavs_quant1_reg(f));
+	cedrus_write(dev, CAVS_REG(0x10), cedrus_cavs_quant2_reg(f));
+	cedrus_write(dev, CAVS_REG(0x14), cedrus_cavs_picture_reg(f));
+	cedrus_write(dev, CAVS_REG(0x18), cedrus_cavs_distance_reg(f));
+	cedrus_write(dev, CAVS_REG(0x20), 0x14000407);
+	cedrus_write(dev, CAVS_REG(0x2c), 0);
+	cedrus_write(dev, CAVS_REG(0x30),
+		     (source & 0xffffff0) | (source >> 28) | 0x70000000);
+	cedrus_write(dev, CAVS_REG(0x34), f->bitstream_offset * 8);
+	cedrus_write(dev, CAVS_REG(0x38), f->bitstream_size * 8);
+	cedrus_write(dev, CAVS_REG(0x3c), source + vb2_plane_size(src, 0) - 1);
+	cedrus_write(dev, CAVS_REG(0x40), 0);
+	cedrus_write(dev, CAVS_REG(0x50), ctx->codec.cavs.mv_dma);
+	cedrus_write(dev, CAVS_REG(0x54), ctx->codec.cavs.mb_dma);
+	cedrus_write(dev, CAVS_REG(0x58),
+		     DIV_ROUND_UP(f->width, 16) << 8 | DIV_ROUND_UP(f->height, 16));
+	cedrus_write(dev, CAVS_REG(0x5c), ALIGN(f->width, 16) << 16 | ALIGN(f->height, 16));
+	cedrus_write(dev, CAVS_REG(0x60), 0);
+	cedrus_write(dev, CAVS_REG(0xac), cedrus_dst_frame_addr(ctx, &run->dst->vb2_buf, 0));
+	cedrus_write(dev, CAVS_REG(0xd0), cedrus_dst_frame_addr(ctx, &run->dst->vb2_buf, 1));
+	/* P pictures use the newest reference in the forward slot. */
+	i = f->picture_type == 3 ? 1 : 0;
+	cedrus_write(dev, CAVS_REG(0xb0), cedrus_dst_frame_addr(ctx, refs[i], 0));
+	cedrus_write(dev, CAVS_REG(0xd4), cedrus_dst_frame_addr(ctx, refs[i], 1));
+	i ^= 1;
+	cedrus_write(dev, CAVS_REG(0xb4), cedrus_dst_frame_addr(ctx, refs[i], 0));
+	cedrus_write(dev, CAVS_REG(0xd8), cedrus_dst_frame_addr(ctx, refs[i], 1));
+	cedrus_write(dev, CAVS_REG(0xb8), 0);
+	ctx->codec.cavs.dst = dst;
+	return 0;
+}
+
+static void cedrus_cavs_trigger(struct cedrus_ctx *ctx)
+{
+	cedrus_write(ctx->dev, CAVS_REG(0x28), CAVS_IRQ_MASK);
+	cedrus_write(ctx->dev, CAVS_REG(0x24), 0x17);
+	cedrus_write(ctx->dev, CAVS_REG(0x24), 0x19);
+}
+
+static void cedrus_cavs_invalidate_buffers(struct cedrus_ctx *ctx)
+{
+	struct vb2_queue *q = v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx);
+	unsigned int i;
+
+	for (i = 0; i < vb2_get_num_buffers(q); i++) {
+		struct vb2_buffer *vb = vb2_get_buffer(q, i);
+
+		if (vb)
+			vb2_to_cedrus_buffer(vb)->codec.cavs.valid = false;
+	}
+}
+
+static int cedrus_cavs_start(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+
+	cedrus_cavs_invalidate_buffers(ctx);
+	ctx->codec.cavs.mv_size = (ALIGN(ctx->src_fmt.width, 64) / 16) *
+				(ALIGN(ctx->src_fmt.height, 64) / 16) * 32;
+	ctx->codec.cavs.mb = dma_alloc_coherent(dev->dev, CAVS_MB_INFO_SIZE,
+					      &ctx->codec.cavs.mb_dma, GFP_KERNEL);
+	if (!ctx->codec.cavs.mb)
+		return -ENOMEM;
+	ctx->codec.cavs.mv = dma_alloc_coherent(dev->dev, ctx->codec.cavs.mv_size,
+					      &ctx->codec.cavs.mv_dma, GFP_KERNEL);
+	if (!ctx->codec.cavs.mv) {
+		dma_free_coherent(dev->dev, CAVS_MB_INFO_SIZE, ctx->codec.cavs.mb,
+				  ctx->codec.cavs.mb_dma);
+		ctx->codec.cavs.mb = NULL;
+		return -ENOMEM;
+	}
+	ctx->codec.cavs.dst = NULL;
+	return 0;
+}
+
+static void cedrus_cavs_stop(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+
+	cedrus_cavs_invalidate_buffers(ctx);
+
+	dma_free_coherent(dev->dev, CAVS_MB_INFO_SIZE, ctx->codec.cavs.mb,
+			  ctx->codec.cavs.mb_dma);
+	dma_free_coherent(dev->dev, ctx->codec.cavs.mv_size, ctx->codec.cavs.mv,
+			  ctx->codec.cavs.mv_dma);
+	ctx->codec.cavs.mb = NULL;
+	ctx->codec.cavs.mv = NULL;
+	ctx->codec.cavs.dst = NULL;
+}
+
+struct cedrus_dec_ops cedrus_dec_ops_cavs = {
+	.irq_clear = cedrus_cavs_irq_clear,
+	.irq_disable = cedrus_cavs_irq_disable,
+	.irq_status = cedrus_cavs_irq_status,
+	.setup = cedrus_cavs_setup,
+	.start = cedrus_cavs_start,
+	.stop = cedrus_cavs_stop,
+	.trigger = cedrus_cavs_trigger,
+};
