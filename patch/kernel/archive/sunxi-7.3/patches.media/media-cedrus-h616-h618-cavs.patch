@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _CAVS_CTRLS_H_
+#define _CAVS_CTRLS_H_
+#include <linux/types.h>
+#include <linux/v4l2-controls.h>
+#include <linux/videodev2.h>
+
+/* Experimental ABI. Keep the kernel and userspace definitions identical. */
+#define V4L2_PIX_FMT_CAVS_FRAME v4l2_fourcc('C', 'A', 'V', 'S')
+#define V4L2_CID_STATELESS_CAVS_FRAME (V4L2_CID_CODEC_STATELESS_BASE + 601)
+#define V4L2_CAVS_PROGRESSIVE (1U << 0)
+#define V4L2_CAVS_FRAME_PICTURE (1U << 1)
+#define V4L2_CAVS_TOP_FIELD_FIRST (1U << 2)
+#define V4L2_CAVS_FIXED_QP (1U << 3)
+#define V4L2_CAVS_SKIP_MODE (1U << 4)
+#define V4L2_CAVS_LOOP_FILTER_DISABLED (1U << 5)
+#define V4L2_CAVS_PICTURE_REFERENCE (1U << 6)
+#define V4L2_CAVS_ADVANCED_PRED_DISABLED (1U << 7)
+#define V4L2_CAVS_PB_FIELD_ENHANCED (1U << 8)
+#define V4L2_CAVS_PB_ENHANCED (1U << 9)
+#define V4L2_CAVS_WEIGHTED_QUANT (1U << 10)
+#define V4L2_CAVS_CHROMA_QUANT_DISABLED (1U << 11)
+#define V4L2_CAVS_AEC (1U << 12)
+#define V4L2_CAVS_TV_COMPAT (1U << 13)
+#define V4L2_CAVS_REF_FRAME (1U << 0)
+#define V4L2_CAVS_REF_TOP_FIRST (1U << 1)
+#define V4L2_CAVS_REF_INTRA (1U << 2)
+
+struct v4l2_ctrl_cavs_frame {
+	__u64 reference_ts[2]; /* Newest reference first. */
+	__u32 bitstream_offset;
+	__u32 bitstream_size;
+	__u32 flags;
+	__u16 width;
+	__u16 height;
+	__u8 profile;
+	__u8 level;
+	__u8 picture_type; /* I=1, P=2, B=3. */
+	__u8 picture_distance;
+	__u8 picture_qp;
+	__u8 num_refs;
+	__u8 quant_index;
+	__u8 quant_model;
+	__s8 chroma_qp_delta_cb;
+	__s8 chroma_qp_delta_cr;
+	__s8 alpha_offset;
+	__s8 beta_offset;
+	__s8 quant_param[6];
+	__u8 reference_distance[3];
+	__u8 reference_flags[2];
+	/* Raw sequence fields. Valid only with V4L2_CAVS_TV_COMPAT. */
+	__u8 chroma_format;
+	__u8 sample_precision;
+	__u8 reserved[7];
+};
+#endif
