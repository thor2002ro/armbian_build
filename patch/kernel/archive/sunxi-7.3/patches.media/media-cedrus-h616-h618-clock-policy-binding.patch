From: thor2002ro <thor2002ro@gmail.com>
Subject: [PATCH] Local: media: cedrus: define H616 VE codec clock map

Define named codec-mask clock policy rows for H616 and H618.

Signed-off-by: thor2002ro <thor2002ro@gmail.com>
---
diff --git a/MAINTAINERS b/MAINTAINERS
index 83b33f9..1832aed 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -931,7 +931,9 @@
 M:	Paul Kocialkowski <paulk@sys-base.io>
 L:	linux-media@vger.kernel.org
 S:	Maintained
+F:	Documentation/devicetree/bindings/media/allwinner,sun4i-a10-video-engine.yaml
 F:	drivers/staging/media/sunxi/cedrus/
+F:	include/dt-bindings/media/allwinner-cedrus.h
 
 ALPHA PORT
 M:	Richard Henderson <richard.henderson@linaro.org>
diff --git a/Documentation/devicetree/bindings/media/allwinner,sun4i-a10-video-engine.yaml b/Documentation/devicetree/bindings/media/allwinner,sun4i-a10-video-engine.yaml
index 7b236bf..cf1167a 100644
--- a/Documentation/devicetree/bindings/media/allwinner,sun4i-a10-video-engine.yaml
+++ b/Documentation/devicetree/bindings/media/allwinner,sun4i-a10-video-engine.yaml
@@ -66,6 +66,16 @@
       H616 and H618 default to mode 2 when this property is absent.
       This property does not configure SRAM routing or the external DRAM controller.
 
+  allwinner,ve-clock-rate-map:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 3
+    maxItems: 90
+    description: |
+      H616 and H618 video-engine clock policy rows.
+      Each row contains SID, codec mask, and rate in Hz.
+      Codec masks use constants from dt-bindings/media/allwinner-cedrus.h.
+      Every row has three cells. Every rate must exist in operating-points-v2.
+
   iommus:
     minItems: 1
     maxItems: 2
@@ -82,6 +92,8 @@
       CMA pool to use for buffers allocation instead of the default
       CMA pool.
 
+  operating-points-v2: true
+
   # FIXME: This should be made required eventually once every SoC will
   # have the MBUS declared.
   interconnects:
@@ -103,11 +115,15 @@
           minItems: 2
           maxItems: 2
       dependentRequired:
+        allwinner,ve-clock-rate-map:
+          [ operating-points-v2, nvmem-cells, nvmem-cell-names ]
         nvmem-cells: [ nvmem-cell-names ]
         nvmem-cell-names: [ nvmem-cells ]
     else:
       properties:
         allwinner,ve-ddr-mode: false
+        allwinner,ve-clock-rate-map: false
+        operating-points-v2: false
         iommus:
           maxItems: 1
         nvmem-cells: false
diff --git a/include/dt-bindings/media/allwinner-cedrus.h b/include/dt-bindings/media/allwinner-cedrus.h
new file mode 100644
index 0000000..660fcae
--- /dev/null
+++ b/include/dt-bindings/media/allwinner-cedrus.h
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
+#ifndef _DT_BINDINGS_MEDIA_ALLWINNER_CEDRUS_H
+#define _DT_BINDINGS_MEDIA_ALLWINNER_CEDRUS_H
+
+/* Decoder codec identifiers from the vendor VE interface. */
+#define CEDRUS_CODEC_DEC_MJPEG		(1 << 0)
+#define CEDRUS_CODEC_DEC_MPEG1		(1 << 1)
+#define CEDRUS_CODEC_DEC_MPEG2		(1 << 2)
+#define CEDRUS_CODEC_DEC_MPEG4		(1 << 3)
+#define CEDRUS_CODEC_DEC_MSMPEG4_V1	(1 << 4)
+#define CEDRUS_CODEC_DEC_MSMPEG4_V2	(1 << 5)
+#define CEDRUS_CODEC_DEC_DIVX3		(1 << 6)
+#define CEDRUS_CODEC_DEC_DIVX4		(1 << 7)
+#define CEDRUS_CODEC_DEC_DIVX5		(1 << 8)
+#define CEDRUS_CODEC_DEC_XVID		(1 << 9)
+#define CEDRUS_CODEC_DEC_H263		(1 << 10)
+#define CEDRUS_CODEC_DEC_SORENSON_H263	(1 << 11)
+#define CEDRUS_CODEC_DEC_RXG2		(1 << 12)
+#define CEDRUS_CODEC_DEC_WMV1		(1 << 13)
+#define CEDRUS_CODEC_DEC_WMV2		(1 << 14)
+#define CEDRUS_CODEC_DEC_WMV3		(1 << 15)
+#define CEDRUS_CODEC_DEC_VP6		(1 << 16)
+#define CEDRUS_CODEC_DEC_VP8		(1 << 17)
+#define CEDRUS_CODEC_DEC_VP9		(1 << 18)
+#define CEDRUS_CODEC_DEC_RX		(1 << 19)
+#define CEDRUS_CODEC_DEC_H264		(1 << 20)
+#define CEDRUS_CODEC_DEC_H265		(1 << 21)
+#define CEDRUS_CODEC_DEC_AVS		(1 << 22)
+#define CEDRUS_CODEC_DEC_AVS2		(1 << 23)
+#define CEDRUS_CODEC_DEC_AV1		(1 << 24)
+
+/* Encoder identifiers use a separate vendor interface. */
+#define CEDRUS_CODEC_ENC_H264		(1 << 25)
+#define CEDRUS_CODEC_ENC_JPEG		(1 << 26)
+#define CEDRUS_CODEC_ENC_H264_V2	(1 << 27)
+#define CEDRUS_CODEC_ENC_H265		(1 << 28)
+#define CEDRUS_CODEC_ENC_VP8		(1 << 29)
+
+#define CEDRUS_CODEC_DEC_ALL		((1 << 25) - 1)
+#define CEDRUS_CODEC_ENC_ALL		(CEDRUS_CODEC_ALL & ~CEDRUS_CODEC_DEC_ALL)
+#define CEDRUS_CODEC_ALL		((1 << 30) - 1)
+
+#endif
