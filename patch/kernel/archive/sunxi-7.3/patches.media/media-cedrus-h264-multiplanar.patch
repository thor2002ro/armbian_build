+	stored->height = pix->height;
+	stored->pixelformat = pix->pixelformat;
+	stored->field = pix->field;
+	stored->bytesperline = pix->plane_fmt[0].bytesperline;
+	for (i = 0; i < pix->num_planes; i++)
+		stored->sizeimage += pix->plane_fmt[i].sizeimage;
+	stored->colorspace = pix->colorspace;
+	stored->xfer_func = pix->xfer_func;
+	stored->ycbcr_enc = pix->ycbcr_enc;
+	stored->quantization = pix->quantization;
