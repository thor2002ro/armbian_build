+static int cedrus_enc_check_plane(struct vb2_buffer *vb, unsigned int plane,
+				  u32 size, u32 payload)
+{
+	u32 offset = vb->planes[plane].data_offset;
+	u32 used = vb2_get_plane_payload(vb, plane);
+
+	if (offset > vb2_plane_size(vb, plane) ||
+	    size > vb2_plane_size(vb, plane) - offset)
+		return -EINVAL;
+	if (used < offset || payload > used - offset)
+		return -EINVAL;
 	return 0;
 }
 
