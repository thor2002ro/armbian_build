+static int cedrus_enc_plane_addr(struct vb2_buffer *vb, unsigned int plane,
+				 dma_addr_t *addr)
+{
+	dma_addr_t base = vb2_dma_contig_plane_dma_addr(vb, plane);
+	u32 offset = vb->planes[plane].data_offset;
+
+	if (base > (dma_addr_t)-1 - offset)
+		return -ERANGE;
+	*addr = base + offset;
+	return 0;
+}
+
+static int cedrus_enc_buffer_addrs(struct cedrus_ctx *ctx,
+				   struct vb2_buffer *src,
+				   struct vb2_buffer *dst,
+				   dma_addr_t *luma,
+				   dma_addr_t *chroma,
+				   dma_addr_t *stream)
+{
+	int ret;
+
+	ret = cedrus_enc_plane_addr(src, 0, luma);
+	if (ret)
+		return ret;
+	if (ctx->src_fmt.pixelformat == V4L2_PIX_FMT_NV12M) {
+		ret = cedrus_enc_plane_addr(src, 1, chroma);
+		if (ret)
+			return ret;
+	} else {
+		u32 luma_size = ctx->src_fmt.width * ctx->src_fmt.height;
+
+		if (*luma > (dma_addr_t)-1 - luma_size)
+			return -ERANGE;
+		*chroma = *luma + luma_size;
+	}
+	return cedrus_enc_plane_addr(dst, 0, stream);
+}
