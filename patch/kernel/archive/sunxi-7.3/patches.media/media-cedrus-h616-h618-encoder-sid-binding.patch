From: thor2002ro <thor2002ro@gmail.com>
Subject: [PATCH] Local: dt-bindings: media: allow H616/H618 encoder SID

The encoder limit depends on the SoC silicon identity value. Cedrus cannot read that value without the SID reference.

Document the optional SID cell. Boards without it keep the conservative limit.

Signed-off-by: thor2002ro <thor2002ro@gmail.com>
---
diff --git a/Documentation/devicetree/bindings/media/allwinner,sun4i-a10-video-engine.yaml b/Documentation/devicetree/bindings/media/allwinner,sun4i-a10-video-engine.yaml
--- a/Documentation/devicetree/bindings/media/allwinner,sun4i-a10-video-engine.yaml
+++ b/Documentation/devicetree/bindings/media/allwinner,sun4i-a10-video-engine.yaml
@@ -23,6 +23,7 @@
       - allwinner,sun20i-d1-video-engine
       - allwinner,sun50i-a64-video-engine
       - allwinner,sun50i-h5-video-engine
+      - allwinner,sun50i-h616-video-engine
       - allwinner,sun50i-h6-video-engine
       - allwinner,sun55i-a523-video-engine
 
@@ -58,6 +59,12 @@
   iommus:
     maxItems: 1
 
+  nvmem-cells:
+    maxItems: 1
+
+  nvmem-cell-names:
+    const: soc-id
+
   memory-region:
     maxItems: 1
     description:
@@ -73,6 +80,20 @@
   # have the MBUS declared.
   interconnect-names:
     const: dma-mem
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          const: allwinner,sun50i-h616-video-engine
+    then:
+      dependentRequired:
+        nvmem-cells: [ nvmem-cell-names ]
+        nvmem-cell-names: [ nvmem-cells ]
+    else:
+      properties:
+        nvmem-cells: false
+        nvmem-cell-names: false
 
 required:
   - compatible
-- 
Armbian
