Subject: [PATCH] Local: media: cedrus: trace encoder DMA state

Capture input and scratch addresses before launch and failure resets.
Keep snapshots at debug level.
---
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_enc.h b/drivers/staging/media/sunxi/cedrus/cedrus_enc.h
--- a/drivers/staging/media/sunxi/cedrus/cedrus_enc.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_enc.h
@@ -75,6 +75,7 @@
 int cedrus_enc_register(struct cedrus_dev *dev);
 void cedrus_enc_unregister(struct cedrus_dev *dev);
 void cedrus_enc_run(struct cedrus_ctx *ctx);
+void cedrus_enc_dump_regs(struct cedrus_ctx *ctx, const char *phase);
 irqreturn_t cedrus_enc_irq(struct cedrus_ctx *ctx);
 void cedrus_enc_timeout(struct cedrus_ctx *ctx);
 int cedrus_enc_h264_pad(struct vb2_buffer *buffer, u32 bytes, u32 total);
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_enc.c b/drivers/staging/media/sunxi/cedrus/cedrus_enc.c
--- a/drivers/staging/media/sunxi/cedrus/cedrus_enc.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_enc.c
@@ -751,6 +751,59 @@
 	}
 }
 
+void cedrus_enc_dump_regs(struct cedrus_ctx *ctx, const char *phase)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	struct cedrus_enc_ctx *enc = ctx->enc;
+	struct vb2_v4l2_buffer *src = v4l2_m2m_next_src_buf(ctx->fh.m2m_ctx);
+	struct vb2_v4l2_buffer *dst = v4l2_m2m_next_dst_buf(ctx->fh.m2m_ctx);
+	dma_addr_t source = src ? vb2_dma_contig_plane_dma_addr(&src->vb2_buf, 0) : 0;
+	dma_addr_t stream = dst ? vb2_dma_contig_plane_dma_addr(&dst->vb2_buf, 0) : 0;
+
+	dev_dbg(dev->dev,
+		"ENC %s: frame=%u idr=%u index=%u qp=%u retry=%u rc=%u cbr=%u\n",
+		phase, enc->frames, enc->idr, enc->index, enc->qp, enc->retries,
+		enc->rc_enabled, enc->cbr);
+	dev_dbg(dev->dev,
+		"ENC %s: size=%ux%u stride=%u input=%u src=%pad stream=%pad limit=%u\n",
+		phase, ctx->src_fmt.width, ctx->src_fmt.height, ctx->src_fmt.bytesperline,
+		ctx->src_fmt.sizeimage, &source, &stream, enc->stream_size);
+	dev_dbg(dev->dev,
+		"ENC %s: mode=%08x top=%08x dec_ip=%08x enc_ip=%08x irq=%08x trigger=%08x bits=%u\n",
+		phase, cedrus_read(dev, 0), cedrus_read(dev, 4), cedrus_read(dev, 0xe0),
+		cedrus_read(dev, 0xe4), cedrus_read(dev, 0xb1c),
+		cedrus_read(dev, 0xb18), cedrus_read(dev, 0xb90));
+	dev_dbg(dev->dev,
+		"ENC %s: state avc=%08x aux=%08x isp=%08x offset=%08x ctrl=%08x\n",
+		phase, cedrus_read(dev, 0xb00), cedrus_read(dev, 0xb94),
+		cedrus_read(dev, 0xa10), cedrus_read(dev, 0xa0c), cedrus_read(dev, 0xb14));
+	dev_dbg(dev->dev,
+		"ENC %s: ISP size=%08x stride=%08x ctrl=%08x y=%08x uv=%08x v=%08x out=%08x/%08x\n",
+		phase, cedrus_read(dev, 0xa00), cedrus_read(dev, 0xa04),
+		cedrus_read(dev, 0xa08), cedrus_read(dev, 0xa78), cedrus_read(dev, 0xa7c),
+		cedrus_read(dev, 0xa80), cedrus_read(dev, 0xa70), cedrus_read(dev, 0xa74));
+	dev_dbg(dev->dev,
+		"ENC %s: param=%08x quant=%08x motion=%08x classify=%08x class_buf=%08x smart=%08x temporal=%08x\n",
+		phase, cedrus_read(dev, 0xb04), cedrus_read(dev, 0xb08),
+		cedrus_read(dev, 0xb10), cedrus_read(dev, 0xb2c), cedrus_read(dev, 0xb9c),
+		cedrus_read(dev, 0xb40), cedrus_read(dev, 0xb44));
+	dev_dbg(dev->dev,
+		"ENC %s: stream=%08x..%08x offset=%08x length=%08x mv_out=%08x qp_map=%08x motion_map=%08x\n",
+		phase, cedrus_read(dev, 0xb80), cedrus_read(dev, 0xb84),
+		cedrus_read(dev, 0xb88), cedrus_read(dev, 0xb8c), cedrus_read(dev, 0xb60),
+		cedrus_read(dev, 0xbfc), cedrus_read(dev, 0xbf8));
+	dev_dbg(dev->dev,
+		"ENC %s: pre=%08x/%08x alt_ref=%08x/%08x extra=%08x\n",
+		phase, cedrus_read(dev, 0xb78), cedrus_read(dev, 0xb7c),
+		cedrus_read(dev, 0xba8), cedrus_read(dev, 0xbac), cedrus_read(dev, 0xbc8));
+	dev_dbg(dev->dev,
+		"ENC %s: ref=%08x/%08x recon=%08x/%08x sub=%08x/%08x mb=%08x deblock=%08x extra=%08x\n",
+		phase, cedrus_read(dev, 0xba0), cedrus_read(dev, 0xba4),
+		cedrus_read(dev, 0xbb0), cedrus_read(dev, 0xbb4),
+		cedrus_read(dev, 0xbb8), cedrus_read(dev, 0xbbc),
+		cedrus_read(dev, 0xbc0), cedrus_read(dev, 0xbc4), cedrus_read(dev, 0xbc8));
+}
+
 void cedrus_enc_run(struct cedrus_ctx *ctx)
 {
 	struct cedrus_enc_ctx *enc = ctx->enc;
@@ -798,8 +851,10 @@
 					    vb2_dma_contig_plane_dma_addr(&src->vb2_buf, 0),
 					    vb2_dma_contig_plane_dma_addr(&dst->vb2_buf, 0),
 					    ctx->dst_fmt.sizeimage);
-	if (ret)
+	if (ret) {
+		dev_dbg(ctx->dev->dev, "ENC setup fails: %d\n", ret);
 		cedrus_enc_complete(ctx, VB2_BUF_STATE_ERROR);
+	}
 }
 
 static int cedrus_enc_wait_idle(struct cedrus_dev *dev)
@@ -867,8 +922,10 @@
 	if (state == VB2_BUF_STATE_DONE && !cedrus_enc_is_jpeg(ctx) && enc->rc_enabled) {
 		mad = cedrus_read(ctx->dev, 0xb50);
 	}
-	if (state == VB2_BUF_STATE_ERROR)
+	if (state == VB2_BUF_STATE_ERROR) {
+		cedrus_enc_dump_regs(ctx, "error");
 		reset_control_reset(ctx->dev->rstc);
+	}
 	cedrus_write(ctx->dev, 0xb1c, 0xf);
 	cedrus_engine_disable(ctx->dev);
 	if (state == VB2_BUF_STATE_DONE) {
@@ -913,6 +970,8 @@
 
 	if (!(status & mask))
 		return IRQ_NONE;
+	if (!ctx->enc->frames || (status & 0xe))
+		cedrus_enc_dump_regs(ctx, "irq");
 	if ((cedrus_enc_is_jpeg(ctx) && !(status & 0x6)) ||
 	    (!cedrus_enc_is_jpeg(ctx) && ctx->enc->rc_enabled && !(status & 0xe))) {
 		cedrus_write(ctx->dev, 0xb14, 0);
@@ -926,6 +985,7 @@
 
 void cedrus_enc_timeout(struct cedrus_ctx *ctx)
 {
+	dev_dbg(ctx->dev->dev, "ENC watchdog timeout\n");
 	cedrus_enc_complete(ctx, VB2_BUF_STATE_ERROR);
 }
 
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_enc_h264.c b/drivers/staging/media/sunxi/cedrus/cedrus_enc_h264.c
--- a/drivers/staging/media/sunxi/cedrus/cedrus_enc_h264.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_enc_h264.c
@@ -463,6 +463,8 @@
 			return ret;
 	}
 	cedrus_write(dev, CEDRUS_ENC_REG(0x14), 0xf);
+	if (!enc->frames)
+		cedrus_enc_dump_regs(ctx, "start");
 	cedrus_watchdog_start(dev);
 	cedrus_write(dev, CEDRUS_ENC_REG(0x18), 8);
 	return 0;
