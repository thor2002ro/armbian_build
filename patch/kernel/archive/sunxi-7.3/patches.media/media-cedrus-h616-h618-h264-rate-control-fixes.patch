+static inline void cedrus_h264_model_fit(struct cedrus_h264_model *model,
+					 const bool *reject, u32 count)
+{
+	/* Vendor covariance cutoff: 1e-6. */
+	const struct cedrus_mad_fp epsilon = { .fraction = 0x10c6f7a0b5ed8dLL, .exponent = -72 };
+	struct cedrus_mad_fp sx = {0}, sy = {0}, sxx = {0}, sxy = {0};
+	struct cedrus_mad_fp step, rate, inverse, n, product, determinant, magnitude;
+	u32 i, used = 0;
+
+	for (i = 0; i < count; i++) {
+		if (reject[i])
+			continue;
+		step = cedrus_mad_from(model->sample[i].step, -4);
+		rate = cedrus_h264_sample_rate(&model->sample[i]);
+		inverse = cedrus_mad_div(cedrus_mad_from(1, 0), step);
+		sxy = cedrus_mad_fma(step, rate, sxy);
+		sy = cedrus_mad_add(sy, rate);
+		sx = cedrus_mad_add(sx, inverse);
+		inverse = cedrus_mad_div(cedrus_mad_from(1, 0), cedrus_mad_mul(step, step));
+		sxx = cedrus_mad_add(sxx, inverse);
+		used++;
+	}
+	if (!used) {
+		model->x1 = (struct cedrus_mad_fp){0};
+		model->x2 = (struct cedrus_mad_fp){0};
+		return;
+	}
+	n = cedrus_mad_from(used, 0);
+	determinant = cedrus_mad_fma(n, sxx, cedrus_mad_neg(cedrus_mad_mul(sx, sx)));
+	magnitude = determinant;
+	magnitude.fraction = cedrus_mad_abs(magnitude);
+	if (!cedrus_mad_greater(magnitude, epsilon))
+		return;
+	product = cedrus_mad_fma(sxx, sxy, cedrus_mad_neg(cedrus_mad_mul(sx, sy)));
+	model->x1 = cedrus_mad_div(product, determinant);
+	product = cedrus_mad_fma(n, sy, cedrus_mad_neg(cedrus_mad_mul(sx, sxy)));
+	model->x2 = cedrus_mad_div(product, determinant);
+}
