+static inline struct cedrus_mad_fp cedrus_h264_sample_rate(const struct cedrus_h264_sample *s)
+{
+	return cedrus_mad_div(cedrus_mad_from(s->bits, 0), cedrus_h264_sample_activity(s));
+}
