+#ifdef __SIZEOF_INT128__
+static inline void cedrus_h264_model_update_stats(struct cedrus_h264_model *model,
+						  u32 qp, u32 bits, u32 sad, u32 pixels)
+{
+	bool reject[CEDRUS_RC_HISTORY] = { false };
+	struct cedrus_mad_fp errors[CEDRUS_RC_HISTORY], total = {0}, threshold = {0};
+	struct cedrus_mad_fp step_value, rate, prediction;
+	struct cedrus_mad_fp activity, previous, low, high;
+	u32 i, window = 1, mad_window = 1, mad, step = cedrus_h264_qstep(qp);
+
+	if (!sad || !pixels || !bits)
+		return;
+	activity = cedrus_mad_div(cedrus_mad_from(sad, 0), cedrus_mad_from(pixels, 0));
+	if (model->count) {
+		previous = cedrus_h264_sample_activity(&model->sample[0]);
+		low = cedrus_mad_greater(activity, previous) ? previous : activity;
+		high = cedrus_mad_greater(activity, previous) ? activity : previous;
+		/* RD and MAD windows use different vendor operation orders. */
+		rate = cedrus_mad_div(low, high);
+		rate = cedrus_mad_mul(rate, cedrus_mad_from(CEDRUS_RC_HISTORY, 0));
+		window = cedrus_mad_u32(rate, 0);
+		rate = cedrus_mad_mul(low, cedrus_mad_from(CEDRUS_RC_HISTORY, 0));
+		rate = cedrus_mad_div(rate, high);
+		mad_window = cedrus_mad_u32(rate, 0);
+	}
+	mad = min_t(u64, div_u64((u64)sad * 256, pixels), 65535);
+	model->oldest_sad = model->sample[CEDRUS_RC_HISTORY - 1].sad;
+	model->oldest_pixels = model->sample[CEDRUS_RC_HISTORY - 1].pixels;
+	model->oldest_mad = model->sample[CEDRUS_RC_HISTORY - 1].mad;
+	memmove(model->sample + 1, model->sample,
+		sizeof(model->sample[0]) * (CEDRUS_RC_HISTORY - 1));
+	model->count = min_t(u32, model->count + 1, CEDRUS_RC_HISTORY);
+	model->window = clamp_t(u32, window, 1, min_t(u32, model->window + 1, model->count));
+	model->mad_count = min_t(u32, model->mad_count + 1, CEDRUS_RC_HISTORY + 1);
+	model->mad_window = min_t(u32, model->mad_count - 1,
+				  min_t(u32, max_t(u32, mad_window, 1), model->mad_window + 1));
+	model->last_mad = mad;
+	model->sample[0] = (struct cedrus_h264_sample) {
+		.step = step,
+		.rate = mad ? clamp_t(u64, div_u64((u64)bits << 16, mad),
+				      1, CEDRUS_RC_MAX_RATE) : 0,
+		.mad = mad,
+		.bits = bits,
+		.sad = sad,
+		.pixels = pixels,
+	};
+	cedrus_h264_model_fit(model, reject, model->window);
+	for (i = 0; i < model->window; i++) {
+		step_value = cedrus_mad_from(model->sample[i].step, -4);
+		rate = cedrus_h264_sample_rate(&model->sample[i]);
+		prediction = cedrus_mad_div(model->x2, cedrus_mad_mul(step_value, step_value));
+		prediction = cedrus_mad_add(prediction, cedrus_mad_div(model->x1, step_value));
+		errors[i] = cedrus_mad_add(prediction, cedrus_mad_neg(rate));
+		total = cedrus_mad_fma(errors[i], errors[i], total);
+	}
+	if (model->window != 2)
+		threshold = cedrus_mad_div(total, cedrus_mad_from(model->window, 0));
+	for (i = 1; i < model->window; i++)
+		reject[i] = cedrus_mad_greater(cedrus_mad_mul(errors[i], errors[i]), threshold);
+	cedrus_h264_model_fit(model, reject, model->window);
+}
