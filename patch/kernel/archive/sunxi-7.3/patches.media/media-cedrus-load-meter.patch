diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_load.h b/drivers/staging/media/sunxi/cedrus/cedrus_load.h
new file mode 100644
--- /dev/null
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_load.h
@@ -0,0 +1,71 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _CEDRUS_LOAD_H_
+#define _CEDRUS_LOAD_H_
+
+#include <linux/types.h>
+#include <linux/math64.h>
+
+struct cedrus_load {
+	u64 since_ns, start_ns;
+	u64 encoder_ns, decoder_ns, failed_ns;
+	u64 executions, completions, errors, timeouts, retries;
+	bool active, encoder;
+};
+
+struct cedrus_load_sample {
+	u64 time_ns, busy_ns;
+	u32 percent;
+};
+
+static inline void cedrus_load_sample_update(struct cedrus_load_sample *sample,
+					     u64 now, u64 busy)
+{
+	u64 elapsed = now - sample->time_ns;
+	u64 percent = elapsed ?
+		mul_u64_u64_div_u64(busy - sample->busy_ns, 10000, elapsed) : 0;
+
+	sample->percent = percent > 10000 ? 10000 : percent;
+	sample->time_ns = now;
+	sample->busy_ns = busy;
+}
+
+/* Call under the device load lock. Times use the monotonic clock. */
+static inline void cedrus_load_begin(struct cedrus_load *load, u64 now,
+				     bool encoder, bool retry)
+{
+	if (load->active)
+		return;
+	load->start_ns = now;
+	load->active = true;
+	load->encoder = encoder;
+	load->executions++;
+	load->retries += retry;
+}
+
+static inline void cedrus_load_account(struct cedrus_load *load, u64 now)
+{
+	u64 duration = now - load->start_ns;
+
+	if (load->encoder)
+		load->encoder_ns += duration;
+	else
+		load->decoder_ns += duration;
+}
+
+static inline void cedrus_load_finish(struct cedrus_load *load, u64 now,
+				      bool error, bool timeout)
+{
+	if (!load->active)
+		return;
+	cedrus_load_account(load, now);
+	if (error || timeout) {
+		load->failed_ns += now - load->start_ns;
+		load->errors += error;
+		load->timeouts += timeout;
+	} else {
+		load->completions++;
+	}
+	load->active = false;
+}
+
+#endif
