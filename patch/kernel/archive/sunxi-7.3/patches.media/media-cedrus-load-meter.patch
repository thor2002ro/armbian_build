@@ -22,6 +22,8 @@
 #include <linux/jiffies.h>
 #include <linux/clk.h>
 #include <linux/moduleparam.h>
+#include <linux/ktime.h>
+#include <linux/math64.h>
 #include <linux/nvmem-consumer.h>
 #include <linux/pm_opp.h>
 #include <linux/pm_runtime.h>
@@ -46,6 +48,101 @@
 module_param(ve_rate_override, ulong, 0644);
 MODULE_PARM_DESC(ve_rate_override,
 		 "Override VE clock rate in Hz; zero selects DT policy");
+
+static LIST_HEAD(cedrus_stats_devices);
+static DEFINE_MUTEX(cedrus_stats_lock);
+static unsigned int ve_load_stat;
+static unsigned int decoder_streams_stat = 1;
+static unsigned int encoder_streams_stat = 2;
+
+static int cedrus_stats_get(char *buffer, const struct kernel_param *param)
+{
+	unsigned int kind = *(unsigned int *)param->arg;
+	struct cedrus_dev *dev;
+	unsigned long flags;
+	u64 value = 0;
+	u32 devices = 0;
+
+	mutex_lock(&cedrus_stats_lock);
+	list_for_each_entry(dev, &cedrus_stats_devices, stats_node) {
+		if (kind == 0) {
+			spin_lock_irqsave(&dev->load_lock, flags);
+			if (dev->load.active)
+				value += dev->load_sample.percent;
+			spin_unlock_irqrestore(&dev->load_lock, flags);
+			devices++;
+		} else if (kind == 1) {
+			value += atomic_read(&dev->decoder_streams);
+		} else {
+			value += atomic_read(&dev->encoder_streams);
+		}
+	}
+	mutex_unlock(&cedrus_stats_lock);
+	if (kind == 0)
+		value = devices ? div_u64(value + devices * 50ULL, devices * 100ULL) : 0;
+	return scnprintf(buffer, PAGE_SIZE, "%llu\n", value);
+}
+
+static const struct kernel_param_ops cedrus_stats_ops = {
+	.get = cedrus_stats_get,
+};
+module_param_cb(ve_load, &cedrus_stats_ops, &ve_load_stat, 0444);
+MODULE_PARM_DESC(ve_load, "Combined VE occupancy percentage");
+module_param_cb(decoder_streams, &cedrus_stats_ops, &decoder_streams_stat, 0444);
+MODULE_PARM_DESC(decoder_streams, "Started decoder output streams");
+module_param_cb(encoder_streams, &cedrus_stats_ops, &encoder_streams_stat, 0444);
+MODULE_PARM_DESC(encoder_streams, "Started encoder output streams");
+
+void cedrus_load_start(struct cedrus_ctx *ctx, bool retry)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	unsigned long flags;
+	u64 now, busy;
+
+	spin_lock_irqsave(&dev->load_lock, flags);
+	now = ktime_get_ns();
+	if (!dev->load.active && dev->load_monitor_enabled) {
+		busy = dev->load.encoder_ns + dev->load.decoder_ns;
+		if (now - dev->load_sample.time_ns >= NSEC_PER_SEC)
+			cedrus_load_sample_update(&dev->load_sample, now, busy);
+		schedule_delayed_work(&dev->load_work, msecs_to_jiffies(1000));
+	}
+	cedrus_load_begin(&dev->load, now, ctx->encoder, retry);
+	spin_unlock_irqrestore(&dev->load_lock, flags);
+}
+
+void cedrus_load_end(struct cedrus_dev *dev, bool error, bool timeout)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&dev->load_lock, flags);
+	cedrus_load_finish(&dev->load, ktime_get_ns(), error, timeout);
+	cancel_delayed_work(&dev->load_work);
+	spin_unlock_irqrestore(&dev->load_lock, flags);
+}
+
+static void cedrus_load_sample_work(struct work_struct *work)
+{
+	struct cedrus_dev *dev = container_of(to_delayed_work(work),
+						     struct cedrus_dev, load_work);
+	struct cedrus_load load;
+	unsigned long flags;
+	u64 now;
+
+	spin_lock_irqsave(&dev->load_lock, flags);
+	if (!dev->load_monitor_enabled || !dev->load.active) {
+		spin_unlock_irqrestore(&dev->load_lock, flags);
+		return;
+	}
+	now = ktime_get_ns();
+	load = dev->load;
+	if (load.active)
+		cedrus_load_account(&load, now);
+	cedrus_load_sample_update(&dev->load_sample, now,
+				  load.encoder_ns + load.decoder_ns);
+	schedule_delayed_work(&dev->load_work, msecs_to_jiffies(1000));
+	spin_unlock_irqrestore(&dev->load_lock, flags);
+}
 
