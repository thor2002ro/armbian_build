 }
 
+static void cedrus_enc_finish_work(struct work_struct *work)
+{
+	struct cedrus_enc_ctx *enc = container_of(work, struct cedrus_enc_ctx, finish_work);
+
+	cedrus_enc_complete(enc->ctx, VB2_BUF_STATE_DONE);
+}
+
 irqreturn_t cedrus_enc_irq(struct cedrus_ctx *ctx)
 {
 	u32 status = cedrus_read(ctx->dev, 0xb1c);
-
-	if (!(status & 0xf))
+	u32 mask = cedrus_enc_is_jpeg(ctx) ? 0x7 : 0xf;
+
+	if (!(status & mask))
 		return IRQ_NONE;
-	cedrus_enc_complete(ctx, (status & 0xe) ? VB2_BUF_STATE_ERROR : VB2_BUF_STATE_DONE);
+	if (cedrus_enc_is_jpeg(ctx) && !(status & 0x6)) {
+		cedrus_write(ctx->dev, 0xb14, 0);
+		cedrus_write(ctx->dev, 0xb1c, status & 0xf);
+		schedule_work(&ctx->enc->finish_work);
+	} else {
+		cedrus_enc_complete(ctx, (status & 0xe) ? VB2_BUF_STATE_ERROR : VB2_BUF_STATE_DONE);
+	}
 	return IRQ_HANDLED;
 }
 
