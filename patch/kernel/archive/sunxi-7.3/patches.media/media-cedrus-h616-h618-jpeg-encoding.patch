 		 cedrus_vp8.o cedrus_vp9.o cedrus_vc1.o cedrus_jpeg.o
 
-sunxi-cedrus-y += cedrus_enc.o cedrus_enc_h264.o
+sunxi-cedrus-y += cedrus_enc.o cedrus_enc_h264.o cedrus_enc_jpeg.o
