+{
+	return format == V4L2_PIX_FMT_JPEG || format == V4L2_PIX_FMT_MJPEG;
+}
+
 static int cedrus_enc_try_format(struct cedrus_ctx *ctx, struct v4l2_format *f)
 {
 	struct v4l2_pix_format *pix = &f->fmt.pix;
