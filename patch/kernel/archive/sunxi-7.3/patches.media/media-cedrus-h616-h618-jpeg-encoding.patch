diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_enc_jpeg.c b/drivers/staging/media/sunxi/cedrus/cedrus_enc_jpeg.c
new file mode 100644
--- /dev/null
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_enc_jpeg.c
@@ -0,0 +1,152 @@
+// SPDX-License-Identifier: GPL-2.0
+/* H616 baseline JPEG encoder. */
+#include <linux/dma-buf.h>
+#include <linux/iopoll.h>
+#include <linux/iosys-map.h>
+#include <linux/module.h>
+#include <linux/reset.h>
+
+#include "cedrus_enc.h"
+#include "cedrus_hw.h"
+#include "cedrus_regs.h"
+
+#define CEDRUS_JPEG_ENC_REG(offset) (0xb00 + (offset))
+
+int cedrus_enc_jpeg_start(struct cedrus_ctx *ctx)
+{
+	if (cedrus_read(ctx->dev, 0xf0) || cedrus_read(ctx->dev, 0xe4) != 0x12011)
+		return -EOPNOTSUPP;
+	ctx->enc->frames = 0;
+	return 0;
+}
+
+static int cedrus_enc_jpeg_put(void *opaque, u8 value)
+{
+	struct cedrus_ctx *ctx = opaque;
+	struct cedrus_dev *dev = ctx->dev;
+	u32 status;
+	int ret;
+
+	ret = readl_poll_timeout_atomic(dev->base + CEDRUS_JPEG_ENC_REG(0x1c),
+					status, status & BIT(9), 1, 1000);
+	if (ret)
+		return ret;
+	if (cedrus_read(dev, CEDRUS_JPEG_ENC_REG(0x90)) >
+	    (ctx->enc->stream_size - 2) * 8 - 8)
+		return -ENOSPC;
+	cedrus_write(dev, CEDRUS_JPEG_ENC_REG(0x20), value);
+	cedrus_write(dev, CEDRUS_JPEG_ENC_REG(0x18), 0x10801);
+	return 0;
+}
+
+int cedrus_enc_jpeg_setup(struct cedrus_ctx *ctx, dma_addr_t source,
+			  dma_addr_t stream, u32 size)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	struct cedrus_enc_ctx *enc = ctx->enc;
+	struct cedrus_jpeg_enc_writer writer = {
+		.put = cedrus_enc_jpeg_put,
+		.opaque = ctx,
+	};
+	u32 width = ctx->src_fmt.width, height = ctx->src_fmt.height;
+	u32 start, status, dc_luma, dc_chroma;
+	unsigned int i;
+	int ret;
+
+	if (width < 96 || width > 8192 || height < 48 || height > 8192 ||
+	    (width & 15) || (height & 7) ||
+	    ctx->src_fmt.pixelformat != V4L2_PIX_FMT_NV12 ||
+	    ctx->src_fmt.bytesperline != width ||
+	    ctx->src_fmt.sizeimage != width * height * 3 / 2 ||
+	    (source & 15) || size < 1024 || size > CEDRUS_H264_STREAM_MAX ||
+	    (size & 255))
+		return -EINVAL;
+	if (source > U32_MAX || ctx->src_fmt.sizeimage - 1 > U32_MAX - source)
+		return -ERANGE;
+	ret = cedrus_h264_dma(stream, size, &start);
+	if (ret)
+		return ret;
+	ret = cedrus_jpeg_enc_quantize(&enc->jpeg_tables, enc->jpeg_quality);
+	if (ret)
+		return ret;
+	if (cedrus_read(dev, 0xf0) || cedrus_read(dev, 0xe4) != 0x12011)
+		return -EOPNOTSUPP;
+	ret = reset_control_reset(dev->rstc);
+	if (ret)
+		return ret;
+
+	cedrus_write(dev, VE_MODE, VE_MODE_DISABLED | VE_MODE_DDR_MODE_BW_256 |
+		     BIT(6) | BIT(7));
+	cedrus_write(dev, CEDRUS_JPEG_ENC_REG(0x18), 0x10000);
+	cedrus_write(dev, 0xa00, (width / 8) << 16 | height / 8);
+	cedrus_write(dev, 0xa04, (width / 16) << 16);
+	cedrus_write(dev, 0xa14, width / 16);
+	cedrus_write(dev, 0xa2c, (height / 8) << 16 | width / 8);
+	cedrus_write(dev, 0xa08, 0); /* NV12 without video range conversion. */
+	cedrus_write(dev, 0xa78, source);
+	cedrus_write(dev, 0xa7c, source + width * height);
+	cedrus_write(dev, 0xa80, source + width * height +
+		     width * ALIGN(height, 16) / 4);
+	cedrus_write(dev, 0xa88, 0);
+	cedrus_write(dev, CEDRUS_JPEG_ENC_REG(0x14), 0xf);
+	cedrus_write(dev, CEDRUS_JPEG_ENC_REG(0x1c), 0xf);
+	cedrus_write(dev, CEDRUS_JPEG_ENC_REG(0x88), 0);
+	cedrus_write(dev, CEDRUS_JPEG_ENC_REG(0x80), start);
+	cedrus_write(dev, CEDRUS_JPEG_ENC_REG(0x84), (stream + size - 1) >> 8);
+	/* Reserve two bytes for the software EOI marker. */
+	cedrus_write(dev, CEDRUS_JPEG_ENC_REG(0x8c), (size - 2) * 8);
+	cedrus_write(dev, CEDRUS_JPEG_ENC_REG(0x90), 0);
+	cedrus_write(dev, CEDRUS_JPEG_ENC_REG(0x04), BIT(31));
+	enc->stream_size = size;
+	ret = cedrus_jpeg_enc_header(&writer, &enc->jpeg_tables, width, height);
+	if (ret)
+		return ret;
+	ret = readl_poll_timeout_atomic(dev->base + CEDRUS_JPEG_ENC_REG(0x1c),
+					status, status & BIT(9), 1, 1000);
+	if (ret)
+		return ret;
+	dc_luma = enc->jpeg_tables.quant[0][0];
+	dc_chroma = enc->jpeg_tables.quant[1][0];
+	cedrus_write(dev, CEDRUS_JPEG_ENC_REG(0x04), BIT(31) | BIT(30) |
+		     (1024 + dc_luma / 2) / dc_luma |
+		     ((1024 + dc_chroma / 2) / dc_chroma) << 16);
+	cedrus_write(dev, CEDRUS_JPEG_ENC_REG(0x08), BIT(31) | BIT(30));
+	cedrus_write(dev, CEDRUS_JPEG_ENC_REG(0xe0), 0);
+	for (i = 0; i < ARRAY_SIZE(enc->jpeg_tables.reciprocal); i++)
+		cedrus_write(dev, CEDRUS_JPEG_ENC_REG(0xe4), enc->jpeg_tables.reciprocal[i]);
+	cedrus_watchdog_start(dev);
+	cedrus_write(dev, CEDRUS_JPEG_ENC_REG(0x18), 0x10008);
+	return 0;
+}
+
+int cedrus_enc_jpeg_finish(struct vb2_buffer *buffer, u32 bytes)
+{
+	static const u8 eoi[] = { 0xff, 0xd9 };
+	struct dma_buf *dmabuf = buffer->planes[0].dbuf;
+	struct iosys_map map;
+	void *address;
+	int ret, end_ret;
+
+	if (vb2_plane_size(buffer, 0) < 2 || bytes <= CEDRUS_JPEG_ENC_HEADER_SIZE ||
+	    bytes > vb2_plane_size(buffer, 0) - 2)
+		return -ENOSPC;
+	if (!dmabuf) {
+		address = vb2_plane_vaddr(buffer, 0);
+		if (!address)
+			return -EFAULT;
+		memcpy(address + bytes, eoi, sizeof(eoi));
+		return 0;
+	}
+	ret = dma_buf_begin_cpu_access(dmabuf, DMA_BIDIRECTIONAL);
+	if (ret)
+		return ret;
+	ret = dma_buf_vmap_unlocked(dmabuf, &map);
+	if (!ret) {
+		iosys_map_memcpy_to(&map, bytes, eoi, sizeof(eoi));
+		dma_buf_vunmap_unlocked(dmabuf, &map);
+	}
+	end_ret = dma_buf_end_cpu_access(dmabuf, DMA_BIDIRECTIONAL);
+	return ret ?: end_ret;
+}
+
+MODULE_IMPORT_NS("DMA_BUF");
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_enc_jpeg.h b/drivers/staging/media/sunxi/cedrus/cedrus_enc_jpeg.h
new file mode 100644
--- /dev/null
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_enc_jpeg.h
@@ -0,0 +1,129 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _CEDRUS_ENC_JPEG_H_
+#define _CEDRUS_ENC_JPEG_H_
+
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <media/v4l2-jpeg.h>
+
+#define CEDRUS_JPEG_ENC_HEADER_SIZE 623U
+
+struct cedrus_jpeg_enc_tables {
+	u8 quant[2][64];
+	u32 reciprocal[128];
+};
+
+struct cedrus_jpeg_enc_writer {
+	int (*put)(void *opaque, u8 value);
+	void *opaque;
+	int error;
+};
+
+static inline int
+cedrus_jpeg_enc_quantize(struct cedrus_jpeg_enc_tables *tables, unsigned int quality)
+{
+	const u8 *standard[] = {
+		v4l2_jpeg_ref_table_luma_qt,
+		v4l2_jpeg_ref_table_chroma_qt,
+	};
+	unsigned int scale, component, i;
+
+	if (!quality || quality > 100)
+		return -EINVAL;
+	scale = quality < 50 ? 5000 / quality : 200 - quality * 2;
+	for (component = 0; component < 2; component++) {
+		for (i = 0; i < 64; i++) {
+			u32 weight = clamp_t(u32, (standard[component][i] * scale + 50) / 100,
+					     1, 255);
+			u32 inverse = min_t(u32, 65536 / weight + 1, 65535);
+
+			tables->quant[component][i] = weight;
+			tables->reciprocal[component * 64 + i] = inverse | (weight / 2) << 16;
+		}
+	}
+	return 0;
+}
+
+static inline void cedrus_jpeg_enc_byte(struct cedrus_jpeg_enc_writer *writer, u8 value)
+{
+	if (!writer->error)
+		writer->error = writer->put(writer->opaque, value);
+}
+
+static inline void cedrus_jpeg_enc_word(struct cedrus_jpeg_enc_writer *writer, u16 value)
+{
+	cedrus_jpeg_enc_byte(writer, value >> 8);
+	cedrus_jpeg_enc_byte(writer, value);
+}
+
+static inline void cedrus_jpeg_enc_marker(struct cedrus_jpeg_enc_writer *writer, u8 marker)
+{
+	cedrus_jpeg_enc_byte(writer, 0xff);
+	cedrus_jpeg_enc_byte(writer, marker);
+}
+
+static inline void cedrus_jpeg_enc_huffman(struct cedrus_jpeg_enc_writer *writer,
+					   u8 selector, const u8 *table, unsigned int size)
+{
+	unsigned int i;
+
+	cedrus_jpeg_enc_marker(writer, 0xc4);
+	cedrus_jpeg_enc_word(writer, size + 3);
+	cedrus_jpeg_enc_byte(writer, selector);
+	for (i = 0; i < size; i++)
+		cedrus_jpeg_enc_byte(writer, table[i]);
+}
+
+static inline int cedrus_jpeg_enc_header(struct cedrus_jpeg_enc_writer *writer,
+					 struct cedrus_jpeg_enc_tables *tables,
+					 unsigned int width, unsigned int height)
+{
+	static const u8 jfif[] = { 'J', 'F', 'I', 'F', 0, 1, 1, 0, 0, 1, 0, 1, 0, 0 };
+	unsigned int i, component;
+
+	if (!width || width > 8192 || !height || height > 8192)
+		return -EINVAL;
+	cedrus_jpeg_enc_marker(writer, 0xd8);
+	cedrus_jpeg_enc_marker(writer, 0xe0);
+	cedrus_jpeg_enc_word(writer, 16);
+	for (i = 0; i < ARRAY_SIZE(jfif); i++)
+		cedrus_jpeg_enc_byte(writer, jfif[i]);
+	for (component = 0; component < 2; component++) {
+		cedrus_jpeg_enc_marker(writer, 0xdb);
+		cedrus_jpeg_enc_word(writer, 67);
+		cedrus_jpeg_enc_byte(writer, component);
+		for (i = 0; i < 64; i++) {
+			unsigned int index = v4l2_jpeg_zigzag_scan_index[i];
+
+			cedrus_jpeg_enc_byte(writer, tables->quant[component][index]);
+		}
+	}
+	cedrus_jpeg_enc_marker(writer, 0xc0);
+	cedrus_jpeg_enc_word(writer, 17);
+	cedrus_jpeg_enc_byte(writer, 8);
+	cedrus_jpeg_enc_word(writer, height);
+	cedrus_jpeg_enc_word(writer, width);
+	cedrus_jpeg_enc_byte(writer, 3);
+	for (component = 0; component < 3; component++) {
+		cedrus_jpeg_enc_byte(writer, component + 1);
+		cedrus_jpeg_enc_byte(writer, component ? 0x11 : 0x22);
+		cedrus_jpeg_enc_byte(writer, !!component);
+	}
+	cedrus_jpeg_enc_huffman(writer, 0, v4l2_jpeg_ref_table_luma_dc_ht, 28);
+	cedrus_jpeg_enc_huffman(writer, 0x10, v4l2_jpeg_ref_table_luma_ac_ht, 178);
+	cedrus_jpeg_enc_huffman(writer, 1, v4l2_jpeg_ref_table_chroma_dc_ht, 28);
+	cedrus_jpeg_enc_huffman(writer, 0x11, v4l2_jpeg_ref_table_chroma_ac_ht, 178);
+	cedrus_jpeg_enc_marker(writer, 0xda);
+	cedrus_jpeg_enc_word(writer, 12);
+	cedrus_jpeg_enc_byte(writer, 3);
+	for (component = 0; component < 3; component++) {
+		cedrus_jpeg_enc_byte(writer, component + 1);
+		cedrus_jpeg_enc_byte(writer, component ? 0x11 : 0);
+	}
+	cedrus_jpeg_enc_byte(writer, 0);
+	cedrus_jpeg_enc_byte(writer, 63);
+	cedrus_jpeg_enc_byte(writer, 0);
+	return writer->error;
+}
+
+#endif
