+void cedrus_watchdog_start(struct cedrus_dev *dev)
+{
+	unsigned long timeout = msecs_to_jiffies(2000);
+
+	WRITE_ONCE(dev->watchdog_deadline, jiffies + timeout);
+	schedule_delayed_work(&dev->watchdog_work, timeout);
+}
+
 static irqreturn_t cedrus_irq(int irq, void *data)
 {
 	struct cedrus_dev *dev = data;
 	struct cedrus_ctx *ctx;
+	unsigned long now, deadline;
 	enum vb2_buffer_state state;
 	enum cedrus_irq_status status;
 
+	if ((cedrus_read(dev, VE_MODE) & BIT(7)) &&
+	    !(cedrus_read(dev, VE_AVC_STATUS) & 0xf))
+		return IRQ_NONE;
+
 	/*
 	 * If cancel_delayed_work returns false it means watchdog already
 	 * executed and finished the job.
@@ -218,9 +233,15 @@ static irqreturn_t cedrus_irq(int irq, void *data)
 		return IRQ_NONE;
 	}
 
+	if (ctx->encoder) {
+		if (cedrus_enc_irq(ctx) == IRQ_HANDLED)
+			return IRQ_HANDLED;
+		goto rearm_watchdog;
+	}
+
 	status = ctx->current_codec->irq_status(ctx);
 	if (status == CEDRUS_IRQ_NONE)
-		return IRQ_NONE;
+		goto rearm_watchdog;
 
 	ctx->current_codec->irq_disable(ctx);
 	ctx->current_codec->irq_clear(ctx);
@@ -234,6 +255,14 @@ static irqreturn_t cedrus_irq(int irq, void *data)
 					 state);
 
 	return IRQ_HANDLED;
+
+rearm_watchdog:
+	/* A timeout can finish the previous job before cancellation succeeds. */
+	deadline = READ_ONCE(dev->watchdog_deadline);
+	now = jiffies;
+	schedule_delayed_work(&dev->watchdog_work,
+			      time_after(deadline, now) ? deadline - now : 0);
+	return IRQ_NONE;
 }
 
 void cedrus_watchdog(struct work_struct *work)
@@ -248,6 +277,11 @@ void cedrus_watchdog(struct work_struct *work)
 	if (!ctx)
 		return;
 
+	if (ctx->encoder) {
+		cedrus_enc_timeout(ctx);
+		return;
+	}
+
 	v4l2_err(&dev->v4l2_dev, "frame processing timed out!\n");
 
 
