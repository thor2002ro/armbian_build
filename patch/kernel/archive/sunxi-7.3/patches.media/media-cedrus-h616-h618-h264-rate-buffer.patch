Subject: [PATCH] Local: media: cedrus: allocate H264 macroblock rate buffer

Provide the vendor-sized DMA buffer for every H264 picture.
Prevent address-zero reads with fixed QP and software rate control.
---
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_enc.h b/drivers/staging/media/sunxi/cedrus/cedrus_enc.h
--- a/drivers/staging/media/sunxi/cedrus/cedrus_enc.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_enc.h
@@ -25,6 +25,7 @@
 	struct cedrus_dma recon[2];
 	struct cedrus_dma subpix[2];
 	struct cedrus_dma mbinfo;
+	struct cedrus_dma mb_rate_control;
 	struct cedrus_dma deblock;
 	struct cedrus_dma qp_map;
 	struct cedrus_dma motion_bitmap;
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_enc_h264.c b/drivers/staging/media/sunxi/cedrus/cedrus_enc_h264.c
--- a/drivers/staging/media/sunxi/cedrus/cedrus_enc_h264.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_enc_h264.c
@@ -61,7 +61,7 @@
 	u32 width = ctx->src_fmt.width, height = ctx->src_fmt.height;
 	u32 index = enc->index, reference = enc->idr ? index : index ^ 1;
 	u32 start, end, recon, ref, sub, subref, info, deblock = 0, qp_map = 0, motion = 0;
-	u32 parameter, smart = 0, map_qp = enc->qp;
+	u32 parameter, rate_control, smart = 0, map_qp = enc->qp;
 	int ret;
 
 	if (!cedrus_enc_h264_supported(dev))
@@ -89,6 +89,10 @@
 	if (ret)
 		return ret;
 	ret = cedrus_h264_dma(enc->mbinfo.dma, width * 8, &info);
+	if (ret)
+		return ret;
+	ret = cedrus_h264_dma(enc->mb_rate_control.dma,
+			      enc->mb_rate_control.size, &rate_control);
 	if (ret)
 		return ret;
 	if (width >= 2048) {
@@ -145,6 +149,7 @@
 	cedrus_write(dev, CEDRUS_ENC_REG(0x88), 0);
 	cedrus_write(dev, CEDRUS_ENC_REG(0x8c), size * 8);
 	cedrus_write(dev, CEDRUS_ENC_REG(0x90), 0);
+	cedrus_write(dev, CEDRUS_ENC_REG(0x9c), rate_control);
 	cedrus_write(dev, CEDRUS_ENC_REG(0xa0), ref);
 	cedrus_write(dev, CEDRUS_ENC_REG(0xa4), ref + (enc->layout.luma >> 8));
 	cedrus_write(dev, CEDRUS_ENC_REG(0xb0), recon);
@@ -241,7 +246,7 @@
 	struct cedrus_dma *buffers[] = {
 		&enc->recon[0],	 &enc->recon[1], &enc->subpix[0],
 		&enc->subpix[1], &enc->mbinfo,	 &enc->deblock,
-		&enc->qp_map, &enc->motion_bitmap,
+		&enc->qp_map, &enc->motion_bitmap, &enc->mb_rate_control,
 	};
 	unsigned int i;
 
@@ -333,6 +338,12 @@
 		if (ret)
 			goto error;
 	}
+	ret = cedrus_enc_dma_alloc(ctx, &enc->mb_rate_control,
+				   (ctx->src_fmt.height / 16) * 12 + 500);
+	if (ret)
+		goto error;
+	memset(enc->mb_rate_control.cpu, 0, enc->mb_rate_control.size);
+	dma_wmb();
 	ret = cedrus_enc_dma_alloc(ctx, &enc->qp_map,
 				   (ctx->src_fmt.width / 16) *
 					   (ctx->src_fmt.height / 16));
