From: thor2002ro <thor2002ro@gmail.com>
Subject: [PATCH] Local: media: cedrus: allow H616/H618 8K VP9 testing

Raise the H616 and H618 VP9 limit to 7680x4320.
Expand VP9 scratch buffers for experimental 8K decoding.
Reject VP8 and VP9 frames outside the negotiated dimensions.

Signed-off-by: thor2002ro <thor2002ro@gmail.com>
---
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus.c b/drivers/staging/media/sunxi/cedrus/cedrus.c
--- a/drivers/staging/media/sunxi/cedrus/cedrus.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus.c
@@ -762,6 +762,7 @@
 			  CEDRUS_CAPABILITY_H265_DEC |
 			  CEDRUS_CAPABILITY_H265_10_DEC |
 			  CEDRUS_CAPABILITY_H265_8K_DEC |
+			  CEDRUS_CAPABILITY_VP9_8K_DEC |
 			  CEDRUS_CAPABILITY_VP8_DEC |
 			  CEDRUS_CAPABILITY_VP9_DEC |
 			  CEDRUS_CAPABILITY_VC1_DEC,
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus.h b/drivers/staging/media/sunxi/cedrus/cedrus.h
--- a/drivers/staging/media/sunxi/cedrus/cedrus.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus.h
@@ -39,6 +39,7 @@
 #define CEDRUS_CAPABILITY_JPEG_DEC	BIT(8)
 #define CEDRUS_CAPABILITY_H264_ENC	BIT(9)
 #define CEDRUS_CAPABILITY_H265_8K_DEC	BIT(10)
+#define CEDRUS_CAPABILITY_VP9_8K_DEC	BIT(11)
 
 enum cedrus_irq_status {
 	CEDRUS_IRQ_NONE,
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_video.c b/drivers/staging/media/sunxi/cedrus/cedrus_video.c
--- a/drivers/staging/media/sunxi/cedrus/cedrus_video.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_video.c
@@ -195,6 +195,10 @@
 	    cedrus_is_capable(ctx, CEDRUS_CAPABILITY_H265_8K_DEC)) {
 		max_width = CEDRUS_H265_8K_MAX_WIDTH;
 		max_height = CEDRUS_H265_8K_MAX_HEIGHT;
+	} else if (source_format == V4L2_PIX_FMT_VP9_FRAME &&
+		   cedrus_is_capable(ctx, CEDRUS_CAPABILITY_VP9_8K_DEC)) {
+		max_width = CEDRUS_VP9_8K_MAX_WIDTH;
+		max_height = CEDRUS_VP9_8K_MAX_HEIGHT;
 	}
 
 	/* Limit to hardware min/max. */
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_video.h b/drivers/staging/media/sunxi/cedrus/cedrus_video.h
--- a/drivers/staging/media/sunxi/cedrus/cedrus_video.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_video.h
@@ -30,6 +30,8 @@
 #define CEDRUS_MAX_HEIGHT	2304U
 #define CEDRUS_H265_8K_MAX_WIDTH	7680U
 #define CEDRUS_H265_8K_MAX_HEIGHT	4320U
+#define CEDRUS_VP9_8K_MAX_WIDTH	7680U
+#define CEDRUS_VP9_8K_MAX_HEIGHT	4320U
 
 extern const struct v4l2_ioctl_ops cedrus_ioctl_ops;
 
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_vp8.c b/drivers/staging/media/sunxi/cedrus/cedrus_vp8.c
--- a/drivers/staging/media/sunxi/cedrus/cedrus_vp8.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_vp8.c
@@ -661,6 +661,11 @@
 	dma_addr_t src_buf_addr;
 	int header_size;
 	u32 reg;
+
+	if (!slice->width || !slice->height ||
+	    slice->width > ctx->src_fmt.width ||
+	    slice->height > ctx->src_fmt.height)
+		return -EINVAL;
 
 	cedrus_engine_enable(ctx);
 
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_vp9.c b/drivers/staging/media/sunxi/cedrus/cedrus_vp9.c
--- a/drivers/staging/media/sunxi/cedrus/cedrus_vp9.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_vp9.c
@@ -251,6 +251,7 @@
 
 	void		*neighbor_buf;
 	dma_addr_t	neighbor_buf_dma;
+	size_t		neighbor_buf_size;
 
 	void		*col_mv_buf;
 	dma_addr_t	col_mv_buf_dma;
@@ -753,6 +754,9 @@
 
 	cur_w = dec->frame_width_minus_1 + 1;
 	cur_h = dec->frame_height_minus_1 + 1;
+	if (cur_w > ctx->src_fmt.width || cur_h > ctx->src_fmt.height)
+		return -EINVAL;
+
 	p010 = cedrus_dst_is_p010(ctx);
 	afbc = cedrus_dst_is_afbc(ctx);
 
@@ -1221,8 +1225,12 @@
 	if (!vp9->prob_tbl)
 		goto err_free_ctx;
 
+	/* Reserve neighbor state for each 4K frame region. */
+	vp9->neighbor_buf_size = CEDRUS_VP9_NEIGHBOR_BUF_SIZE *
+		DIV_ROUND_UP(ctx->src_fmt.width, CEDRUS_MAX_WIDTH) *
+		DIV_ROUND_UP(ctx->src_fmt.height, CEDRUS_MAX_HEIGHT);
 	vp9->neighbor_buf = dma_alloc_coherent(dev->dev,
-					       CEDRUS_VP9_NEIGHBOR_BUF_SIZE,
+					       vp9->neighbor_buf_size,
 					       &vp9->neighbor_buf_dma,
 					       GFP_KERNEL);
 	if (!vp9->neighbor_buf)
@@ -1250,7 +1258,7 @@
 	return 0;
 
 err_free_neighbor:
-	dma_free_coherent(dev->dev, CEDRUS_VP9_NEIGHBOR_BUF_SIZE,
+	dma_free_coherent(dev->dev, vp9->neighbor_buf_size,
 			  vp9->neighbor_buf, vp9->neighbor_buf_dma);
 err_free_prob:
 	dma_free_coherent(dev->dev, CEDRUS_VP9_PROB_TBL_SIZE,
@@ -1267,7 +1275,7 @@
 
 	dma_free_coherent(dev->dev, vp9->col_mv_buf_size,
 			  vp9->col_mv_buf, vp9->col_mv_buf_dma);
-	dma_free_coherent(dev->dev, CEDRUS_VP9_NEIGHBOR_BUF_SIZE,
+	dma_free_coherent(dev->dev, vp9->neighbor_buf_size,
 			  vp9->neighbor_buf, vp9->neighbor_buf_dma);
 	dma_free_coherent(dev->dev, CEDRUS_VP9_PROB_TBL_SIZE,
 			  vp9->prob_tbl, vp9->prob_tbl_dma);
-- 
Armbian
