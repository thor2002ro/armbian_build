+int cedrus_enc_h264_pad(struct vb2_buffer *buffer, u32 bytes, u32 total)
+{
+	struct dma_buf *dmabuf = buffer->planes[0].dbuf;
+	struct iosys_map map;
+	void *address;
+	int ret, end_ret;
+
+	if (total < bytes || total > vb2_plane_size(buffer, 0))
+		return -ENOSPC;
+	if (total == bytes)
+		return 0;
+	if (!dmabuf) {
+		address = vb2_plane_vaddr(buffer, 0);
+		if (!address)
+			return -EFAULT;
+		memset(address + bytes, 0, total - bytes);
+		return 0;
+	}
+	ret = dma_buf_begin_cpu_access(dmabuf, DMA_BIDIRECTIONAL);
+	if (ret)
+		return ret;
+	ret = dma_buf_vmap_unlocked(dmabuf, &map);
+	if (!ret) {
+		iosys_map_memset(&map, bytes, 0, total - bytes);
+		dma_buf_vunmap_unlocked(dmabuf, &map);
+	}
+	end_ret = dma_buf_end_cpu_access(dmabuf, DMA_BIDIRECTIONAL);
+	return ret ?: end_ret;
+}
