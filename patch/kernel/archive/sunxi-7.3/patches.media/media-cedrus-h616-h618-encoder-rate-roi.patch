diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_enc_controls.h b/drivers/staging/media/sunxi/cedrus/cedrus_enc_controls.h
new file mode 100644
--- /dev/null
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_enc_controls.h
@@ -0,0 +1,187 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _CEDRUS_ENC_CONTROLS_H_
+#define _CEDRUS_ENC_CONTROLS_H_
+
+#include <linux/types.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/math64.h>
+
+#include <media/cedrus-enc-ctrls.h>
+
+struct cedrus_h264_rc {
+	u32 bitrate, target_bits, peak_bits;
+	u32 min_qp, max_qp, qp;
+	u32 capacity, tokens, picture_target, gop_size, gop_left;
+	s64 gop_remaining;
+	s64 debt, cbr_debt;
+};
+
+static inline int cedrus_h264_rc_init(struct cedrus_h264_rc *rc, u32 bitrate,
+				      u32 peak, u32 numerator, u32 denominator,
+				      u32 min_qp, u32 max_qp, u32 initial_qp)
+{
+	u64 target, maximum;
+
+	if (!bitrate || peak < bitrate || !numerator || !denominator ||
+	    min_qp > max_qp || max_qp > 51)
+		return -EINVAL;
+	target = max_t(u64, 1, div_u64((u64)bitrate * numerator, denominator));
+	maximum = max_t(u64, 1, div_u64((u64)peak * numerator, denominator));
+	if (target > 0xffffffffU || maximum > 0xffffffffU)
+		return -ERANGE;
+	*rc = (struct cedrus_h264_rc){
+		.bitrate = bitrate,
+		.target_bits = target,
+		.peak_bits = maximum,
+		.min_qp = min_qp,
+		.max_qp = max_qp,
+		.qp = clamp_t(u32, initial_qp, min_qp, max_qp),
+	};
+	return 0;
+}
+
+static inline int cedrus_h264_rc_configure(struct cedrus_h264_rc *rc, u32 cpb_kbytes)
+{
+	if (!cpb_kbytes || cpb_kbytes > 32768)
+		return -EINVAL;
+	rc->capacity = cpb_kbytes * 8192;
+	rc->tokens = rc->capacity;
+	rc->gop_left = 0;
+	return 0;
+}
+
+static inline void cedrus_h264_rc_begin(struct cedrus_h264_rc *rc, u32 gop, bool idr)
+{
+	u64 target;
+
+	rc->tokens = min_t(u64, rc->capacity, (u64)rc->tokens + rc->peak_bits);
+	if (idr || !rc->gop_left || rc->gop_size != gop) {
+		s64 budget = (u64)rc->target_bits * gop;
+
+		rc->gop_remaining = clamp_t(s64, budget - rc->debt, budget / 2, budget * 2);
+		rc->gop_size = rc->gop_left = gop;
+		target = div_u64(max_t(s64, 1, rc->gop_remaining) * 4, gop + 3);
+	} else {
+		target = div_u64(max_t(s64, 1, rc->gop_remaining), rc->gop_left);
+	}
+	rc->picture_target = clamp_t(u64, target, 1, max_t(u32, 1, rc->tokens));
+}
+
+static inline int cedrus_h264_rc_retry(struct cedrus_h264_rc *rc, u32 bits,
+				       u32 stream_bits, u32 *qp, u32 *attempts)
+{
+	u32 budget;
+
+	if (!rc->capacity)
+		return 0;
+	budget = min_t(u32, rc->tokens, stream_bits);
+	if (bits <= budget)
+		return 0;
+	if (*attempts >= 3 || *qp >= rc->max_qp)
+		return -ENOSPC;
+	(*attempts)++;
+	*qp = min_t(u32, rc->max_qp, *qp + *attempts * 3);
+	return 1;
+}
+
+static inline int cedrus_h264_cbr_size(const struct cedrus_h264_rc *rc,
+				      u32 bytes, u32 capacity)
+{
+	s64 missing = (s64)rc->target_bits - rc->cbr_debt;
+	u64 output = max_t(u64, bytes, (max_t(s64, 0, missing) + 7) / 8);
+
+	if (output > capacity || output * 8 > rc->tokens)
+		return -ENOSPC;
+	return output;
+}
+
+static inline void cedrus_h264_rc_update(struct cedrus_h264_rc *rc, u32 bits)
+{
+	u32 target = rc->picture_target ? rc->picture_target : rc->target_bits;
+	s64 error = (s64)bits - target;
+	int step = 0;
+
+	/* Keep one second of bitrate debt across successful pictures. */
+	rc->debt = clamp_t(s64, rc->debt + (s64)bits - rc->target_bits, -(s64)rc->bitrate,
+			   (s64)rc->bitrate);
+	if (error > target / 2)
+		step = 2;
+	else if (error > target / 8)
+		step = 1;
+	else if (error < -(s64)target / 8)
+		step = -1;
+	else if (rc->debt > (s64)rc->target_bits * 4)
+		step = 1;
+	else if (rc->debt < -(s64)rc->target_bits * 4)
+		step = -1;
+	rc->qp = clamp_t(int, (int)rc->qp + step, rc->min_qp, rc->max_qp);
+	if (rc->capacity) {
+		rc->tokens -= min_t(u32, bits, rc->tokens);
+		rc->gop_remaining -= bits;
+		if (rc->gop_left)
+			rc->gop_left--;
+	}
+}
+
+static inline int cedrus_h264_roi_validate(const struct cedrus_h264_roi *roi,
+					   u32 width, u32 height)
+{
+	unsigned int i;
+
+	for (i = 0; i < CEDRUS_H264_ROI_COUNT; i++) {
+		const struct cedrus_h264_roi *r = &roi[i];
+
+		if (r->flags & ~(CEDRUS_ROI_ENABLE | CEDRUS_ROI_ABSOLUTE_QP))
+			return -EINVAL;
+		if (!(r->flags & CEDRUS_ROI_ENABLE))
+			continue;
+		if (!r->width || !r->height ||
+		    ((r->left | r->top | r->width | r->height) & 15) ||
+		    r->left >= width || r->top >= height ||
+		    r->width > width - r->left || r->height > height - r->top ||
+		    r->qp > 51 ||
+		    r->qp < ((r->flags & CEDRUS_ROI_ABSOLUTE_QP) ? 0 : -51))
+			return -EINVAL;
+	}
+	return 0;
+}
+
+static inline int cedrus_h264_roi_map(u8 *map, u32 size, u32 width, u32 height,
+				      u32 qp, u32 min_qp, u32 max_qp,
+				      const struct cedrus_h264_roi *roi)
+{
+	u32 x, y, i, mb_width = width / 16, mb_height = height / 16;
+	int ret;
+
+	if (!map || !width || !height || ((width | height) & 15) || qp > 51 ||
+	    min_qp > max_qp || max_qp > 51 || (u64)mb_width * mb_height > size)
+		return -EINVAL;
+	ret = cedrus_h264_roi_validate(roi, width, height);
+	if (ret)
+		return ret;
+	for (y = 0; y < mb_height; y++)
+		for (x = 0; x < mb_width; x++) {
+			int selected = qp;
+
+			/* The first enabled region wins overlapping macroblocks. */
+			for (i = 0; i < CEDRUS_H264_ROI_COUNT; i++) {
+				const struct cedrus_h264_roi *r = &roi[i];
+
+				if (!(r->flags & CEDRUS_ROI_ENABLE) ||
+				    x < r->left / 16 ||
+				    x >= (r->left + r->width) / 16 ||
+				    y < r->top / 16 ||
+				    y >= (r->top + r->height) / 16)
+					continue;
+				selected = (r->flags & CEDRUS_ROI_ABSOLUTE_QP) ?
+						   r->qp :
+						   (int)qp + r->qp;
+				break;
+			}
+			map[y * mb_width + x] =
+				0x80 | clamp_t(int, selected, min_qp, max_qp);
+		}
+	return 0;
+}
+#endif
