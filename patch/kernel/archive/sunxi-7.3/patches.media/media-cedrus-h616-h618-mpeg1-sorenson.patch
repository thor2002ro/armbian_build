+
+static u32 cedrus_mpeg2_output(struct cedrus_ctx *ctx, dma_addr_t luma,
+			       dma_addr_t chroma)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	u32 format;
+
+	if (!cedrus_is_capable(ctx, CEDRUS_CAPABILITY_MPEG1_DEC))
+		return 0;
+	cedrus_write(dev, VE_DEC_MPEG_ROT_LUMA, luma);
+	cedrus_write(dev, VE_DEC_MPEG_ROT_CHROMA, chroma);
+	cedrus_write(dev, VE_DEC_MPEG_SD_ROT_DBLK_CTL, 0);
+	format = cedrus_read(dev, VE_PRIMARY_OUT_FMT);
+	cedrus_write(dev, VE_PRIMARY_OUT_FMT,
+		     (format & ~GENMASK(3, 0)) | ((format >> 4) & 0xf));
+	if (ctx->dst_fmt.pixelformat == V4L2_PIX_FMT_NV12_32L32)
+		cedrus_write(dev, VE_CHROMA_BUF_LEN, VE_SECONDARY_OUT_FMT_TILED_32_NV12);
+	else
+		cedrus_write(dev, VE_CHROMA_BUF_LEN,
+			VE_SECONDARY_OUT_FMT_EXT | VE_CHROMA_WIDTH_ALIGN_8 |
+			VE_CHROMA_BUF_LEN_SDRT(ctx->dst_fmt.bytesperline * ctx->dst_fmt.height / 4));
+	return VE_DEC_MPEG_CTRL_ROTATE_SCALE_OUT_EN;
 }
 
