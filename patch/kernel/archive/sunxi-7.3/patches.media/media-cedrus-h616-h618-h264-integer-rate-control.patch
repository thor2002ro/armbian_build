From: thor2002ro <thor2002ro@gmail.com>
Subject: [PATCH] Local: media: cedrus: use integer H264 rate control

Use one fixed-point rate model on ARM32 and ARM64.
Remove floating-point emulation and compiler-dependent decisions.

Signed-off-by: thor2002ro <thor2002ro@gmail.com>
---
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_enc_controls.h b/drivers/staging/media/sunxi/cedrus/cedrus_enc_controls.h
--- a/drivers/staging/media/sunxi/cedrus/cedrus_enc_controls.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_enc_controls.h
@@ -14,30 +14,17 @@
 #define CEDRUS_RC_HISTORY 20
 #define CEDRUS_RC_MAX_RATE BIT(28)
 
-#ifdef __SIZEOF_INT128__
-struct cedrus_mad_fp {
-	s64 fraction;
-	int exponent;
-};
-#endif
-
 struct cedrus_h264_sample {
 	/* MAD and rate use Q8. Qstep uses four fractional bits. */
 	u32 step, rate, mad, bits;
-	u32 sad, pixels;
 };
 
 struct cedrus_h264_model {
 	struct cedrus_h264_sample sample[CEDRUS_RC_HISTORY];
 	u32 count, window, mad_window, last_mad;
 	u32 mad_count, oldest_mad;
-	u32 oldest_sad, oldest_pixels;
-	/* RD coefficients follow the vendor rate versus quantizer model. */
-	#ifdef __SIZEOF_INT128__
-	struct cedrus_mad_fp x1, x2;
-#else
+	/* X1 uses Q12; X2 uses integer units. */
 	s64 x1, x2;
-#endif
 	u32 last_i_bits, last_i_target, last_i_qp;
 	bool have_i;
 };
@@ -50,7 +37,6 @@
 	return (u32)steps[qp % 6] << (qp / 6);
 }
 
-#ifndef __SIZEOF_INT128__
 static inline u32 cedrus_h264_model_qp(s64 x1, s64 x2, u32 mad, u32 bits)
 {
 	u64 target;
@@ -98,398 +84,11 @@
 	model->x1 = div64_s64(sy - model->x2 * sx, n);
 }
 
-#endif
-
 static inline u32 cedrus_h264_mad_at(const struct cedrus_h264_model *model, u32 index)
 {
 	return index == CEDRUS_RC_HISTORY ? model->oldest_mad : model->sample[index].mad;
 }
 
-#ifdef __SIZEOF_INT128__
-/* Integer arithmetic preserves vendor binary64 rounding for zero and finite normal operands. */
-
-static inline int cedrus_mad_bits(unsigned __int128 value)
-{
-	u64 high = value >> 64;
-
-	return high ? 128 - __builtin_clzll(high) :
-	       value ? 64 - __builtin_clzll((u64)value) : 0;
-}
-
-static inline u64 cedrus_mad_abs(struct cedrus_mad_fp value)
-{
-	return value.fraction < 0 ? -value.fraction : value.fraction;
-}
-
-static inline struct cedrus_mad_fp cedrus_mad_round(bool negative,
-						    unsigned __int128 value, int exponent)
-{
-	unsigned __int128 fraction, remainder, half;
-	int shift;
-
-	if (!value)
-		return (struct cedrus_mad_fp){0};
-	/* Round to nearest, ties to even. */
-	shift = cedrus_mad_bits(value) - 53;
-	if (shift > 0) {
-		fraction = value >> shift;
-		remainder = value & (((unsigned __int128)1 << shift) - 1);
-		half = (unsigned __int128)1 << (shift - 1);
-		fraction += remainder > half || (remainder == half && (fraction & 1));
-	} else {
-		fraction = value << -shift;
-	}
-	if (fraction >> 53) {
-		fraction >>= 1;
-		shift++;
-	}
-	return (struct cedrus_mad_fp) {
-		.fraction = negative ? -(s64)fraction : (s64)fraction,
-		.exponent = exponent + shift,
-	};
-}
-
-static inline unsigned __int128 cedrus_mad_align(unsigned __int128 value, int shift)
-{
-	unsigned __int128 mask;
-
-	if (shift >= 0)
-		return value << shift;
-	if (shift <= -128)
-		return !!value;
-	mask = ((unsigned __int128)1 << -shift) - 1;
-	return (value >> -shift) | !!(value & mask);
-}
-
-static inline struct cedrus_mad_fp cedrus_mad_sum(unsigned __int128 a, int ae, bool an,
-						  unsigned __int128 b, int be, bool bn)
-{
-	int exponent;
-
-	if (!a)
-		return cedrus_mad_round(bn, b, be);
-	if (!b)
-		return cedrus_mad_round(an, a, ae);
-	exponent = max_t(int, ae + cedrus_mad_bits(a), be + cedrus_mad_bits(b)) - 126;
-	a = cedrus_mad_align(a, ae - exponent);
-	b = cedrus_mad_align(b, be - exponent);
-	if (an == bn)
-		return cedrus_mad_round(an, a + b, exponent);
-	return a >= b ? cedrus_mad_round(an, a - b, exponent) :
-		       cedrus_mad_round(bn, b - a, exponent);
-}
-
-static inline struct cedrus_mad_fp cedrus_mad_from(u64 value, int exponent)
-{
-	return cedrus_mad_round(false, value, exponent);
-}
-
-static inline struct cedrus_mad_fp cedrus_mad_neg(struct cedrus_mad_fp value)
-{
-	value.fraction = -value.fraction;
-	return value;
-}
-
-static inline struct cedrus_mad_fp cedrus_mad_add(struct cedrus_mad_fp a,
-						  struct cedrus_mad_fp b)
-{
-	return cedrus_mad_sum(cedrus_mad_abs(a), a.exponent, a.fraction < 0,
-			      cedrus_mad_abs(b), b.exponent, b.fraction < 0);
-}
-
-static inline struct cedrus_mad_fp cedrus_mad_mul(struct cedrus_mad_fp a,
-						  struct cedrus_mad_fp b)
-{
-	return cedrus_mad_round((a.fraction < 0) != (b.fraction < 0),
-		(unsigned __int128)cedrus_mad_abs(a) * cedrus_mad_abs(b),
-		a.exponent + b.exponent);
-}
-
-static inline struct cedrus_mad_fp cedrus_mad_fma(struct cedrus_mad_fp a,
-						  struct cedrus_mad_fp b,
-						  struct cedrus_mad_fp c)
-{
-	return cedrus_mad_sum((unsigned __int128)cedrus_mad_abs(a) * cedrus_mad_abs(b),
-			      a.exponent + b.exponent, (a.fraction < 0) != (b.fraction < 0),
-			      cedrus_mad_abs(c), c.exponent, c.fraction < 0);
-}
-
-static inline struct cedrus_mad_fp cedrus_mad_div(struct cedrus_mad_fp a,
-						  struct cedrus_mad_fp b)
-{
-	u64 remainder = cedrus_mad_abs(a), divisor = cedrus_mad_abs(b), quotient = 1;
-	int i, exponent = a.exponent - b.exponent - 55;
-
-	if (!remainder || !divisor)
-		return (struct cedrus_mad_fp){0};
-	if (remainder < divisor) {
-		remainder <<= 1;
-		exponent--;
-	}
-	remainder -= divisor;
-	for (i = 0; i < 55; i++) {
-		remainder <<= 1;
-		quotient <<= 1;
-		if (remainder >= divisor) {
-			remainder -= divisor;
-			quotient++;
-		}
-	}
-	return cedrus_mad_round((a.fraction < 0) != (b.fraction < 0),
-				quotient | !!remainder, exponent);
-}
-
-static inline bool cedrus_mad_greater(struct cedrus_mad_fp a, struct cedrus_mad_fp b)
-{
-	if (!a.fraction)
-		return false;
-	if (!b.fraction)
-		return true;
-	return a.exponent != b.exponent ? a.exponent > b.exponent :
-					 a.fraction > b.fraction;
-}
-
-static inline struct cedrus_mad_fp cedrus_mad_sqrt(struct cedrus_mad_fp value)
-{
-	unsigned __int128 remainder, root = 0, bit = (unsigned __int128)1 << 104;
-	u64 fraction;
-	int exponent = value.exponent;
-
-	if (value.fraction <= 0)
-		return (struct cedrus_mad_fp){0};
-	fraction = value.fraction;
-	if (exponent & 1) {
-		fraction <<= 1;
-		exponent--;
-	}
-	remainder = (unsigned __int128)fraction << 52;
-	while (bit) {
-		if (remainder >= root + bit) {
-			remainder -= root + bit;
-			root = (root >> 1) + bit;
-		} else {
-			root >>= 1;
-		}
-		bit >>= 2;
-	}
-	if (remainder > root)
-		root++;
-	return cedrus_mad_round(false, root, exponent / 2 - 26);
-}
-
-static inline struct cedrus_mad_fp cedrus_mad_float(struct cedrus_mad_fp value)
-{
-	u64 fraction = cedrus_mad_abs(value), remainder = fraction & ((1ULL << 29) - 1);
-
-	fraction >>= 29;
-	fraction += remainder > (1ULL << 28) ||
-		     (remainder == (1ULL << 28) && (fraction & 1));
-	return cedrus_mad_round(value.fraction < 0, fraction, value.exponent + 29);
-}
-
-static inline u32 cedrus_mad_u32(struct cedrus_mad_fp value, int fractional_bits)
-{
-	int shift = value.exponent + fractional_bits;
-
-	if (value.fraction <= 0 || shift <= -64)
-		return 0;
-	if (shift >= 0)
-		return 0xffffffffU;
-	return min_t(u64, (u64)value.fraction >> -shift, 0xffffffffU);
-}
-
-static inline struct cedrus_mad_fp cedrus_h264_sample_activity(const struct cedrus_h264_sample *s)
-{
-	if (s->pixels)
-		return cedrus_mad_div(cedrus_mad_from(s->sad, 0), cedrus_mad_from(s->pixels, 0));
-	return cedrus_mad_from(s->mad, -8);
-}
-
-static inline struct cedrus_mad_fp cedrus_h264_activity_at(const struct cedrus_h264_model *m,
-							   u32 index)
-{
-	if (index != CEDRUS_RC_HISTORY)
-		return cedrus_h264_sample_activity(&m->sample[index]);
-	if (m->oldest_pixels)
-		return cedrus_mad_div(cedrus_mad_from(m->oldest_sad, 0),
-				      cedrus_mad_from(m->oldest_pixels, 0));
-	return cedrus_mad_from(m->oldest_mad, -8);
-}
-
-static inline u32 cedrus_h264_model_qp_value(struct cedrus_mad_fp x1, struct cedrus_mad_fp x2,
-					     struct cedrus_mad_fp activity, u32 bits)
-{
-	struct cedrus_mad_fp target, linear, discriminant, factor, root, value;
-	u32 qp;
-
-	if (!bits)
-		return 51;
-	target = cedrus_mad_from(bits, 0);
-	linear = cedrus_mad_mul(activity, x1);
-	value = cedrus_mad_div(linear, target);
-	if (x2.fraction) {
-		discriminant = cedrus_mad_mul(cedrus_mad_mul(activity, linear), x1);
-		factor = cedrus_mad_mul(cedrus_mad_mul(x2, cedrus_mad_from(4, 0)), activity);
-		discriminant = cedrus_mad_fma(factor, target, discriminant);
-		if (discriminant.fraction >= 0) {
-			root = cedrus_mad_sqrt(discriminant);
-			root = cedrus_mad_add(root, cedrus_mad_neg(linear));
-			if (root.fraction > 0) {
-				factor = cedrus_mad_mul(cedrus_mad_add(x2, x2), activity);
-				value = cedrus_mad_div(factor, root);
-			}
-		}
-	}
-	value = cedrus_mad_float(value);
-	if (value.fraction <= 0)
-		return 0;
-	for (qp = 0; qp < 51; qp++) {
-		u32 step = cedrus_h264_qstep(qp);
-		u32 boundary = step + (qp % 6 == 5 ? step : cedrus_h264_qstep(qp + 1));
-
-		if (!cedrus_mad_greater(value, cedrus_mad_from(boundary, -5)))
-			return qp;
-	}
-	return 51;
-}
-
-static inline u32 cedrus_h264_model_qp(struct cedrus_mad_fp x1,
-				       struct cedrus_mad_fp x2, u32 mad, u32 bits)
-{
-	return mad ? cedrus_h264_model_qp_value(x1, x2, cedrus_mad_from(mad, -8), bits) : 51;
-}
-
-static inline struct cedrus_mad_fp cedrus_h264_sample_rate(const struct cedrus_h264_sample *s)
-{
-	return cedrus_mad_div(cedrus_mad_from(s->bits, 0), cedrus_h264_sample_activity(s));
-}
-
-static inline void cedrus_h264_model_fit(struct cedrus_h264_model *model,
-					 const bool *reject, u32 count)
-{
-	/* Vendor covariance cutoff: 1e-6. */
-	const struct cedrus_mad_fp epsilon = { .fraction = 0x10c6f7a0b5ed8dLL, .exponent = -72 };
-	struct cedrus_mad_fp sx = {0}, sy = {0}, sxx = {0}, sxy = {0};
-	struct cedrus_mad_fp step, rate, inverse, n, product, determinant, magnitude;
-	u32 i, used = 0;
-
-	for (i = 0; i < count; i++) {
-		if (reject[i])
-			continue;
-		step = cedrus_mad_from(model->sample[i].step, -4);
-		rate = cedrus_h264_sample_rate(&model->sample[i]);
-		inverse = cedrus_mad_div(cedrus_mad_from(1, 0), step);
-		sxy = cedrus_mad_fma(step, rate, sxy);
-		sy = cedrus_mad_add(sy, rate);
-		sx = cedrus_mad_add(sx, inverse);
-		inverse = cedrus_mad_div(cedrus_mad_from(1, 0), cedrus_mad_mul(step, step));
-		sxx = cedrus_mad_add(sxx, inverse);
-		used++;
-	}
-	if (!used) {
-		model->x1 = (struct cedrus_mad_fp){0};
-		model->x2 = (struct cedrus_mad_fp){0};
-		return;
-	}
-	n = cedrus_mad_from(used, 0);
-	determinant = cedrus_mad_fma(n, sxx, cedrus_mad_neg(cedrus_mad_mul(sx, sx)));
-	magnitude = determinant;
-	magnitude.fraction = cedrus_mad_abs(magnitude);
-	if (!cedrus_mad_greater(magnitude, epsilon))
-		return;
-	product = cedrus_mad_fma(sxx, sxy, cedrus_mad_neg(cedrus_mad_mul(sx, sy)));
-	model->x1 = cedrus_mad_div(product, determinant);
-	product = cedrus_mad_fma(n, sy, cedrus_mad_neg(cedrus_mad_mul(sx, sxy)));
-	model->x2 = cedrus_mad_div(product, determinant);
-}
-
-static inline void cedrus_h264_mad_fit(const struct cedrus_h264_model *model,
-				       const bool *reject, u32 count,
-				       struct cedrus_mad_fp *slope,
-				       struct cedrus_mad_fp *offset)
-{
-	const struct cedrus_mad_fp epsilon = { .fraction = 0x10c6f7a0b5ed8dLL, .exponent = -72 };
-	struct cedrus_mad_fp sx = {0}, sy = {0}, sxx = {0}, sxy = {0}, first = {0};
-	struct cedrus_mad_fp x, y, n, product, determinant, magnitude;
-	u32 i, used = 0;
-	bool different = false;
-
-	*slope = (struct cedrus_mad_fp){0};
-	*offset = (struct cedrus_mad_fp){0};
-	for (i = 0; i < count; i++) {
-		if (reject[i])
-			continue;
-		x = cedrus_h264_activity_at(model, i + 1);
-		y = cedrus_h264_activity_at(model, i);
-		if (!used)
-			first = y;
-		different |= y.fraction != first.fraction || y.exponent != first.exponent;
-		sx = cedrus_mad_add(sx, x);
-		sy = cedrus_mad_add(sy, y);
-		sxx = cedrus_mad_fma(x, x, sxx);
-		sxy = cedrus_mad_fma(x, y, sxy);
-		used++;
-	}
-	if (!used)
-		return;
-	n = cedrus_mad_from(used, 0);
-	determinant = cedrus_mad_fma(n, sxx, cedrus_mad_neg(cedrus_mad_mul(sx, sx)));
-	magnitude = determinant;
-	magnitude.fraction = cedrus_mad_abs(magnitude);
-	if (different && cedrus_mad_greater(magnitude, epsilon)) {
-		product = cedrus_mad_fma(n, sxy, cedrus_mad_neg(cedrus_mad_mul(sx, sy)));
-		*slope = cedrus_mad_div(product, determinant);
-		product = cedrus_mad_fma(sxx, sy, cedrus_mad_neg(cedrus_mad_mul(sx, sxy)));
-		*offset = cedrus_mad_div(product, determinant);
-	} else if (different) {
-		*slope = cedrus_mad_div(sy, sx);
-	} else {
-		for (i = 0; i < count; i++) {
-			if (reject[i])
-				continue;
-			x = cedrus_h264_activity_at(model, i + 1);
-			y = cedrus_h264_activity_at(model, i);
-			product = cedrus_mad_div(y, cedrus_mad_mul(n, x));
-			*slope = cedrus_mad_add(*slope, product);
-		}
-	}
-}
-
-static inline struct cedrus_mad_fp cedrus_h264_model_activity(const struct cedrus_h264_model *m)
-{
-	bool reject[CEDRUS_RC_HISTORY] = { false };
-	struct cedrus_mad_fp errors[CEDRUS_RC_HISTORY], total = {0}, threshold = {0};
-	struct cedrus_mad_fp slope, offset, prediction;
-	u32 i, count;
-
-	if (m->count < 2)
-		return m->count ? cedrus_h264_activity_at(m, 0) : (struct cedrus_mad_fp){0};
-	count = min_t(u32, m->mad_window, max_t(u32, m->mad_count, m->count) - 1);
-	if (!count)
-		return cedrus_h264_activity_at(m, 0);
-	cedrus_h264_mad_fit(m, reject, count, &slope, &offset);
-	for (i = 0; i < count; i++) {
-		prediction = cedrus_mad_fma(slope, cedrus_h264_activity_at(m, i + 1), offset);
-		errors[i] = cedrus_h264_activity_at(m, i);
-		errors[i] = cedrus_mad_add(prediction, cedrus_mad_neg(errors[i]));
-		total = cedrus_mad_fma(errors[i], errors[i], total);
-	}
-	if (count != 2)
-		threshold = cedrus_mad_div(total, cedrus_mad_from(count, 0));
-	for (i = 1; i < count; i++)
-		reject[i] = cedrus_mad_greater(cedrus_mad_mul(errors[i], errors[i]), threshold);
-	cedrus_h264_mad_fit(m, reject, count, &slope, &offset);
-	return cedrus_mad_fma(slope, cedrus_h264_activity_at(m, 0), offset);
-}
-
-static inline u32 cedrus_h264_model_mad(const struct cedrus_h264_model *m)
-{
-	if (m->count < 2)
-		return m->last_mad;
-	return clamp_t(u32, cedrus_mad_u32(cedrus_h264_model_activity(m), 8), 1, 65535);
-}
-
-#else
 static inline void cedrus_h264_mad_fit(const struct cedrus_h264_model *model,
 				       const bool *reject, u32 count,
 				       s64 *slope, s64 *offset)
@@ -500,7 +99,7 @@
 	bool different = false;
 
 	for (i = 0; i < count; i++) {
-		s64 x = model->sample[i + 1].mad;
+		s64 x = cedrus_h264_mad_at(model, i + 1);
 		s64 y = model->sample[i].mad;
 
 		if (reject[i])
@@ -515,6 +114,11 @@
 		ratios += div64_s64(y * 65536, x);
 		n++;
 	}
+	if (!n) {
+		*slope = 0;
+		*offset = 0;
+		return;
+	}
 	*slope = div64_s64(ratios, n);
 	*offset = 0;
 	if (!different)
@@ -535,15 +139,17 @@
 	s64 slope, offset;
 	u32 i, count;
 
-	if (model->count < 2)
+	if (model->mad_count < 2)
 		return model->last_mad;
-	count = min_t(u32, model->mad_window, model->count - 1);
+	count = min_t(u32, model->mad_window, model->mad_count - 1);
 	if (!count)
 		return model->last_mad;
 	cedrus_h264_mad_fit(model, reject, count, &slope, &offset);
 	for (i = 0; i < count; i++) {
-		s64 error = div64_s64(slope * model->sample[i + 1].mad + offset -
-				    (s64)model->sample[i].mad * 65536, 65536);
+		s64 prediction = clamp_t(s64,
+			div64_s64(slope * cedrus_h264_mad_at(model, i + 1) + offset, 65536),
+			1, 65535);
+		s64 error = prediction - model->sample[i].mad;
 
 		errors[i] = error * error;
 		total += errors[i];
@@ -554,141 +160,34 @@
 	return clamp_t(s64, div64_s64(slope * model->last_mad + offset, 65536), 1, 65535);
 }
 
-#endif
-
-static inline u32 cedrus_h264_initial_qp(u32 bits, u32 width, u32 height)
-{
-	u64 pixels = (u64)width * height;
-	u32 qp = 35;
-
-	if (!pixels)
-		return qp;
-	if ((u64)bits * 5 > pixels * 3)
-		qp = 10;
-	else if ((u64)bits * 10 > pixels * 3)
-		qp = 20;
-	else if ((u64)bits * 20 > pixels)
-		qp = div_u64(pixels * 37 - (u64)bits * 40, pixels);
-	if (width == 3840 && height == 2160)
-		qp += (u64)bits * 100 > pixels * 21 ? 6 :
-		      (u64)bits * 100 > pixels * 12 ? 5 : 4;
-	return qp;
-}
-
 static inline u32 cedrus_h264_startup_qp(u32 bitrate, u32 numerator, u32 denominator,
 					 u32 width, u32 height)
 {
-#ifdef __SIZEOF_INT128__
-	struct cedrus_mad_fp fps, pixels, bpp, low, medium, high, value;
+	u64 bits, pixels;
 	u32 qp = 35;
 
-	if (!bitrate || !numerator || !denominator || !width || !height)
+	if (!bitrate || !numerator || !denominator || !width || !height ||
+	    width > 4096 || height > 4096)
 		return qp;
-	/* The vendor rounds bitrate, frame rate, and pixel rate to binary32. */
-	fps = cedrus_mad_float(cedrus_mad_div(cedrus_mad_from(denominator, 0),
-					      cedrus_mad_from(numerator, 0)));
-	pixels = cedrus_mad_float(cedrus_mad_mul(cedrus_mad_from(width, 0), fps));
-	pixels = cedrus_mad_float(cedrus_mad_mul(pixels, cedrus_mad_from(height, 0)));
-	bpp = cedrus_mad_div(cedrus_mad_float(cedrus_mad_from(bitrate, 0)), pixels);
-	low = cedrus_mad_div(cedrus_mad_from(1, 0), cedrus_mad_from(20, 0));
-	medium = cedrus_mad_div(cedrus_mad_from(3, 0), cedrus_mad_from(10, 0));
-	high = cedrus_mad_div(cedrus_mad_from(3, 0), cedrus_mad_from(5, 0));
-	if (cedrus_mad_greater(bpp, high)) {
+	bits = (u64)bitrate * numerator;
