+static inline u32 cedrus_h264_initial_qp(u32 bits, u32 width, u32 height)
+{
+	u64 pixels = (u64)width * height;
+	u32 qp = 35;
+
+	if (!pixels)
+		return qp;
+	if ((u64)bits * 5 > pixels * 3)
+		qp = 10;
+	else if ((u64)bits * 10 > pixels * 3)
+		qp = 20;
+	else if ((u64)bits * 20 > pixels)
+		qp = div_u64(pixels * 37 - (u64)bits * 40, pixels);
+	if (width == 3840 && height == 2160)
+		qp += (u64)bits * 100 > pixels * 21 ? 6 :
+		      (u64)bits * 100 > pixels * 12 ? 5 : 4;
+	return qp;
 }
 
