new file mode 100644
--- /dev/null
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_enc_motion.h
@@ -0,0 +1,207 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _CEDRUS_ENC_MOTION_H_
+#define _CEDRUS_ENC_MOTION_H_
+
+#include <linux/bitops.h>
+#include <linux/kernel.h>
+#include <linux/math64.h>
+#include <linux/string.h>
+#include <linux/types.h>
+
+struct cedrus_h264_rect {
+	u32 left, right, top, bottom;
+};
+
+struct cedrus_h264_motion {
+	struct cedrus_h264_rect rect[8];
+	u32 count, moving_count, static_count, level;
+	bool moving;
+};
+
+static inline u32 cedrus_h264_avbr_qp(u32 quality)
+{
+	static const u8 qp[] = { 44, 41, 38, 35, 32, 30, 28, 26, 24, 22, 20, 17, 14 };
+
+	return qp[clamp_t(u32, quality, 1, ARRAY_SIZE(qp)) - 1];
+}
+
+static inline void cedrus_h264_motion_level(struct cedrus_h264_motion *motion,
+					    const u8 *bitmap, u32 blocks)
+{
+	u32 i, active = 0, bits = blocks * 4;
+
+	for (i = 0; i < blocks / 2; i++)
+		active += hweight8(bitmap[i]);
+	if (blocks & 1)
+		active += hweight8(bitmap[blocks / 2] & 15);
+	if ((u64)active * 200 > bits)
+		motion->moving_count = min_t(u32, motion->moving_count + 1, 3);
+	else
+		motion->moving_count = 0;
+	motion->moving = motion->moving_count >= 3;
+	motion->level = !motion->moving ? 0 : active * 10 > bits ? 3 :
+			active * 20 > bits ? 2 : 1;
+}
+
+static inline void cedrus_h264_motion_state(struct cedrus_h264_motion *motion,
+					    u32 coverage, u32 blocks)
+{
+	if ((u64)coverage * 2 > blocks) {
+		motion->static_count = 0;
+		motion->moving_count = min_t(u32, motion->moving_count + 1, 3);
+		if (motion->moving_count >= 3)
+			motion->moving = true;
+	} else {
+		motion->moving_count = 0;
+		motion->static_count = min_t(u32, motion->static_count + 1, 10);
+		if (motion->static_count >= 10)
+			motion->moving = false;
+	}
+}
+
+static inline u32 cedrus_h264_motion_bitrate(const struct cedrus_h264_motion *motion,
+					     u32 bitrate, u32 peak, u32 quality)
+{
+	u32 scale = motion->moving ? motion->level == 3 ? 16 :
+		    motion->level == 2 ? 12 : 10 : quality;
+
+	return clamp_t(u64, div_u64((u64)bitrate * scale, 10), 1, peak);
+}
+
+static inline u32 cedrus_h264_motion_neighbors(const u8 *grid, u32 width, u32 at)
+{
+	u32 count = 0;
+	int x, y;
+
+	for (y = -1; y <= 1; y++)
+		for (x = -1; x <= 1; x++)
+			count += grid[(int)at + y * (int)width + x] != 0;
+	return count;
+}
+
+static inline void cedrus_h264_motion_cluster(struct cedrus_h264_rect *r,
+					      const u8 *grid, u8 *visited, u32 *queue,
+					      u32 width, u32 blocks, u32 seed)
+{
+	u32 head = 0, tail = 0;
+	int dx, dy;
+
+	queue[tail++] = seed;
+	visited[seed] = 1;
+	while (head < tail) {
+		u32 at = queue[head++], x = at % width, y = at / width;
+
+		r->left = min_t(u32, r->left, x);
+		r->right = max_t(u32, r->right, x);
+		r->top = min_t(u32, r->top, y);
+		r->bottom = max_t(u32, r->bottom, y);
+		for (dy = -3; dy <= 3; dy++)
+			for (dx = -3; dx <= 3; dx++) {
+				int next = (int)at + dy * (int)width + dx;
+
+				if (next < 0 || next >= (int)blocks || !grid[next] || visited[next])
+					continue;
+				visited[next] = 1;
+				queue[tail++] = next;
+			}
+	}
+}
+
+static inline u32 cedrus_h264_rect_area(const struct cedrus_h264_rect *r)
+{
+	return (r->right - r->left) * (r->bottom - r->top);
+}
+
+static inline void cedrus_h264_motion_regions(struct cedrus_h264_motion *motion,
+					      const u8 *bitmap, void *workspace,
+					      u32 width, u32 height)
+{
+	struct cedrus_h264_rect rect[32];
+	u32 blocks = width * height;
+	u8 *input = workspace, *filtered = input + blocks;
+	u8 *dilated = filtered + blocks, *output = dilated + blocks;
+	u32 *queue = (u32 *)(output + blocks);
+	u32 i, x, y, count = 0;
+	int dx, dy;
+
+	memset(workspace, 0, blocks * 4);
+	motion->count = 0;
+	for (i = 0; i < blocks; i++)
+		input[i] = !!((bitmap[i / 2] >> ((i & 1) * 4)) & 15);
+	for (y = 1; y + 1 < height; y++)
+		for (x = 1; x + 1 < width; x++) {
+			i = y * width + x;
+			filtered[i] = input[i] &&
+				cedrus_h264_motion_neighbors(input, width, i) > 1;
+		}
+	for (y = 1; y + 1 < height; y++)
+		for (x = 1; x + 1 < width; x++) {
+			i = y * width + x;
+			if (!filtered[i])
+				continue;
+			dilated[i] = 1;
+			if (cedrus_h264_motion_neighbors(filtered, width, i) <= 4)
+				continue;
+			for (dy = -1; dy <= 1; dy++)
+				for (dx = -1; dx <= 1; dx++)
+					dilated[(int)i + dy * (int)width + dx] = 1;
+		}
+	for (y = 1; y + 1 < height; y++)
+		for (x = 1; x + 1 < width; x++) {
+			i = y * width + x;
+			if (!dilated[i])
+				continue;
+			for (dy = -1; dy <= 1; dy++)
+				for (dx = -1; dx <= 1; dx++) {
+					int nx = x + dx, ny = y + dy;
+
+					if (nx > 0 && nx + 1 < (int)width &&
+					    ny > 0 && ny + 1 < (int)height)
+						output[ny * width + nx] = 1;
+				}
+		}
+	/* Reuse the input grid for visits. Use a queue instead of vendor recursion. */
+	memset(input, 0, blocks);
+	for (y = 1; y + 1 < height; y++)
+		for (x = 1; x + 1 < width; x++)
+			input[y * width + x] = dilated[y * width + x];
+	for (y = 3; y + 3 < height && count < ARRAY_SIZE(rect); y++)
+		for (x = 3; x + 3 < width && count < ARRAY_SIZE(rect); x++) {
+			struct cedrus_h264_rect *r = &rect[count];
+
+			i = y * width + x;
+			if (!output[i] || input[i])
+				continue;
+			*r = (struct cedrus_h264_rect){ x, x, y, y };
+			cedrus_h264_motion_cluster(r, output, input, queue, width, blocks, i);
+			r->left = r->left > 2 ? r->left - 2 : 0;
+			r->top = r->top > 2 ? r->top - 2 : 0;
+			r->right = min_t(u32, r->right + 2, width - 1);
+			r->bottom = min_t(u32, r->bottom + 2, height - 1);
+			count++;
+		}
+	if (count > ARRAY_SIZE(motion->rect)) {
+		u32 keep = 0;
+
+		for (i = 0; i < count; i++)
+			if (rect[i].right - rect[i].left > 2 || rect[i].bottom - rect[i].top > 2)
+				rect[keep++] = rect[i];
+		count = keep;
+		for (i = 0; i < min_t(u32, count, ARRAY_SIZE(motion->rect)); i++)
+			for (x = i + 1; x < count; x++) {
+				u32 a = cedrus_h264_rect_area(&rect[i]);
+				u32 b = cedrus_h264_rect_area(&rect[x]);
+
+				if (b > a) {
+					struct cedrus_h264_rect tmp = rect[i];
+
+					rect[i] = rect[x];
+					rect[x] = tmp;
+				}
+			}
+	}
+	motion->count = min_t(u32, count, ARRAY_SIZE(motion->rect));
+	memcpy(motion->rect, rect, motion->count * sizeof(rect[0]));
+}
+
+#endif
