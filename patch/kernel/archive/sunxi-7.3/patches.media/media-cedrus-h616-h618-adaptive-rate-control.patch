+
+#ifdef __SIZEOF_INT128__
+/* MAD operands stay finite and normal. Integer arithmetic preserves vendor binary64 rounding. */
+struct cedrus_mad_fp {
+	s64 fraction;
+	int exponent;
+};
+
+static inline int cedrus_mad_bits(unsigned __int128 value)
+{
+	u64 high = value >> 64;
+
+	return high ? 128 - __builtin_clzll(high) :
+	       value ? 64 - __builtin_clzll((u64)value) : 0;
+}
+
+static inline u64 cedrus_mad_abs(struct cedrus_mad_fp value)
+{
+	return value.fraction < 0 ? -value.fraction : value.fraction;
+}
+
+static inline struct cedrus_mad_fp cedrus_mad_round(bool negative,
+						    unsigned __int128 value, int exponent)
+{
+	unsigned __int128 fraction, remainder, half;
+	int shift;
+
+	if (!value)
+		return (struct cedrus_mad_fp){0};
+	/* Round to nearest, ties to even. */
+	shift = cedrus_mad_bits(value) - 53;
+	if (shift > 0) {
+		fraction = value >> shift;
+		remainder = value & (((unsigned __int128)1 << shift) - 1);
+		half = (unsigned __int128)1 << (shift - 1);
+		fraction += remainder > half || (remainder == half && (fraction & 1));
+	} else {
+		fraction = value << -shift;
+	}
+	if (fraction >> 53) {
+		fraction >>= 1;
+		shift++;
+	}
+	return (struct cedrus_mad_fp) {
+		.fraction = negative ? -(s64)fraction : (s64)fraction,
+		.exponent = exponent + shift,
+	};
+}
+
+static inline unsigned __int128 cedrus_mad_align(unsigned __int128 value, int shift)
+{
+	unsigned __int128 mask;
+
+	if (shift >= 0)
+		return value << shift;
+	if (shift <= -128)
+		return !!value;
+	mask = ((unsigned __int128)1 << -shift) - 1;
+	return (value >> -shift) | !!(value & mask);
+}
+
+static inline struct cedrus_mad_fp cedrus_mad_sum(unsigned __int128 a, int ae, bool an,
+						  unsigned __int128 b, int be, bool bn)
+{
+	int exponent;
+
+	if (!a)
+		return cedrus_mad_round(bn, b, be);
+	if (!b)
+		return cedrus_mad_round(an, a, ae);
+	exponent = max_t(int, ae + cedrus_mad_bits(a), be + cedrus_mad_bits(b)) - 126;
+	a = cedrus_mad_align(a, ae - exponent);
+	b = cedrus_mad_align(b, be - exponent);
+	if (an == bn)
+		return cedrus_mad_round(an, a + b, exponent);
+	return a >= b ? cedrus_mad_round(an, a - b, exponent) :
+		       cedrus_mad_round(bn, b - a, exponent);
+}
+
+static inline struct cedrus_mad_fp cedrus_mad_from(u64 value, int exponent)
+{
+	return cedrus_mad_round(false, value, exponent);
+}
+
+static inline struct cedrus_mad_fp cedrus_mad_neg(struct cedrus_mad_fp value)
+{
+	value.fraction = -value.fraction;
+	return value;
+}
+
+static inline struct cedrus_mad_fp cedrus_mad_add(struct cedrus_mad_fp a,
+						  struct cedrus_mad_fp b)
+{
+	return cedrus_mad_sum(cedrus_mad_abs(a), a.exponent, a.fraction < 0,
+			      cedrus_mad_abs(b), b.exponent, b.fraction < 0);
+}
+
+static inline struct cedrus_mad_fp cedrus_mad_mul(struct cedrus_mad_fp a,
+						  struct cedrus_mad_fp b)
+{
+	return cedrus_mad_round((a.fraction < 0) != (b.fraction < 0),
+		(unsigned __int128)cedrus_mad_abs(a) * cedrus_mad_abs(b),
+		a.exponent + b.exponent);
+}
+
+static inline struct cedrus_mad_fp cedrus_mad_fma(struct cedrus_mad_fp a,
+						  struct cedrus_mad_fp b,
+						  struct cedrus_mad_fp c)
+{
+	return cedrus_mad_sum((unsigned __int128)cedrus_mad_abs(a) * cedrus_mad_abs(b),
+			      a.exponent + b.exponent, (a.fraction < 0) != (b.fraction < 0),
+			      cedrus_mad_abs(c), c.exponent, c.fraction < 0);
+}
+
+static inline struct cedrus_mad_fp cedrus_mad_div(struct cedrus_mad_fp a,
+						  struct cedrus_mad_fp b)
+{
+	u64 remainder = cedrus_mad_abs(a), divisor = cedrus_mad_abs(b), quotient = 1;
+	int i, exponent = a.exponent - b.exponent - 55;
+
+	if (!remainder || !divisor)
+		return (struct cedrus_mad_fp){0};
+	if (remainder < divisor) {
+		remainder <<= 1;
+		exponent--;
+	}
+	remainder -= divisor;
+	for (i = 0; i < 55; i++) {
+		remainder <<= 1;
+		quotient <<= 1;
+		if (remainder >= divisor) {
+			remainder -= divisor;
+			quotient++;
+		}
+	}
+	return cedrus_mad_round((a.fraction < 0) != (b.fraction < 0),
+				quotient | !!remainder, exponent);
+}
+
+static inline bool cedrus_mad_greater(struct cedrus_mad_fp a, struct cedrus_mad_fp b)
+{
+	if (!a.fraction)
+		return false;
+	if (!b.fraction)
+		return true;
+	return a.exponent != b.exponent ? a.exponent > b.exponent :
+					 a.fraction > b.fraction;
+}
+
+static inline void cedrus_h264_mad_fit(const struct cedrus_h264_model *model,
+				       const bool *reject, u32 count,
+				       struct cedrus_mad_fp *slope,
+				       struct cedrus_mad_fp *offset)
+{
+	u64 sx = 0, sy = 0, sxx = 0, sxy = 0, n = 0;
+	struct cedrus_mad_fp denominator, product, sum;
+	s64 determinant, numerator;
+	u32 i, first = 0;
+	bool different = false;
+
+	*slope = (struct cedrus_mad_fp){0};
+	*offset = (struct cedrus_mad_fp){0};
 	for (i = 0; i < count; i++) {
-		s64 x = model->sample[i + 1].mad;
-		s64 y = model->sample[i].mad;
-
+		u64 x = cedrus_h264_mad_at(model, i + 1);
+		u64 y = model->sample[i].mad;
+
+		if (reject[i])
+			continue;
+		if (!n)
+			first = y;
+		different |= y != first;
 		sx += x;
 		sy += y;
 		sxx += x * x;
 		sxy += x * y;
-	}
-	determinant = count * sxx - sx * sx;
-	if (determinant <= 0)
+		n++;
+	}
+	if (!n)
+		return;
+	determinant = (s64)n * sxx - (s64)sx * sx;
+	if (different && determinant > 0) {
+		denominator = cedrus_mad_from(determinant, -16);
+		numerator = (s64)n * sxy - (s64)sx * sy;
+		product = cedrus_mad_round(numerator < 0,
+					   numerator < 0 ? -numerator : numerator, -16);
+		*slope = cedrus_mad_div(product, denominator);
+		product = cedrus_mad_mul(cedrus_mad_from(sx, -8), cedrus_mad_from(sxy, -16));
+		sum = cedrus_mad_fma(cedrus_mad_from(sxx, -16), cedrus_mad_from(sy, -8),
+				     cedrus_mad_neg(product));
+		*offset = cedrus_mad_div(sum, denominator);
+	} else if (different) {
+		*slope = cedrus_mad_div(cedrus_mad_from(sy, 0), cedrus_mad_from(sx, 0));
+	} else {
+		for (i = 0; i < count; i++) {
+			if (reject[i])
+				continue;
+			denominator = cedrus_mad_from(n * cedrus_h264_mad_at(model, i + 1), 0);
+			product = cedrus_mad_div(cedrus_mad_from(model->sample[i].mad, 0),
+						 denominator);
+			*slope = cedrus_mad_add(*slope, product);
+		}
+	}
+}
+
+static inline u32 cedrus_h264_model_mad(const struct cedrus_h264_model *model)
+{
+	bool reject[CEDRUS_RC_HISTORY] = { false };
+	struct cedrus_mad_fp errors[CEDRUS_RC_HISTORY], total = {0};
+	struct cedrus_mad_fp slope, offset, prediction, threshold = {0};
+	u32 i, count;
+	int shift;
+
+	if (model->count < 2)
 		return model->last_mad;
-	slope = div64_s64((count * sxy - sx * sy) * 256, determinant);
-	slope = clamp_t(s64, slope, -4096, 4096);
-	offset = div64_s64(sy * 256 - slope * sx, count);
-	return clamp_t(s64, div64_s64(slope * model->last_mad + offset, 256), 1, 65535);
+	count = min_t(u32, model->mad_window,
+		      max_t(u32, model->mad_count, model->count) - 1);
+	if (!count)
+		return model->last_mad;
+	cedrus_h264_mad_fit(model, reject, count, &slope, &offset);
+	for (i = 0; i < count; i++) {
+		prediction = cedrus_mad_from(cedrus_h264_mad_at(model, i + 1), -8);
+		prediction = cedrus_mad_fma(slope, prediction, offset);
+		errors[i] = cedrus_mad_from(model->sample[i].mad, -8);
+		errors[i] = cedrus_mad_add(prediction, cedrus_mad_neg(errors[i]));
+		total = cedrus_mad_fma(errors[i], errors[i], total);
+	}
+	if (count != 2)
+		threshold = cedrus_mad_div(total, cedrus_mad_from(count, 0));
+	for (i = 1; i < count; i++)
+		reject[i] = cedrus_mad_greater(cedrus_mad_mul(errors[i], errors[i]), threshold);
+	cedrus_h264_mad_fit(model, reject, count, &slope, &offset);
+	prediction = cedrus_mad_mul(slope, cedrus_mad_from(model->last_mad, -8));
+	prediction = cedrus_mad_add(prediction, offset);
+	if (prediction.fraction <= 0)
+		return 1;
+	if (prediction.exponent >= -44)
+		return 65535;
+	shift = -prediction.exponent - 8;
+	return shift >= 64 ? 1 : max_t(u64, prediction.fraction >> shift, 1);
+}
+
+#else
+static inline void cedrus_h264_mad_fit(const struct cedrus_h264_model *model,
+				       const bool *reject, u32 count,
+				       s64 *slope, s64 *offset)
+{
+	s64 sx = 0, sy = 0, sxx = 0, sxy = 0, ratios = 0, n = 0;
+	s64 determinant;
+	u32 i, first = 0;
+	bool different = false;
+
+	for (i = 0; i < count; i++) {
+		s64 x = model->sample[i + 1].mad;
+		s64 y = model->sample[i].mad;
+
+		if (reject[i])
+			continue;
+		if (!n)
+			first = y;
+		different |= y != first;
+		sx += x;
+		sy += y;
+		sxx += x * x;
+		sxy += x * y;
+		ratios += div64_s64(y * 65536, x);
+		n++;
+	}
+	*slope = div64_s64(ratios, n);
+	*offset = 0;
+	if (!different)
+		return;
+	determinant = n * sxx - sx * sx;
+	if (determinant <= 0) {
+		*slope = div64_s64(sy * 65536, sx);
+		return;
+	}
+	*slope = div64_s64((n * sxy - sx * sy) * 65536, determinant);
+	*offset = div64_s64(sy * 65536 - *slope * sx, n);
+}
+
+static inline u32 cedrus_h264_model_mad(const struct cedrus_h264_model *model)
+{
+	bool reject[CEDRUS_RC_HISTORY] = { false };
+	u64 errors[CEDRUS_RC_HISTORY], total = 0;
+	s64 slope, offset;
+	u32 i, count;
+
+	if (model->count < 2)
+		return model->last_mad;
+	count = min_t(u32, model->mad_window, model->count - 1);
+	if (!count)
+		return model->last_mad;
+	cedrus_h264_mad_fit(model, reject, count, &slope, &offset);
+	for (i = 0; i < count; i++) {
+		s64 error = div64_s64(slope * model->sample[i + 1].mad + offset -
+				    (s64)model->sample[i].mad * 65536, 65536);
+
+		errors[i] = error * error;
+		total += errors[i];
+	}
+	for (i = 1; i < count; i++)
+		reject[i] = errors[i] > (count == 2 ? 0 : div_u64(total, count));
+	cedrus_h264_mad_fit(model, reject, count, &slope, &offset);
+	return clamp_t(s64, div64_s64(slope * model->last_mad + offset, 65536), 1, 65535);
+}
+
+#endif
