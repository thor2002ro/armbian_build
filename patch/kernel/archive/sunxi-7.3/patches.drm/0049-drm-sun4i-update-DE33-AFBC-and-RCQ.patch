From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Subject: [PATCH] drm/sun4i: update DE33 for AFBC and RCQ

Add H616 AFBC scanout with the newer DE33 scaler and RCQ support.
Keep Armbian's A523 backend and display handover.
Include writeback support and shared IOMMU mappings.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
Signed-off-by: thor2002ro <thor2002ro@gmail.com>
---
diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi b/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi
index 4f6369c..6c3964c 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi
@@ -179,9 +179,43 @@
 				#reset-cells = <1>;
 			};
 
+			writeback: writeback@11000 {
+				compatible = "allwinner,sun50i-h616-de33-wb";
+				reg = <0x11000 0x1000>, <0x8200 0x20>;
+				reg-names = "writeback", "rcq";
+				clocks = <&display_clocks CLK_BUS_MIXER0>,
+					 <&display_clocks CLK_WB>;
+				clock-names = "bus", "mod";
+				resets = <&display_clocks RST_WB>;
+				interrupts = <GIC_SPI 88 IRQ_TYPE_LEVEL_HIGH>;
+				allwinner,top = <&display_clocks>;
+
+				ports {
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					writeback_in: port@0 {
+						#address-cells = <1>;
+						#size-cells = <0>;
+						reg = <0>;
+
+						writeback_in_mixer0: endpoint@0 {
+							reg = <0>;
+							remote-endpoint = <&mixer0_out_writeback>;
+						};
+
+						writeback_in_mixer1: endpoint@1 {
+							reg = <1>;
+							remote-endpoint = <&mixer1_out_writeback>;
+						};
+					};
+				};
+			};
+
 			planes: planes@100000 {
 				compatible = "allwinner,sun50i-h616-de33-planes";
 				reg = <0x100000 0x180000>;
+				iommus = <&iommu 0>;
 				allwinner,plane-mapping = <&display_clocks>;
 			};
 
@@ -201,11 +235,19 @@
 					#size-cells = <0>;
 
 					mixer0_out: port@1 {
+						#address-cells = <1>;
+						#size-cells = <0>;
 						reg = <1>;
 
-						mixer0_out_tcon_top_mixer0: endpoint {
+						mixer0_out_tcon_top_mixer0: endpoint@0 {
+							reg = <0>;
 							remote-endpoint = <&tcon_top_mixer0_in_mixer0>;
 						};
+
+						mixer0_out_writeback: endpoint@1 {
+							reg = <1>;
+							remote-endpoint = <&writeback_in_mixer0>;
+						};
 					};
 				};
 			};
@@ -226,11 +268,19 @@
 					#size-cells = <0>;
 
 					mixer1_out: port@1 {
+						#address-cells = <1>;
+						#size-cells = <0>;
 						reg = <1>;
 
-						mixer1_out_tcon_top_mixer1: endpoint {
+						mixer1_out_tcon_top_mixer1: endpoint@0 {
+							reg = <0>;
 							remote-endpoint = <&tcon_top_mixer1_in_mixer1>;
 						};
+
+						mixer1_out_writeback: endpoint@1 {
+							reg = <1>;
+							remote-endpoint = <&writeback_in_mixer1>;
+						};
 					};
 				};
 			};
diff --git a/drivers/clk/sunxi-ng/ccu-sun8i-de2.c b/drivers/clk/sunxi-ng/ccu-sun8i-de2.c
index 26d8abd..be8bc46 100644
--- a/drivers/clk/sunxi-ng/ccu-sun8i-de2.c
+++ b/drivers/clk/sunxi-ng/ccu-sun8i-de2.c
@@ -286,17 +286,18 @@ static const struct sunxi_ccu_desc sun50i_h616_de33_clk_desc = {
 };
 
 /*
- * Add a regmap for the DE33 plane driver to access plane
- * mapping registers.
+ * Add a regmap for the DE33 plane and writeback drivers to access
+ * routing registers.
  * Only these registers are allowed to be written, to prevent
  * overriding clock and reset configuration.
  */
 
+#define SUN50I_DE33_RTWB_MUX_REG 0x20
 #define SUN50I_DE33_CHN2CORE_REG 0x24
 #define SUN50I_DE33_PORT12CHN_REG 0x2c
 
 static const struct regmap_range sun8i_de2_ccu_regmap_accessible_ranges[] = {
-	regmap_reg_range(SUN50I_DE33_CHN2CORE_REG, SUN50I_DE33_PORT12CHN_REG),
+	regmap_reg_range(SUN50I_DE33_RTWB_MUX_REG, SUN50I_DE33_PORT12CHN_REG),
 };
 
 static const struct regmap_access_table sun8i_de2_ccu_regmap_accessible_table = {
diff --git a/drivers/gpu/drm/drm_gem_framebuffer_helper.c b/drivers/gpu/drm/drm_gem_framebuffer_helper.c
index 88808e9..6114713 100644
--- a/drivers/gpu/drm/drm_gem_framebuffer_helper.c
+++ b/drivers/gpu/drm/drm_gem_framebuffer_helper.c
@@ -89,6 +89,11 @@ drm_gem_fb_init(struct drm_device *dev,
 	return ret;
 }
 
+static int drm_gem_afbc_min_size(struct drm_device *dev,
+				 const struct drm_format_info *info,
+				 const struct drm_mode_fb_cmd2 *mode_cmd,
+				 struct drm_afbc_framebuffer *afbc_fb);
+
 /**
  * drm_gem_fb_destroy - Free GEM backed framebuffer
  * @fb: Framebuffer
@@ -183,9 +188,19 @@ int drm_gem_fb_init_with_funcs(struct drm_device *dev,
 			goto err_gem_object_put;
 		}
 
-		min_size = (height - 1) * mode_cmd->pitches[i]
-			 + drm_format_info_min_pitch(info, i, width)
-			 + mode_cmd->offsets[i];
+		if (drm_is_afbc(mode_cmd->modifier[0])) {
+			struct drm_afbc_framebuffer afbc_fb = {};
+
+			ret = drm_gem_afbc_min_size(dev, info, mode_cmd,
+						    &afbc_fb);
+			if (ret)
+				goto err_gem_object_put;
+			min_size = afbc_fb.afbc_size;
+		} else {
+			min_size = (height - 1) * mode_cmd->pitches[i]
+				 + drm_format_info_min_pitch(info, i, width)
+				 + mode_cmd->offsets[i];
+		}
 
 		if (objs[i]->size < min_size) {
 			drm_dbg_kms(dev,
@@ -513,6 +528,8 @@ static __u32 drm_gem_afbc_get_bpp(struct drm_device *dev,
 		return 12;
 	case DRM_FORMAT_YUV420_10BIT:
 		return 15;
+	case DRM_FORMAT_Y210:
+		return 20;
 	case DRM_FORMAT_VUY101010:
 		return 30;
 	default:
@@ -573,6 +590,9 @@ static int drm_gem_afbc_min_size(struct drm_device *dev,
 	afbc_fb->afbc_size = ALIGN(n_blocks * AFBC_HEADER_SIZE, hdr_alignment);
 	afbc_fb->afbc_size += n_blocks * ALIGN(bpp * AFBC_SUPERBLOCK_PIXELS / 8,
 					       AFBC_SUPERBLOCK_ALIGNMENT);
+	if (afbc_fb->afbc_size > U32_MAX - afbc_fb->offset)
