From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: thor2002ro <thor2002ro@gmail.com>
Subject: [PATCH] phy: allwinner: support H616/H618 USB PHY tuning

Support masked updates for VREF, rise time, resistance, and pre-emphasis.
Set H616/H618 USB transmit pre-emphasis to the vendor value of 2.
Keep other fields unchanged unless selected by the SoC configuration.
Extend the PMU ranges to include the tuning register.

Link: https://github.com/orangepi-xunlong/linux-orangepi/blob/3a4a29414d558664847202f4d8919b8ab8bcf4a8/drivers/usb/host/sunxi-hci.h#L263-L271
Link: https://github.com/orangepi-xunlong/linux-orangepi/blob/3a4a29414d558664847202f4d8919b8ab8bcf4a8/drivers/usb/host/sunxi-hci.c#L522-L524
Signed-off-by: thor2002ro <thor2002ro@gmail.com>
---
diff --git a/drivers/phy/allwinner/phy-sun4i-usb.c b/drivers/phy/allwinner/phy-sun4i-usb.c
--- a/drivers/phy/allwinner/phy-sun4i-usb.c
+++ b/drivers/phy/allwinner/phy-sun4i-usb.c
@@ -42,6 +42,12 @@
 #define REG_PHY_OTGCTL			0x20
 
 #define REG_HCI_PHY_CTL			0x10
+#define REG_HCI_PHY_TUNE			0x18
+
+#define PHY_TX_VREF_TUNE			GENMASK(11, 8)
+#define PHY_TX_RISE_TUNE			GENMASK(5, 4)
+#define PHY_TX_RES_TUNE			GENMASK(3, 2)
+#define PHY_TX_PREEMPAMP_TUNE		GENMASK(1, 0)
 
 #define PHYCTL_DATA			BIT(7)
 
@@ -101,6 +107,8 @@
 	int hsic_index;
 	u32 disc_thresh;
 	u32 hci_phy_ctl_clear;
+	u32 hci_phy_tune_mask;
+	u32 hci_phy_tune;
 	u8 phyctl_offset;
 	bool dedicated_clocks;
 	bool phy0_dual_route;
@@ -331,6 +339,13 @@
 		writel(val, phy->pmu + REG_HCI_PHY_CTL);
 	}
 
+	if (phy->pmu && data->cfg->hci_phy_tune_mask) {
+		val = readl(phy->pmu + REG_HCI_PHY_TUNE);
+		val &= ~data->cfg->hci_phy_tune_mask;
+		val |= data->cfg->hci_phy_tune & data->cfg->hci_phy_tune_mask;
+		writel(val, phy->pmu + REG_HCI_PHY_TUNE);
+	}
+
 	if (data->cfg->siddq_in_base) {
 		if (phy->index == 0) {
 			val = readl(data->base + data->cfg->phyctl_offset);
@@ -1090,6 +1105,8 @@
 };
 
 static const struct sun4i_usb_phy_cfg sun50i_h616_cfg = {
+	.hci_phy_tune_mask = PHY_TX_PREEMPAMP_TUNE,
+	.hci_phy_tune = 2,
 	.disc_thresh = 3,
 	.phyctl_offset = REG_PHYCTL_A33,
 	.dedicated_clocks = true,
diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi b/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi
--- a/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi
@@ -1232,10 +1232,10 @@
 		usbphy: phy@5100400 {
 			compatible = "allwinner,sun50i-h616-usb-phy";
 			reg = <0x05100400 0x24>,
-			      <0x05101800 0x14>,
-			      <0x05200800 0x14>,
-			      <0x05310800 0x14>,
-			      <0x05311800 0x14>;
+			      <0x05101800 0x1c>,
+			      <0x05200800 0x1c>,
+			      <0x05310800 0x1c>,
+			      <0x05311800 0x1c>;
 			reg-names = "phy_ctrl",
 				    "pmu0",
 				    "pmu1",
