From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: thor2002ro <thor2002ro@gmail.com>
Subject: [PATCH] arm64: dts: allwinner: use one H616/H618 HDMI audio topology

Use the H616/H618 audio hub on boards with the new HDMI audio card.
Disable vendor audio devices that share the same hardware.

Signed-off-by: thor2002ro <thor2002ro@gmail.com>
---
diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h313-tanix-tx1.dts b/arch/arm64/boot/dts/allwinner/sun50i-h313-tanix-tx1.dts
--- a/arch/arm64/boot/dts/allwinner/sun50i-h313-tanix-tx1.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h313-tanix-tx1.dts
@@ -226,3 +226,21 @@
 &usbphy {
 	status = "okay";
 };
+
+/* Use the H616 audio hub for HDMI. */
+&ahub_dam_plat {
+	status = "disabled";
+};
+
+&ahub_dam_mach {
+	status = "disabled";
+};
+
+&ahub1_plat {
+	status = "disabled";
+};
+
+&ahub1_mach {
+	status = "disabled";
+};
+
diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h616-orangepi-zero2.dts b/arch/arm64/boot/dts/allwinner/sun50i-h616-orangepi-zero2.dts
