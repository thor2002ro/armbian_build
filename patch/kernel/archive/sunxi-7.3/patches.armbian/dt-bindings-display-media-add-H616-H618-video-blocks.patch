From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: thor2002ro <thor2002ro@gmail.com>
Subject: [PATCH] dt-bindings: display: media: describe H616/H618 video blocks

Describe the DI300 deinterlacer and DE33 writeback engine.
Allow the shared planes to use the display IOMMU.

Signed-off-by: thor2002ro <thor2002ro@gmail.com>
---
diff --git a/Documentation/devicetree/bindings/display/allwinner,sun50i-h616-de33-planes.yaml b/Documentation/devicetree/bindings/display/allwinner,sun50i-h616-de33-planes.yaml
index 0a07cb8..d7838a9 100644
--- a/Documentation/devicetree/bindings/display/allwinner,sun50i-h616-de33-planes.yaml
+++ b/Documentation/devicetree/bindings/display/allwinner,sun50i-h616-de33-planes.yaml
@@ -22,6 +22,9 @@ properties:
   reg:
     maxItems: 1
 
+  iommus:
+    maxItems: 1
+
   allwinner,plane-mapping:
     $ref: /schemas/types.yaml#/definitions/phandle
     description:
diff --git a/Documentation/devicetree/bindings/display/allwinner,sun50i-h616-de33-wb.yaml b/Documentation/devicetree/bindings/display/allwinner,sun50i-h616-de33-wb.yaml
new file mode 100644
index 0000000..e7e7609
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/allwinner,sun50i-h616-de33-wb.yaml
@@ -0,0 +1,66 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/allwinner,sun50i-h616-de33-wb.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner H616 Display Engine 3.3 writeback
+
+maintainers:
+  - Jernej Skrabec <jernej.skrabec@gmail.com>
+
+properties:
+  compatible:
+    const: allwinner,sun50i-h616-de33-wb
+
+  reg:
+    items:
+      - description: Writeback registers
+      - description: Register queue control
+
+  reg-names:
+    items:
+      - const: writeback
+      - const: rcq
+
+  clocks:
+    items:
+      - description: Interface clock
+      - description: Module clock
+
+  clock-names:
+    items:
+      - const: bus
+      - const: mod
+
+  resets:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  allwinner,top:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Display clock and routing controller.
+
+  ports:
+    $ref: /schemas/graph.yaml#/properties/ports
+    properties:
+      port@0:
+        $ref: /schemas/graph.yaml#/properties/port
+        description: Inputs from the display mixers.
+    required:
+      - port@0
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - clocks
+  - clock-names
+  - resets
+  - interrupts
+  - allwinner,top
+  - ports
+
+additionalProperties: false
diff --git a/Documentation/devicetree/bindings/media/allwinner,sun50i-h616-deinterlace.yaml b/Documentation/devicetree/bindings/media/allwinner,sun50i-h616-deinterlace.yaml
new file mode 100644
index 0000000..17f8c93
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/allwinner,sun50i-h616-deinterlace.yaml
@@ -0,0 +1,63 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/allwinner,sun50i-h616-deinterlace.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner H616 DI300 deinterlacer
+
+maintainers:
+  - Jernej Skrabec <jernej.skrabec@siol.net>
+
+properties:
+  compatible:
+    const: allwinner,sun50i-h616-deinterlace
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: Interface clock
+      - description: Module clock
+
+  clock-names:
+    items:
+      - const: bus
+      - const: mod
+
+  resets:
+    maxItems: 1
+
+  iommus:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+  - resets
+  - iommus
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/sun50i-h616-ccu.h>
+    #include <dt-bindings/reset/sun50i-h616-ccu.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    deinterlace@1420000 {
+        compatible = "allwinner,sun50i-h616-deinterlace";
+        reg = <0x01420000 0x40000>;
+        clocks = <&ccu CLK_BUS_DEINTERLACE>, <&ccu CLK_DEINTERLACE>;
+        clock-names = "bus", "mod";
+        resets = <&ccu RST_BUS_DEINTERLACE>;
+        interrupts = <GIC_SPI 89 IRQ_TYPE_LEVEL_HIGH>;
+        iommus = <&iommu 1>;
+    };
