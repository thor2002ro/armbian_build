From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: thor2002ro <thor2002ro@gmail.com>
Subject: [PATCH] arm64: dts: allwinner: keep Orange Pi Zero 3 Ethernet clocks active

Keep the Ethernet PHY PLL enabled and disable automatic sleep.
Match the vendor settings for the PHY clock output.

Signed-off-by: thor2002ro <thor2002ro@gmail.com>
---
diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h618-orangepi-zero3.dts b/arch/arm64/boot/dts/allwinner/sun50i-h618-orangepi-zero3.dts
--- a/arch/arm64/boot/dts/allwinner/sun50i-h618-orangepi-zero3.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h618-orangepi-zero3.dts
@@ -25,6 +25,8 @@
 
 &ext_rgmii_phy {
 	motorcomm,clk-out-frequency-hz = <125000000>;
+	motorcomm,keep-pll-enabled;
+	motorcomm,auto-sleep-disabled;
 };
 
 &gpu {
