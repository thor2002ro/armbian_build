From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: thor2002ro <thor2002ro@gmail.com>
Date: Fri, 23 Oct 2026 12:00:00 +0300
Subject: [PATCH] mmc: sunxi: abort probe when runtime resume fails

Do not register a host after runtime resume fails.
Release the runtime PM reference only after a successful get.

Signed-off-by: thor2002ro <thor2002ro@gmail.com>
---
diff --git a/drivers/mmc/host/sunxi-mmc.c b/drivers/mmc/host/sunxi-mmc.c
--- a/drivers/mmc/host/sunxi-mmc.c
+++ b/drivers/mmc/host/sunxi-mmc.c
@@ -1427,7 +1427,6 @@
 {
 	struct sunxi_mmc_host *host;
 	struct mmc_host *mmc;
-	bool pm_ref;
 	int ret;
 
 	mmc = devm_mmc_alloc_host(&pdev->dev, sizeof(*host));
@@ -1539,13 +1538,12 @@
 	pm_runtime_enable(&pdev->dev);
 	/* Pin device active (intentionally un-paired get) to avoid circular PM deadlock */
 	ret = pm_runtime_resume_and_get(&pdev->dev);
-	pm_ref = ret >= 0;
 	if (ret < 0)
-		dev_warn(&pdev->dev, "failed to resume during probe: %d\n", ret);
+		goto error_disable_pm;
 
 	ret = mmc_add_host(mmc);
 	if (ret)
-		goto error_disable_pm;
+		goto error_put_pm;
 
 	dev_info(&pdev->dev, "initialized, max. request size: %u KB%s\n",
 		 mmc->max_req_size >> 10,
@@ -1553,9 +1551,9 @@
 
 	return 0;
 
+error_put_pm:
+	pm_runtime_put_noidle(&pdev->dev);
 error_disable_pm:
-	if (pm_ref)
-		pm_runtime_put_noidle(&pdev->dev);
 	pm_runtime_disable(&pdev->dev);
 error_free_dma:
 	dma_free_coherent(&pdev->dev, PAGE_SIZE, host->sg_cpu, host->sg_dma);
