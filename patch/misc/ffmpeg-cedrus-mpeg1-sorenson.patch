+static int mpeg4_sprite(const Mpeg4DecContext *m, struct v4l2_ctrl_mpeg4_frame *f)
+{
+    struct v4l2_mpeg4_sprite *sprite = &f->sprite;
+    int accuracy = m->sprite_warping_accuracy;
+    int scale = 2 << accuracy;
+    int64_t x = (int16_t)m->sprite_traj[0][0];
+    int64_t y = (int16_t)m->sprite_traj[0][1];
+
+    if (!(m->divx_version == 500 && m->divx_build == 413)) {
+        x *= scale / 2;
+        y *= scale / 2;
+    }
+    if (!m->num_sprite_warping_points)
+        x = y = 0;
+    if (x < INT16_MIN || x > INT16_MAX || y < INT16_MIN || y > INT16_MAX)
+        return AVERROR(ENOSYS);
+    sprite->accuracy = accuracy;
+    for (int i = 0; i < m->num_sprite_warping_points; i++)
+        if (m->sprite_traj[i][0] || m->sprite_traj[i][1])
+            sprite->points = i + 1;
+    sprite->luma[0] = x;
+    sprite->luma[1] = y;
+    for (int bank = 0; bank < 2; bank++) {
+        int32_t *out = bank ? sprite->chroma : sprite->luma;
+        int64_t delta[4], offset[2], common;
+        int shift = 20;
+
+        if (m->num_sprite_warping_points <= 1) {
+            out[0] = bank ? (x >> 1) | (x & 1) : x;
+            out[1] = bank ? (y >> 1) | (y & 1) : y;
+            out[2] = out[5] = scale;
+            continue;
+        }
+        if (m->sprite_shift[0] < 0 || m->sprite_shift[0] > 16)
+            return AVERROR(ENOSYS);
+        for (int i = 0; i < 4; i++)
+            delta[i] = (int64_t)m->sprite_delta[i / 2][i % 2] *
+                       (1LL << (shift - m->sprite_shift[0] - 2 * bank));
+        offset[0] = (x + 1 - scale / 2) * (1LL << (shift - 1));
+        offset[1] = (y + 1 - scale / 2) * (1LL << (shift - 1));
+        while (shift) {
+            common = delta[0] | delta[1] | delta[2] | delta[3] | (1LL << (shift - 1));
+            if (bank)
+                common |= offset[0] | offset[1];
+            if (common & 1)
+                break;
+            for (int i = 0; i < 4; i++)
+                delta[i] >>= 1;
+            offset[0] >>= 1;
+            offset[1] >>= 1;
+            shift--;
+        }
+        if (bank) {
+            if (offset[0] < INT32_MIN || offset[0] > INT32_MAX ||
+                offset[1] < INT32_MIN || offset[1] > INT32_MAX)
+                return AVERROR(ENOSYS);
+            out[0] = offset[0];
+            out[1] = offset[1];
+        }
+        for (int i = 0; i < 4; i++) {
+            if (delta[i] < -65536 || delta[i] > 65535)
+                return AVERROR(ENOSYS);
+            out[2 + i] = delta[i];
+        }
+        sprite->shift[bank] = shift;
+    }
+    for (int i = 0; i < 4; i++) {
+        int64_t value = i < 2 ? sprite->luma[i] : sprite->chroma[i - 2];
+
+        if (i >= 2 && m->num_sprite_warping_points > 1)
+            value = (value + sprite->chroma[2 + 2 * (i - 2)] +
+                     sprite->chroma[3 + 2 * (i - 2)]) >> sprite->shift[1];
+        value *= 1 << (3 - accuracy);
+        if (value < -16384 || value > 16383)
+            return AVERROR(ENOSYS);
+        sprite->mv[i] = value;
+    }
+    return 0;
+}
