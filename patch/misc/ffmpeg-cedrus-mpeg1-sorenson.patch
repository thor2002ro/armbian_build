+                int n = lengths[length];
+
+                if (get_bits_left(bits) < n)
+                    return AVERROR_INVALIDDATA;
+                if (show_bits(bits, n) == code) {
+                    skip_bits(bits, n);
+                    break;
+                }
+                if (length + 1 < FF_ARRAY_ELEMS(lengths))
+                    code = (code + 1) << (lengths[length + 1] - n);
+            }
+            if (length == FF_ARRAY_ELEMS(lengths) || get_bits_left(bits) < length)
+                return AVERROR_INVALIDDATA;
+            if ((length ? get_xbits(bits, length) : 0) != (int16_t)m->sprite_traj[point][component])
+                return AVERROR_INVALIDDATA;
+            if (component || !(m->divx_version == 500 && m->divx_build == 413)) {
+                if (get_bits_left(bits) < 1 || !get_bits1(bits))
+                    return AVERROR_INVALIDDATA;
+            }
+        }
+    }
+    return 0;
