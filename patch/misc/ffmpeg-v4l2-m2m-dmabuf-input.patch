Subject: [PATCH] Local: avcodec: import DMA-BUF input in V4L2 M2M

Decoded frames already live in DMA-BUF objects, but the encoder copied them through system memory.

Import only layouts that match the V4L2 queue and keep a safe MMAP fallback.
---
--- a/libavcodec/v4l2_buffers.c
+++ b/libavcodec/v4l2_buffers.c
@@ -570,6 +570,101 @@
     return 0;
 }
 
+static int v4l2_buffer_drmframe_to_buf(const AVFrame *frame, V4L2Buffer *out)
+{
+    const AVDRMFrameDescriptor *desc;
+    const AVDRMLayerDescriptor *layer;
+    const struct v4l2_format *fmt = &out->context->format;
+    const int multi = V4L2_TYPE_IS_MULTIPLANAR(fmt->type);
+    int memory_planes = out->num_planes;
+
+    if (frame->format != AV_PIX_FMT_DRM_PRIME || !frame->data[0])
+        return AVERROR(EINVAL);
+
+    desc = (const AVDRMFrameDescriptor *)frame->data[0];
+    if (desc->nb_layers != 1 || desc->nb_objects < 1 ||
+        desc->nb_objects > AV_DRM_MAX_PLANES)
+        return AVERROR(EINVAL);
+    layer = &desc->layers[0];
+    if (layer->nb_planes < 1 || layer->nb_planes > AV_DRM_MAX_PLANES ||
+        memory_planes < 1)
+        return AVERROR(EINVAL);
+
+    for (int i = 0; i < desc->nb_objects; i++) {
+        if (desc->objects[i].fd < 0)
+            return AVERROR(EINVAL);
+        if (desc->objects[i].format_modifier != DRM_FORMAT_MOD_LINEAR)
+            return AVERROR(ENOSYS);
+    }
+
+    /* One queue buffer is safe only when both color planes share its object. */
+    if (memory_planes == 1) {
+        int object = layer->planes[0].object_index;
+        size_t sizeimage = multi ? fmt->fmt.pix_mp.plane_fmt[0].sizeimage :
+                                   fmt->fmt.pix.sizeimage;
+        size_t pitch = multi ? fmt->fmt.pix_mp.plane_fmt[0].bytesperline :
+                               fmt->fmt.pix.bytesperline;
+        size_t height = multi ? fmt->fmt.pix_mp.height : fmt->fmt.pix.height;
+
+        if (out->context->av_pix_fmt == AV_PIX_FMT_NV12 ||
+            out->context->av_pix_fmt == AV_PIX_FMT_NV21) {
+            uint32_t expected_format = out->context->av_pix_fmt == AV_PIX_FMT_NV12 ?
+                                       DRM_FORMAT_NV12 : DRM_FORMAT_NV21;
+
+            if (layer->nb_planes != 2 ||
+                !ff_v4l2_m2m_semiplanar_layout_compatible(
+                    layer->format, expected_format, layer->nb_planes,
+                    layer->planes[0].object_index,
+                    layer->planes[0].offset, layer->planes[0].pitch,
+                    layer->planes[1].object_index, layer->planes[1].offset,
+                    layer->planes[1].pitch, pitch, height)) {
+                av_log(logger(out), AV_LOG_ERROR,
+                       "DMA-BUF layout is incompatible with %s: expected pitch %zu and chroma offset %zu; use -input_mode mmap\n",
+                       out->context->name, pitch, pitch * height);
+                return AVERROR(EINVAL);
+            }
+        }
+
+        if (object < 0 || object >= desc->nb_objects ||
+            layer->planes[0].offset || desc->objects[object].size < sizeimage)
+            return AVERROR(EINVAL);
+        for (int i = 1; i < layer->nb_planes; i++) {
+            if (layer->planes[i].object_index != object)
+                return AVERROR(EINVAL);
+        }
+
+        if (multi) {
+            out->planes[0].m.fd = desc->objects[object].fd;
+            out->planes[0].data_offset = 0;
+            out->planes[0].bytesused = sizeimage;
+            out->planes[0].length = desc->objects[object].size;
+        } else {
+            out->buf.m.fd = desc->objects[object].fd;
+            out->buf.bytesused = sizeimage;
+            out->buf.length = desc->objects[object].size;
+        }
+    } else {
+        if (!multi || layer->nb_planes != memory_planes)
+            return AVERROR(EINVAL);
+        for (int i = 0; i < memory_planes; i++) {
+            int object = layer->planes[i].object_index;
+            size_t offset = layer->planes[i].offset;
+            size_t sizeimage = fmt->fmt.pix_mp.plane_fmt[i].sizeimage;
+
+            if (object < 0 || object >= desc->nb_objects ||
+                offset > desc->objects[object].size ||
+                sizeimage > desc->objects[object].size - offset)
+                return AVERROR(EINVAL);
+            out->planes[i].m.fd = desc->objects[object].fd;
+            out->planes[i].data_offset = offset;
+            out->planes[i].bytesused = offset + sizeimage;
+            out->planes[i].length = desc->objects[object].size;
+        }
+    }
+
+    return 0;
+}
+
 /******************************************************************************
  *
  *              V4L2Buffer interface
@@ -580,6 +652,9 @@
 {
     v4l2_set_pts(out, frame->pts);
 
+    if (out->context->memory == V4L2_MEMORY_DMABUF)
+        return v4l2_buffer_drmframe_to_buf(frame, out);
+
     return v4l2_buffer_swframe_to_buf(frame, out);
 }
 
@@ -687,7 +762,7 @@
     V4L2Context *ctx = avbuf->context;
     int ret, i;
 
-    avbuf->buf.memory = V4L2_MEMORY_MMAP;
+    avbuf->buf.memory = ctx->memory;
     avbuf->buf.type = ctx->type;
     avbuf->buf.index = index;
 
@@ -717,6 +792,27 @@
         avbuf->buf.m.planes = avbuf->planes;
     }
 
+    if (ctx->memory == V4L2_MEMORY_DMABUF) {
+        if (V4L2_TYPE_IS_MULTIPLANAR(ctx->type)) {
+            avbuf->num_planes = ctx->format.fmt.pix_mp.num_planes;
+            if (avbuf->num_planes < 1 || avbuf->num_planes > VIDEO_MAX_PLANES)
+                return AVERROR(EINVAL);
+            avbuf->buf.length = avbuf->num_planes;
+            for (i = 0; i < avbuf->num_planes; i++) {
+                avbuf->plane_info[i].bytesperline =
+                    ctx->format.fmt.pix_mp.plane_fmt[i].bytesperline;
+                avbuf->plane_info[i].length =
+                    ctx->format.fmt.pix_mp.plane_fmt[i].sizeimage;
+            }
+        } else {
+            avbuf->num_planes = 1;
+            avbuf->plane_info[0].bytesperline = ctx->format.fmt.pix.bytesperline;
+            avbuf->plane_info[0].length = ctx->format.fmt.pix.sizeimage;
+        }
+        avbuf->status = V4L2BUF_AVAILABLE;
+        return 0;
+    }
+
     ret = ioctl(buf_to_m2mctx(avbuf)->fd, VIDIOC_QUERYBUF, &avbuf->buf);
     if (ret < 0)
         return AVERROR(errno);
--- a/libavcodec/v4l2_buffers.h
+++ b/libavcodec/v4l2_buffers.h
@@ -48,6 +48,9 @@
     /* DRM descriptor */
     AVDRMFrameDescriptor drm_frame;
 
+    /* Imported frame held until the driver returns this buffer. */
+    AVFrame *source_frame;
+
     /* This object is refcounted per-plane, so we need to keep track
      * of how many context-refs we are holding.
      * This pointer is a RefStruct reference. */
--- a/libavcodec/v4l2_context.c
+++ b/libavcodec/v4l2_context.c
@@ -380,7 +380,7 @@
 
 dequeue:
         memset(&buf, 0, sizeof(buf));
-        buf.memory = V4L2_MEMORY_MMAP;
+        buf.memory = ctx->memory;
         buf.type = ctx->type;
         if (V4L2_TYPE_IS_MULTIPLANAR(ctx->type)) {
             memset(planes, 0, sizeof(planes));
@@ -413,6 +413,7 @@
         }
 
         avbuf = &ctx->buffers[buf.index];
+        av_frame_free(&avbuf->source_frame);
         avbuf->status = V4L2BUF_AVAILABLE;
         avbuf->buf = buf;
         if (V4L2_TYPE_IS_MULTIPLANAR(ctx->type)) {
@@ -447,7 +448,7 @@
 static int v4l2_release_buffers(V4L2Context* ctx)
 {
     struct v4l2_requestbuffers req = {
-        .memory = V4L2_MEMORY_MMAP,
+        .memory = ctx->memory,
         .type = ctx->type,
         .count = 0, /* 0 -> unmap all buffers from the driver */
     };
@@ -456,6 +457,8 @@
     for (i = 0; i < ctx->num_buffers; i++) {
         V4L2Buffer *buffer = &ctx->buffers[i];
 
+        av_frame_free(&buffer->source_frame);
+
         for (j = 0; j < buffer->num_planes; j++) {
             struct V4L2Plane_info *p = &buffer->plane_info[j];
 
@@ -621,6 +624,8 @@
 int ff_v4l2_context_enqueue_frame(V4L2Context* ctx, const AVFrame* frame)
 {
     V4L2m2mContext *s = ctx_to_m2mctx(ctx);
+    const AVFrame *input_frame = frame;
+    AVFrame *transfer_frame = NULL;
     V4L2Buffer* avbuf;
     int ret;
 
@@ -636,11 +641,40 @@
     if (!avbuf)
         return AVERROR(EAGAIN);
 
-    ret = ff_v4l2_buffer_avframe_to_buf(frame, avbuf);
+    if (ff_v4l2_context_needs_transfer(ctx, frame)) {
+        transfer_frame = av_frame_alloc();
+        if (!transfer_frame)
+            return AVERROR(ENOMEM);
+        transfer_frame->format = ctx->av_pix_fmt;
+        ret = av_hwframe_transfer_data(transfer_frame, frame, 0);
+        if (ret < 0) {
+            av_log(logger(ctx), AV_LOG_ERROR,
+                   "Failed to transfer DRM PRIME input to software memory: %s\n",
+                   av_err2str(ret));
+            goto fail;
+        }
+        transfer_frame->pts = frame->pts;
+        input_frame = transfer_frame;
+    }
+
+    ret = ff_v4l2_buffer_avframe_to_buf(input_frame, avbuf);
     if (ret)
-        return ret;
+        goto fail;
 
-    return ff_v4l2_buffer_enqueue(avbuf);
+    if (ctx->memory == V4L2_MEMORY_DMABUF) {
+        avbuf->source_frame = av_frame_clone(frame);
+        if (!avbuf->source_frame) {
+            ret = AVERROR(ENOMEM);
+            goto fail;
+        }
+    }
+
+    ret = ff_v4l2_buffer_enqueue(avbuf);
+    if (ret < 0)
+        av_frame_free(&avbuf->source_frame);
+fail:
+    av_frame_free(&transfer_frame);
+    return ret;
 }
 
 int ff_v4l2_context_enqueue_packet(V4L2Context* ctx, const AVPacket* pkt)
@@ -771,9 +805,18 @@
 
     memset(&req, 0, sizeof(req));
     req.count = ctx->num_buffers;
-    req.memory = V4L2_MEMORY_MMAP;
+    req.memory = ctx->memory;
     req.type = ctx->type;
     ret = ioctl(s->fd, VIDIOC_REQBUFS, &req);
+    if (ret < 0 && ff_v4l2_context_use_mmap_fallback(ctx, errno)) {
+        av_log(logger(ctx), AV_LOG_WARNING,
+               "%s DMA-BUF input is unsupported; falling back to MMAP software transfer\n",
+               ctx->name);
+        ctx->memory = V4L2_MEMORY_MMAP;
+        req.count = ctx->num_buffers;
+        req.memory = ctx->memory;
+        ret = ioctl(s->fd, VIDIOC_REQBUFS, &req);
+    }
     if (ret < 0) {
         av_log(logger(ctx), AV_LOG_ERROR, "%s VIDIOC_REQBUFS failed: %s\n", ctx->name, strerror(errno));
         return AVERROR(errno);
--- a/libavcodec/v4l2_context.h
+++ b/libavcodec/v4l2_context.h
@@ -24,6 +24,7 @@
 #ifndef AVCODEC_V4L2_CONTEXT_H
 #define AVCODEC_V4L2_CONTEXT_H
 
+#include <errno.h>
 #include <stdint.h>
 #include <linux/videodev2.h>
 
@@ -48,6 +49,16 @@
     enum v4l2_buf_type type;
 
     /**
+     * V4L2 memory type used for this buffer context.
+     */
+    enum v4l2_memory memory;
+
+    /**
+     * Allow an unsupported DMA-BUF queue to retry with MMAP.
+     */
+    int allow_mmap_fallback;
+
+    /**
      * AVPixelFormat corresponding to this buffer context.
      * AV_PIX_FMT_NONE means this is an encoded stream.
      */
@@ -97,6 +108,20 @@
 
 } V4L2Context;
 
+static inline int ff_v4l2_context_use_mmap_fallback(const V4L2Context *ctx,
+                                                     int error)
+{
+    return ctx->memory == V4L2_MEMORY_DMABUF &&
+           ctx->allow_mmap_fallback && error == EINVAL;
+}
+
+static inline int ff_v4l2_context_needs_transfer(const V4L2Context *ctx,
+                                                  const AVFrame *frame)
+{
+    return ctx->memory == V4L2_MEMORY_MMAP &&
+           frame->format == AV_PIX_FMT_DRM_PRIME;
+}
+
 /**
  * Initializes a V4L2Context.
  *
--- a/libavcodec/v4l2_m2m.c
+++ b/libavcodec/v4l2_m2m.c
@@ -363,6 +363,8 @@
     /* populate it */
     priv->context->capture.num_buffers = priv->num_capture_buffers;
     priv->context->output.num_buffers  = priv->num_output_buffers;
+    priv->context->capture.memory = V4L2_MEMORY_MMAP;
+    priv->context->output.memory = V4L2_MEMORY_MMAP;
     priv->context->self_ref = priv->context;
     priv->context->fd = -1;
 
--- a/libavcodec/v4l2_m2m.h
+++ b/libavcodec/v4l2_m2m.h
@@ -41,6 +41,52 @@
     { "num_output_buffers", "Number of buffers in the output context",\
         OFFSET(num_output_buffers), AV_OPT_TYPE_INT, { .i64 = 16 }, 2, INT_MAX, FLAGS }
 
+enum V4L2m2mInputMode {
+    V4L2_M2M_INPUT_AUTO,
+    V4L2_M2M_INPUT_DMABUF,
+    V4L2_M2M_INPUT_MMAP,
+};
+
+static inline int ff_v4l2_m2m_dmabuf_layout_compatible(int frame_width,
+                                                        int frame_height,
+                                                        int visible_width,
+                                                        int visible_height)
+{
+    return frame_width == visible_width &&
+           frame_height == visible_height;
+}
+
+static inline int ff_v4l2_m2m_resolve_input_mode(int input_mode,
+                                                  int frame_width,
+                                                  int frame_height,
+                                                  int visible_width,
+                                                  int visible_height)
+{
+    if (ff_v4l2_m2m_dmabuf_layout_compatible(frame_width, frame_height,
+                                               visible_width, visible_height))
+        return input_mode;
+    if (input_mode == V4L2_M2M_INPUT_AUTO)
+        return V4L2_M2M_INPUT_MMAP;
+    if (input_mode == V4L2_M2M_INPUT_DMABUF)
+        return -1;
+    return input_mode;
+}
+
+static inline int ff_v4l2_m2m_semiplanar_layout_compatible(
+    uint32_t format, uint32_t expected_format, int plane_count,
+    int luma_object, size_t luma_offset, size_t luma_pitch,
+    int chroma_object, size_t chroma_offset, size_t chroma_pitch,
+    size_t expected_pitch, size_t expected_height)
+{
+    return format == expected_format &&
+           plane_count == 2 &&
+           luma_object == chroma_object &&
+           luma_offset == 0 &&
+           luma_pitch == expected_pitch &&
+           chroma_offset == expected_pitch * expected_height &&
+           chroma_pitch == expected_pitch;
+}
+
