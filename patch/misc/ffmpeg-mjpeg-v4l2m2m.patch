+static int v4l2_mjpeg_rc_init(AVCodecContext *avctx)
+{
+    V4L2m2mPriv *priv = avctx->priv_data;
+    AVRational fps = avctx->framerate;
+    int64_t min_rate = avctx->rc_min_rate, max_rate = avctx->rc_max_rate;
+
+    priv->jpeg_rc_quality = priv->jpeg_quality;
+    priv->jpeg_pending = 0;
+    priv->jpeg_target_bits = 0;
+    if (!avctx->bit_rate && !min_rate && !max_rate)
+        return 0;
+    if (avctx->bit_rate <= 0)
+        return AVERROR(EINVAL);
+    if (fps.num <= 0 || fps.den <= 0)
+        fps = av_inv_q(avctx->time_base);
+    if (fps.num <= 0 || fps.den <= 0)
+        return AVERROR(EINVAL);
+    if (!min_rate && !max_rate)
+        min_rate = max_rate = avctx->bit_rate;
+    if ((min_rate != avctx->bit_rate || max_rate != avctx->bit_rate) &&
+        (min_rate < 0 || min_rate >= avctx->bit_rate || max_rate <= avctx->bit_rate))
+        return AVERROR(EINVAL);
+    priv->jpeg_target_bits = av_rescale_rnd(avctx->bit_rate, fps.den, fps.num, AV_ROUND_ZERO);
+    priv->jpeg_min_bits = av_rescale_rnd(min_rate, fps.den, fps.num, AV_ROUND_ZERO);
+    priv->jpeg_max_bits = av_rescale_rnd(max_rate, fps.den, fps.num, AV_ROUND_ZERO);
+    if (priv->jpeg_target_bits <= 0 || priv->jpeg_max_bits > INT_MAX ||
+        priv->jpeg_max_bits < 0 || priv->jpeg_min_bits < 0)
+        return AVERROR(EINVAL);
+    priv->jpeg_tolerance_bits = priv->jpeg_target_bits * 0.05;
+    return 0;
+}
+
+static int v4l2_mjpeg_rc_quality(const V4L2m2mPriv *priv, int64_t bits)
+{
+    int quality = priv->jpeg_rc_quality;
+
+    if (!bits)
+        return quality;
+    if (priv->jpeg_min_bits == priv->jpeg_target_bits &&
+        priv->jpeg_max_bits == priv->jpeg_target_bits) {
+        int step = quality > 85 ? 1 : 2;
+        int64_t delta = priv->jpeg_target_bits - bits;
+
+        if (delta > priv->jpeg_tolerance_bits)
+            quality += step;
+        else if (delta < -priv->jpeg_tolerance_bits)
+            quality -= step;
+    } else if (bits > priv->jpeg_max_bits) {
+        quality -= 2;
+    } else if (bits < priv->jpeg_min_bits) {
+        quality += 2;
+    }
+    return av_clip(quality, 10, 100);
+}
+
+static int v4l2_prepare_mjpeg_encoder(V4L2m2mContext *s)
+{
+    AVCodecContext *avctx = s->avctx;
+    V4L2m2mPriv *priv = avctx->priv_data;
+    int ret;
+
+    if (avctx->max_b_frames) {
+        av_log(avctx, AV_LOG_ERROR, "MJPEG does not support B-frames\n");
+        return AVERROR(EINVAL);
+    }
+    if (avctx->flags & AV_CODEC_FLAG_QSCALE) {
+        av_log(avctx, AV_LOG_ERROR, "Use -quality (1-100) for JPEG quality\n");
+        return AVERROR(EINVAL);
+    }
+
+    ret = v4l2_mjpeg_rc_init(avctx);
+    if (ret < 0) {
+        av_log(avctx, AV_LOG_ERROR, "Invalid MJPEG bitrate or frame rate\n");
+        return ret;
+    }
+    return v4l2_set_ext_ctrl(s, V4L2_CID_JPEG_COMPRESSION_QUALITY,
+                             priv->jpeg_quality, "JPEG quality", 1);
+}
+
 static int v4l2_prepare_encoder(V4L2m2mContext *s)
 {
     AVCodecContext *avctx = s->avctx;
@@ -182,15 +266,15 @@
      */
