+        total += sizes[i];
+    }
+    for (int i = 0; i < planes; i++) {
+        int physical = out->num_planes == 1 ? 0 : i;
+        uint8_t *dst = (uint8_t *)out->plane_info[physical].mm_addr + offsets[i];
+
+        memset(dst, 0, sizes[i]);
+        av_image_copy_plane(dst, strides[i], frame->data[i], frame->linesize[i],
+                            row_bytes[i], rows[i]);
+        if (out->num_planes > 1) {
+            out->planes[i].bytesused = sizes[i];
+            out->planes[i].length = out->plane_info[i].length;
         }
-        return 0;
-    }
-
-    for (i = 0; i < out->num_planes; i++) {
-        ret = v4l2_bufref_to_buf(out, i, frame->buf[i]->data, frame->buf[i]->size, 0);
-        if (ret)
-            return ret;
-    }
-
+    }
+    if (out->num_planes == 1) {
+        if (multi) {
