 static int v4l2_receive_packet(AVCodecContext *avctx, AVPacket *avpkt)
 {
-    V4L2m2mContext *s = ((V4L2m2mPriv*)avctx->priv_data)->context;
+    V4L2m2mPriv *priv = avctx->priv_data;
+    V4L2m2mContext *s = priv->context;
     V4L2Context *const capture = &s->capture;
     V4L2Context *const output = &s->output;
     AVFrame *frame = s->frame;
     int ret;
 
-    if (s->draining)
+    if (s->draining ||
+        (avctx->codec_id == AV_CODEC_ID_MJPEG && priv->jpeg_pending))
         goto dequeue;
 
     if (!frame->buf[0]) {
@@ -328,7 +427,14 @@
     }
 
 dequeue:
-    return ff_v4l2_context_dequeue_packet(capture, avpkt);
+    ret = ff_v4l2_context_dequeue_packet(capture, avpkt);
+    if (ret >= 0 && avctx->codec_id == AV_CODEC_ID_MJPEG) {
+        avpkt->flags |= AV_PKT_FLAG_KEY;
+        priv->jpeg_pending = 0;
+        if (priv->jpeg_target_bits && !(avpkt->flags & AV_PKT_FLAG_CORRUPT))
+            priv->jpeg_rc_quality = v4l2_mjpeg_rc_quality(priv, (int64_t)avpkt->size * 8);
+    }
+    return ret;
 }
 
 static av_cold int v4l2_encode_init(AVCodecContext *avctx)
@@ -340,6 +446,19 @@
     uint32_t v4l2_fmt_output;
     int ret;
 
+    if (avctx->codec_id == AV_CODEC_ID_MJPEG) {
+        if (avctx->color_range == AVCOL_RANGE_UNSPECIFIED)
+            avctx->color_range = AVCOL_RANGE_JPEG;
+        if (avctx->colorspace == AVCOL_SPC_UNSPECIFIED)
+            avctx->colorspace = AVCOL_SPC_BT470BG;
+        if (avctx->color_range != AVCOL_RANGE_JPEG ||
+            (avctx->colorspace != AVCOL_SPC_BT470BG &&
+             avctx->colorspace != AVCOL_SPC_SMPTE170M)) {
+            av_log(avctx, AV_LOG_ERROR, "MJPEG requires full-range BT.601 input\n");
+            return AVERROR(EINVAL);
+        }
+    }
+
     ret = ff_v4l2_m2m_create_context(priv, &s);
