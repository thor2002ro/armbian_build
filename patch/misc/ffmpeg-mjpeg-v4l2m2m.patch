+        strides[i] = out->plane_info[physical].bytesperline;
+        if (out->num_planes == 1 && i && planes == 3)
+            strides[i] = AV_CEIL_RSHIFT(strides[i], desc->log2_chroma_w);
+        if (!frame->data[i] || !out->plane_info[physical].mm_addr ||
+            strides[i] < row_bytes[i] ||
+            (source_stride < 0 ? -source_stride : source_stride) < row_bytes[i])
+            return AVERROR(EINVAL);
+    }
+    ret = av_image_fill_plane_sizes(sizes, frame->format, height, strides);
+    if (ret < 0)
+        return ret;
+    for (int i = 0; i < planes; i++) {
+        int physical = out->num_planes == 1 ? 0 : i;
+        size_t length = out->plane_info[physical].length;
