-            ret = v4l2_bufref_to_buf(out, 0, frame->data[i], size, offset);
-            if (ret)
-                return ret;
-            offset += size;
+    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(frame->format);
+    const struct v4l2_format *fmt = &out->context->format;
+    const int multi = V4L2_TYPE_IS_MULTIPLANAR(fmt->type);
+    const int width = multi ? fmt->fmt.pix_mp.width : fmt->fmt.pix.width;
+    const int height = multi ? fmt->fmt.pix_mp.height : fmt->fmt.pix.height;
+    const uint32_t fourcc = multi ? fmt->fmt.pix_mp.pixelformat : fmt->fmt.pix.pixelformat;
+    int row_bytes[4], planes, rows[4], ret;
+    ptrdiff_t strides[4] = { 0 };
+    size_t sizes[4], offsets[4] = { 0 }, total = 0;
+
+    if (!desc || width <= 0 || height <= 0 ||
+        frame->width != width || frame->height != height ||
+        (desc->flags & (AV_PIX_FMT_FLAG_PAL | AV_PIX_FMT_FLAG_HWACCEL)) ||
+        fourcc == V4L2_PIX_FMT_NV12MT || fourcc == V4L2_PIX_FMT_NV12MT_16X16)
