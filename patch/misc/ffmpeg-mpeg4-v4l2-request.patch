diff --git a/libavcodec/v4l2_request_mpeg4.h b/libavcodec/v4l2_request_mpeg4.h
new file mode 100644
--- /dev/null
+++ b/libavcodec/v4l2_request_mpeg4.h
@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _MPEG4_CTRLS_H_
+#define _MPEG4_CTRLS_H_
+#include <linux/types.h>
+#include <linux/v4l2-controls.h>
+#include <linux/videodev2.h>
+
+#define V4L2_PIX_FMT_MPEG4_FRAME v4l2_fourcc('M', 'P', '4', 'F')
+#define V4L2_PIX_FMT_H263_FRAME v4l2_fourcc('H', '2', '6', 'F')
+#define V4L2_CID_STATELESS_MPEG4_FRAME (V4L2_CID_CODEC_STATELESS_BASE + 602)
+#define V4L2_MPEG4_MAX_PACKETS 512
+#define V4L2_MPEG4_SHORT_HEADER (1U << 0)
+#define V4L2_MPEG4_MPEG_QUANT (1U << 1)
+#define V4L2_MPEG4_QUARTER_SAMPLE (1U << 2)
+#define V4L2_MPEG4_NO_ROUNDING (1U << 3)
+#define V4L2_MPEG4_RESYNC_DISABLED (1U << 4)
+
+struct v4l2_mpeg4_packet {
+	__u32 bit_offset;
+	__u16 first_mb;
+	__u8 quantizer;
+	__u8 intra_dc_threshold;
+};
+
+struct v4l2_ctrl_mpeg4_frame {
+	__u64 reference_ts[2]; /* Forward, backward. */
+	__u32 flags;
+	__u32 bitstream_size;
+	__u16 width, height;
+	__u16 trb, trd;
+	__u16 num_packets;
+	__u8 picture_type; /* I=0, P=1, B=2. */
+	__u8 forward_code, backward_code, backward_type;
+	__u8 reserved[2];
+	__u8 intra_quant[64]; /* Zigzag order. */
+	__u8 inter_quant[64];
+	struct v4l2_mpeg4_packet packets[V4L2_MPEG4_MAX_PACKETS];
+};
+#endif
diff --git a/libavcodec/v4l2_request_mpeg4.c b/libavcodec/v4l2_request_mpeg4.c
new file mode 100644
--- /dev/null
+++ b/libavcodec/v4l2_request_mpeg4.c
@@ -0,0 +1,246 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "config_components.h"
+#include "libavutil/avassert.h"
+#include "decode.h"
+#include "h263dec.h"
+#include "hwaccel_internal.h"
+#include "hwconfig.h"
+#include "internal.h"
+#include "mpeg4videodec.h"
+#include "mpegvideodata.h"
+#include "v4l2_request.h"
+#include "v4l2_request_mpeg4.h"
+
+typedef struct MPEG4RequestContext {
+    V4L2RequestContext request;
+    V4L2RequestPictureContext picture;
+    struct v4l2_ctrl_mpeg4_frame frame;
+} MPEG4RequestContext;
+
+static int mpeg4_dc_threshold(int value)
+{
+    static const int thresholds[] = { 99, 13, 15, 17, 19, 21, 23, 0 };
+    for (int i = 0; i < FF_ARRAY_ELEMS(thresholds); i++)
+        if (value == thresholds[i])
+            return i;
+    return -1;
+}
+
+static int mpeg4_packet_headers(AVCodecContext *avctx, GetBitContext *bits,
+                               struct v4l2_ctrl_mpeg4_frame *f)
+{
+    Mpeg4DecContext *m = avctx->priv_data;
+    GetBitContext scan = *bits;
+    unsigned total = AV_CEIL_RSHIFT(f->width, 4) * AV_CEIL_RSHIFT(f->height, 4);
+    unsigned mb_bits = av_log2(total - 1) + 1;
+    unsigned marker = 17;
+    unsigned step = f->flags & V4L2_MPEG4_SHORT_HEADER ? 1 : 8;
+    unsigned start = get_bits_count(&scan);
+    if (!(f->flags & V4L2_MPEG4_SHORT_HEADER)) {
+        if (f->picture_type == 1)
+            marker += f->forward_code - 1;
+        else if (f->picture_type == 2)
+            marker += FFMAX(2, FFMAX(f->forward_code, f->backward_code)) - 1;
+        if (f->flags & V4L2_MPEG4_RESYNC_DISABLED)
+            return 0;
+        align_get_bits(&scan);
+    }
+    while (get_bits_left(&scan) >= marker + 12) {
+        GetBitContext header;
+        struct v4l2_mpeg4_packet packet = f->packets[f->num_packets - 1];
+        unsigned first;
+        int extension;
+        if (get_bits_count(&scan) <= start || show_bits_long(&scan, marker) != 1) {
+            skip_bits(&scan, step);
+            continue;
+        }
+        header = scan;
+        skip_bits_long(&header, marker);
+        if (f->flags & V4L2_MPEG4_SHORT_HEADER) {
+            unsigned gob = get_bits(&header, 5);
+            unsigned gob_height = f->height <= 400 ? 1 : f->height <= 800 ? 2 : 4;
+            if (!gob)
+                continue;
+            first = gob * gob_height * AV_CEIL_RSHIFT(f->width, 4);
+            skip_bits(&header, 2);
+            packet.quantizer = get_bits(&header, 5);
+        } else {
+            first = get_bits(&header, mb_bits);
+            unsigned quantizer = get_bits(&header, 5);
+            if (quantizer)
+                packet.quantizer = quantizer;
+            extension = get_bits1(&header);
+            if (extension) {
+                while (get_bits_left(&header) > 0 && get_bits1(&header))
+                    ;
+                if (get_bits_left(&header) < m->time_increment_bits + 7 ||
+                    !get_bits1(&header))
+                    return AVERROR_INVALIDDATA;
+                skip_bits(&header, m->time_increment_bits);
+                if (!get_bits1(&header) || get_bits(&header, 2) != f->picture_type)
+                    return AVERROR_INVALIDDATA;
+                packet.intra_dc_threshold = get_bits(&header, 3);
+                if (f->picture_type && get_bits(&header, 3) != f->forward_code)
+                    return AVERROR_INVALIDDATA;
+                if (f->picture_type == 2 && get_bits(&header, 3) != f->backward_code)
+                    return AVERROR_INVALIDDATA;
+            }
+        }
+        if (get_bits_left(&header) < 0 || !packet.quantizer ||
+            first <= packet.first_mb || first >= total)
+            return AVERROR_INVALIDDATA;
+        if (f->num_packets == V4L2_MPEG4_MAX_PACKETS)
+            return AVERROR(ENOSYS);
+        packet.first_mb = first;
+        packet.bit_offset = get_bits_count(&header);
+        f->packets[f->num_packets++] = packet;
+        scan = header;
+        if (step == 8)
+            align_get_bits(&scan);
+    }
+    return 0;
+}
+
+static int mpeg4_request_start(AVCodecContext *avctx, const AVBufferRef *ref,
+                              const uint8_t *buffer, uint32_t size)
+{
+    H263DecContext *h = avctx->priv_data;
+    MPVContext *s = &h->c;
+    MPEG4RequestContext *ctx = avctx->internal->hwaccel_priv_data;
+    struct v4l2_ctrl_mpeg4_frame *f = &ctx->frame;
+    int short_header = avctx->codec_id == AV_CODEC_ID_H263;
+    int ret;
+
+    if (s->pict_type < AV_PICTURE_TYPE_I || s->pict_type > AV_PICTURE_TYPE_B ||
+        !s->progressive_sequence || s->width < 16 || s->height < 16 ||
+        s->width > 4096 || s->height > 4096 || size > 16 * 1024 * 1024 ||
+        h->pb_frame || h->h263_long_vectors || h->umvplus || s->obmc ||
+        s->h263_aic || h->loop_filter || h->modified_quant ||
+        h->alt_inter_vlc || h->h263_slice_structured || h->data_partitioning)
+        return AVERROR(ENOSYS);
+    if (!short_header) {
+        for (unsigned i = (get_bits_count(&h->gb) + 7) / 8; i + 4 <= size; i++) {
+            if (!buffer[i] && !buffer[i + 1] && buffer[i + 2] == 1 &&
+                buffer[i + 3] >= 0xb0) {
+                size = i;
+                break;
+            }
+        }
+    }
+    *f = (struct v4l2_ctrl_mpeg4_frame) {
+        .width = s->width, .height = s->height, .num_packets = 1,
+        .picture_type = s->pict_type - AV_PICTURE_TYPE_I,
+        .bitstream_size = size, .trb = s->pb_time, .trd = s->pp_time,
+        .flags = s->no_rounding ? V4L2_MPEG4_NO_ROUNDING : 0,
+        .forward_code = 1, .backward_code = 1,
+    };
+    f->packets[0].bit_offset = get_bits_count(&h->gb);
+    f->packets[0].quantizer = s->qscale;
+    if (short_header) {
+        GetBitContext header;
+        if (init_get_bits8(&header, buffer, size) < 0 || size < 5)
+            return AVERROR_INVALIDDATA;
+        skip_bits_long(&header, 35);
+        if (get_bits(&header, 3) == 7)
+            return AVERROR(ENOSYS);
+        if (s->pict_type == AV_PICTURE_TYPE_B || h->custom_pcf ||
+            !((s->width == 128 && s->height == 96) ||
+              (s->width == 176 && s->height == 144) ||
+              (s->width == 352 && s->height == 288) ||
+              (s->width == 704 && s->height == 576) ||
+              (s->width == 1408 && s->height == 1152)))
+            return AVERROR(ENOSYS);
+        f->flags |= V4L2_MPEG4_SHORT_HEADER;
+    } else {
+        Mpeg4DecContext *m = avctx->priv_data;
+        int threshold = mpeg4_dc_threshold(m->intra_dc_threshold);
+        if (m->shape || m->vol_sprite_usage || m->new_pred || m->scalability ||
+            m->quant_precision != 5 || m->rvlc || threshold < 0)
+            return AVERROR(ENOSYS);
+        f->packets[0].intra_dc_threshold = threshold;
+        f->forward_code = s->pict_type == AV_PICTURE_TYPE_I ? 1 : m->f_code;
+        f->backward_code = s->pict_type == AV_PICTURE_TYPE_B ? m->b_code : 1;
+        if (!m->resync_marker)
+            f->flags |= V4L2_MPEG4_RESYNC_DISABLED;
+        if (m->mpeg_quant)
+            f->flags |= V4L2_MPEG4_MPEG_QUANT;
+        if (s->quarter_sample)
+            f->flags |= V4L2_MPEG4_QUARTER_SAMPLE;
+    }
+    for (int i = 0; i < 64; i++) {
+        int n = s->idsp.idct_permutation[ff_zigzag_direct[i]];
+        f->intra_quant[i] = s->intra_matrix[n];
+        f->inter_quant[i] = s->inter_matrix[n];
+    }
+    if (s->pict_type != AV_PICTURE_TYPE_I && s->last_pic.ptr)
+        f->reference_ts[0] = ff_v4l2_request_get_capture_timestamp(s->last_pic.ptr->f);
+    if (s->pict_type == AV_PICTURE_TYPE_B && s->next_pic.ptr) {
+        f->reference_ts[1] = ff_v4l2_request_get_capture_timestamp(s->next_pic.ptr->f);
+        f->backward_type = s->next_pic.ptr->f->pict_type - AV_PICTURE_TYPE_I;
+    }
+    ret = mpeg4_packet_headers(avctx, &h->gb, f);
+    if (ret < 0)
+        return ret;
+    ret = ff_v4l2_request_start_frame(avctx, &ctx->picture, s->cur_pic.ptr->f);
+    if (ret < 0)
+        return ret;
+    return ff_v4l2_request_append_output(avctx, &ctx->picture, buffer, size);
+}
+
+static int mpeg4_request_slice(AVCodecContext *avctx, const uint8_t *buffer, uint32_t size)
+{
+    return 0;
+}
+
+static int mpeg4_request_end(AVCodecContext *avctx)
+{
+    H263DecContext *h = avctx->priv_data;
+    MPEG4RequestContext *ctx = avctx->internal->hwaccel_priv_data;
+    AVFrame *frame = h->c.cur_pic.ptr->f;
+    struct v4l2_ext_control control = {
+        .id = V4L2_CID_STATELESS_MPEG4_FRAME,
+        .ptr = &ctx->frame, .size = sizeof(ctx->frame),
+    };
+    FrameDecodeData *fdd;
+    int ret = ff_v4l2_request_decode_frame(avctx, &ctx->picture, &control, 1);
+    if (ret >= 0)
+        ret = ff_v4l2_request_wait_frame(avctx, frame);
+    if (ret < 0) {
+        ff_hwaccel_uninit(avctx);
+        return ret;
+    }
+    fdd = frame->private_ref;
+    if (fdd)
+        fdd->post_process = NULL;
+    return 0;
+}
+
+static int mpeg4_request_params(AVCodecContext *avctx, AVBufferRef *frames)
+{
+    return ff_v4l2_request_frame_params(avctx, frames,
+        avctx->codec_id == AV_CODEC_ID_H263 ? V4L2_PIX_FMT_H263_FRAME :
+                                            V4L2_PIX_FMT_MPEG4_FRAME, 8);
+}
+
+static int mpeg4_request_init(AVCodecContext *avctx)
+{
+    return ff_v4l2_request_init(avctx, NULL, 0, NULL);
+}
+
+#define MPEG4_REQUEST_HWACCEL(codec, codec_id_value) \
+const FFHWAccel ff_##codec##_v4l2request_hwaccel = { \
+    .p.name = #codec "_v4l2request", .p.type = AVMEDIA_TYPE_VIDEO, .p.id = codec_id_value, \
+    .p.pix_fmt = AV_PIX_FMT_DRM_PRIME, .start_frame = mpeg4_request_start, \
+    .decode_slice = mpeg4_request_slice, .end_frame = mpeg4_request_end, \
+    .init = mpeg4_request_init, .uninit = ff_v4l2_request_uninit, \
+    .flush = ff_v4l2_request_flush, .frame_params = mpeg4_request_params, \
+    .priv_data_size = sizeof(MPEG4RequestContext), \
+    .caps_internal = HWACCEL_CAP_ASYNC_SAFE, \
+}
+
+#if CONFIG_MPEG4_V4L2REQUEST_HWACCEL
+MPEG4_REQUEST_HWACCEL(mpeg4, AV_CODEC_ID_MPEG4);
+#endif
+#if CONFIG_H263_V4L2REQUEST_HWACCEL
+MPEG4_REQUEST_HWACCEL(h263, AV_CODEC_ID_H263);
+#endif
