+        media = udev_device_new_from_devnum(udev, 'c', decoder->media_dev);
+        video = udev_device_new_from_devnum(udev, 'c', decoder->video_dev);
+        media_path = media ? udev_device_get_devnode(media) : NULL;
+        video_path = video ? udev_device_get_devnode(video) : NULL;
+        if (media_path && video_path) {
+            fctxi->media_fd = open(media_path, O_RDWR);
