+static int v4l2request_discover_video(AVHWDeviceContext *hwdev,
+                                      struct udev *udev, dev_t media_dev,
+                                      dev_t video_dev)
+{
+    V4L2RequestDeviceContext *hwctx = hwdev->hwctx;
+    V4L2RequestVideoDecoder decoder = { .media_dev = media_dev, .video_dev = video_dev };
+    V4L2RequestVideoDecoder *decoders;
+    struct udev_device *video = NULL;
+    struct v4l2_capability caps;
+    struct v4l2_create_buffers buffers = { .memory = V4L2_MEMORY_MMAP };
+    struct v4l2_fmtdesc fmt = { 0 };
+    const char *path;
+    unsigned int capabilities;
+    int fd = -1, ret = AVERROR(ENODEV);
+
+    video = udev_device_new_from_devnum(udev, 'c', video_dev);
+    if (!video || !(path = udev_device_get_devnode(video)))
+        goto end;
+    fd = open(path, O_RDWR | O_NONBLOCK);
+    if (fd < 0) {
+        ret = AVERROR(errno);
+        goto end;
+    }
+    if (ioctl(fd, VIDIOC_QUERYCAP, &caps) < 0)
+        goto end;
+    capabilities = caps.capabilities & V4L2_CAP_DEVICE_CAPS ?
+                   caps.device_caps : caps.capabilities;
+    if (!(capabilities & V4L2_CAP_STREAMING))
+        goto end;
+    if (capabilities & V4L2_CAP_VIDEO_M2M_MPLANE)
+        fmt.type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+    else if (capabilities & V4L2_CAP_VIDEO_M2M)
+        fmt.type = V4L2_BUF_TYPE_VIDEO_OUTPUT;
+    else
+        goto end;
+    buffers.format.type = fmt.type;
+    /* Probe request support without allocating buffers. */
+    if (ioctl(fd, VIDIOC_CREATE_BUFS, &buffers) < 0 ||
+        !(buffers.capabilities & V4L2_BUF_CAP_SUPPORTS_REQUESTS))
+        goto end;
+
+    while (ioctl(fd, VIDIOC_ENUM_FMT, &fmt) == 0) {
+        uint32_t *formats = av_realloc_array(decoder.pixelformats,
+                                            decoder.nb_pixelformats + 1,
+                                            sizeof(*formats));
+        if (!formats) {
+            ret = AVERROR(ENOMEM);
+            goto end;
+        }
+        decoder.pixelformats = formats;
+        decoder.pixelformats[decoder.nb_pixelformats++] = fmt.pixelformat;
+        fmt.index++;
+    }
+    if (errno != EINVAL) {
+        ret = AVERROR(errno);
+        goto end;
+    }
+    if (!decoder.nb_pixelformats)
+        goto end;
+    decoders = av_realloc_array(hwctx->decoders, hwctx->nb_decoders + 1,
+                                sizeof(*decoders));
+    if (!decoders) {
+        ret = AVERROR(ENOMEM);
+        goto end;
+    }
+    hwctx->decoders = decoders;
+    hwctx->decoders[hwctx->nb_decoders++] = decoder;
+    decoder.pixelformats = NULL;
+    ret = 0;
+end:
+    av_freep(&decoder.pixelformats);
+    if (fd >= 0)
+        close(fd);
+    udev_device_unref(video);
+    return ret;
+}
+
+static int v4l2request_discover_media(AVHWDeviceContext *hwdev,
+                                      struct udev *udev, const char *path)
+{
+    V4L2RequestDeviceContext *hwctx = hwdev->hwctx;
+    struct media_v2_topology topology = { 0 };
+    struct media_v2_interface *interfaces = NULL;
+    struct stat st;
+    unsigned int interface_count;
+    int fd, ret, count = hwctx->nb_decoders;
+
+    fd = open(path, O_RDWR);
+    if (fd < 0)
+        return AVERROR(errno);
+    if (fstat(fd, &st) < 0) {
+        ret = AVERROR(errno);
+        goto end;
+    }
+    if (!S_ISCHR(st.st_mode)) {
+        ret = AVERROR(ENODEV);
+        goto end;
+    }
+    /* Read the interface count before allocating the topology array. */
+    if (ioctl(fd, MEDIA_IOC_G_TOPOLOGY, &topology) < 0) {
+        ret = AVERROR(errno);
+        goto end;
+    }
+    if (!topology.num_interfaces) {
+        ret = AVERROR(ENODEV);
+        goto end;
+    }
+    interface_count = topology.num_interfaces;
+    interfaces = av_calloc(interface_count, sizeof(*interfaces));
+    if (!interfaces) {
+        ret = AVERROR(ENOMEM);
+        goto end;
+    }
+    topology.ptr_interfaces = (__u64)(uintptr_t)interfaces;
+    if (ioctl(fd, MEDIA_IOC_G_TOPOLOGY, &topology) < 0) {
+        ret = AVERROR(errno);
+        goto end;
+    }
+    if (topology.num_interfaces > interface_count) {
+        ret = AVERROR(EAGAIN);
+        goto end;
+    }
+    for (unsigned int i = 0; i < topology.num_interfaces; i++) {
+        if (interfaces[i].intf_type != MEDIA_INTF_T_V4L_VIDEO)
+            continue;
+        ret = v4l2request_discover_video(hwdev, udev, st.st_rdev,
+                  makedev(interfaces[i].devnode.major, interfaces[i].devnode.minor));
+        if (ret == AVERROR(ENOMEM))
+            goto end;
+    }
+    ret = hwctx->nb_decoders > count ? 0 : AVERROR(ENODEV);
+end:
+    av_free(interfaces);
+    close(fd);
+    return ret;
+}
+
+static int v4l2request_discover_decoders(AVHWDeviceContext *hwdev,
+                                         const char *path)
+{
+    struct udev *udev = udev_new();
+    struct udev_enumerate *enumerate = NULL;
+    struct udev_list_entry *entry;
+    int ret = 0;
+
+    if (!udev)
+        return AVERROR(ENOMEM);
+    if (path) {
+        ret = v4l2request_discover_media(hwdev, udev, path);
+        if (ret < 0)
+            av_log(hwdev, AV_LOG_ERROR, "Cannot use media device %s: %s\n",
+                   path, av_err2str(ret));
+        goto end;
+    }
+    enumerate = udev_enumerate_new(udev);
+    if (!enumerate) {
+        ret = AVERROR(ENOMEM);
+        goto end;
+    }
+    ret = udev_enumerate_add_match_subsystem(enumerate, "media");
+    if (ret < 0)
+        goto end;
+    ret = udev_enumerate_scan_devices(enumerate);
+    if (ret < 0)
+        goto end;
+    udev_list_entry_foreach(entry, udev_enumerate_get_list_entry(enumerate)) {
+        struct udev_device *media = udev_device_new_from_syspath(udev,
+                                             udev_list_entry_get_name(entry));
+        const char *node = media ? udev_device_get_devnode(media) : NULL;
+        if (node)
+            ret = v4l2request_discover_media(hwdev, udev, node);
+        udev_device_unref(media);
+        if (ret == AVERROR(ENOMEM))
+            goto end;
+    }
+    ret = 0;
+end:
+    udev_enumerate_unref(enumerate);
+    udev_unref(udev);
+    return ret;
+}
+
 static int v4l2request_device_create(AVHWDeviceContext *hwdev, const char *device,
                                      AVDictionary *opts, int flags)
 {
@@ -254,11 +438,25 @@
         return ret;
     }

-    // TODO: enumerate V4L2 Request API capable video decoders
-    //       and fill hwctx->decoders and hwctx->nb_decoders,
-    //       limit to decoders for the media 'device' when specified
+    ret = v4l2request_discover_decoders(hwdev, device);
+    if (ret >= 0)
+        hwctx->discovered = 1;
+    return ret;
+}

-    return 0;
+static int v4l2request_device_init(AVHWDeviceContext *hwdev)
+{
+    V4L2RequestDeviceContext *hwctx = hwdev->hwctx;
+    int ret;
+
+    if (hwctx->discovered)
+        return 0;
+    ret = v4l2request_discover_decoders(hwdev, NULL);
+    if (ret < 0)
+        v4l2request_device_uninit(hwdev);
+    else
+        hwctx->discovered = 1;
+    return ret;
 }

 static int v4l2request_validate_format(uint32_t requested,
@@ -622,180 +820,64 @@
     return ret;
 }

