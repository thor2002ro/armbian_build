     };
-    if (h->cavs_tv_compat) {
+    if (h->cavs_tv_compat && !h->hw_legacy_slice) {
         f->flags |= V4L2_CAVS_TV_COMPAT;
         f->chroma_format = h->chroma_format;
         f->sample_precision = h->sample_precision;
