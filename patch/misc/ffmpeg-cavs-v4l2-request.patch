diff --git a/libavcodec/v4l2_request_cavs.c b/libavcodec/v4l2_request_cavs.c
new file mode 100644
--- /dev/null
+++ b/libavcodec/v4l2_request_cavs.c
@@ -0,0 +1,178 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "cavs.h"
+#include "decode.h"
+#include "hwaccel_internal.h"
+#include "hwconfig.h"
+#include "internal.h"
+#include "v4l2_request.h"
+#include "v4l2_request_cavs.h"
+
+typedef struct CAVSRequestContext {
+    V4L2RequestContext request;
+    V4L2RequestPictureContext picture;
+    struct v4l2_ctrl_cavs_frame frame;
+} CAVSRequestContext;
+
+static int cavs_request_start_frame(AVCodecContext *avctx,
+                                     const AVBufferRef *buf_ref,
+                                     const uint8_t *buffer, uint32_t size)
+{
+    AVSContext *h = avctx->priv_data;
+    CAVSRequestContext *ctx = avctx->internal->hwaccel_priv_data;
+    struct v4l2_ctrl_cavs_frame *f = &ctx->frame;
+    int ret = ff_v4l2_request_start_frame(avctx, &ctx->picture, h->cur.f);
+    if (ret < 0)
+        return ret;
+    *f = (struct v4l2_ctrl_cavs_frame) {
+        .width = h->width, .height = h->height,
+        .profile = h->profile, .level = h->level,
+        .picture_type = h->cur.f->pict_type,
+        .picture_distance = h->cur.poc / 2,
+        .picture_qp = h->qp,
+        .quant_index = h->quant_index, .quant_model = h->quant_model,
+        .chroma_qp_delta_cb = h->chroma_qp_delta_cb,
+        .chroma_qp_delta_cr = h->chroma_qp_delta_cr,
+        .alpha_offset = h->alpha_offset, .beta_offset = h->beta_offset,
+    };
+    if (h->cavs_tv_compat) {
+        f->flags |= V4L2_CAVS_TV_COMPAT;
+        f->chroma_format = h->chroma_format;
+        f->sample_precision = h->sample_precision;
+    }
+    if (h->progressive)
+        f->flags |= V4L2_CAVS_PROGRESSIVE;
+    if (h->pic_structure)
+        f->flags |= V4L2_CAVS_FRAME_PICTURE;
+    if (h->top_field_first)
+        f->flags |= V4L2_CAVS_TOP_FIELD_FIRST;
+    if (h->pic_qp_fixed)
+        f->flags |= V4L2_CAVS_FIXED_QP;
+    if (h->skip_mode_flag)
+        f->flags |= V4L2_CAVS_SKIP_MODE;
+    if (h->loop_filter_disable)
+        f->flags |= V4L2_CAVS_LOOP_FILTER_DISABLED;
+    if (h->ref_flag)
+        f->flags |= V4L2_CAVS_PICTURE_REFERENCE;
+    if (h->advanced_pred_mode_disable)
+        f->flags |= V4L2_CAVS_ADVANCED_PRED_DISABLED;
+    if (h->pb_field_enhanced)
+        f->flags |= V4L2_CAVS_PB_FIELD_ENHANCED;
+    if (h->pb_enhanced)
+        f->flags |= V4L2_CAVS_PB_ENHANCED;
+    if (h->weighted_quant)
+        f->flags |= V4L2_CAVS_WEIGHTED_QUANT;
+    if (h->chroma_quant_disabled)
+        f->flags |= V4L2_CAVS_CHROMA_QUANT_DISABLED;
+    if (h->aec)
+        f->flags |= V4L2_CAVS_AEC;
+    for (int i = 0; i < 6; i++)
+        f->quant_param[i] = h->quant_param[i];
+    for (int i = 0; i < 2; i++) {
+        if (h->DPB[i].f->data[0]) {
+            f->reference_ts[i] = ff_v4l2_request_get_capture_timestamp(h->DPB[i].f);
+            f->reference_distance[i] = h->DPB[i].poc / 2;
+            f->reference_flags[i] = h->DPB[i].hw_flags;
+            if (f->picture_type != AV_PICTURE_TYPE_I)
+                f->num_refs++;
+        }
+    }
+    if (f->picture_type == AV_PICTURE_TYPE_B) {
+        f->reference_distance[2] = h->DPB[0].ref_distance[1];
+        f->reference_flags[0] = h->DPB[0].ref_flags[0];
+        f->reference_flags[1] = h->DPB[0].hw_flags;
+    }
+    h->cur.hw_flags = !!h->pic_structure | !!h->top_field_first << 1 |
+                      (h->cur.f->pict_type == AV_PICTURE_TYPE_I) << 2;
+    for (int i = 0; i < 2; i++) {
+        h->cur.ref_distance[i] = f->reference_distance[i];
+        h->cur.ref_flags[i] = h->DPB[i].hw_flags;
+    }
+    return 0;
+}
+
+static int cavs_request_append(AVCodecContext *avctx, const uint8_t *buffer,
+                               uint32_t size)
+{
+    CAVSRequestContext *ctx = avctx->internal->hwaccel_priv_data;
+    int ret;
+
+    if (size > UINT32_MAX - ctx->frame.bitstream_size)
+        return AVERROR_INVALIDDATA;
+    ret = ff_v4l2_request_append_output(avctx, &ctx->picture, buffer, size);
+    if (ret < 0)
+        return ret;
+    ctx->frame.bitstream_size += size;
+    return 0;
+}
+
+static int cavs_request_decode_slice(AVCodecContext *avctx,
+                                      const uint8_t *buffer, uint32_t size)
+{
+    CAVSRequestContext *ctx = avctx->internal->hwaccel_priv_data;
+    static const uint8_t marker = 0x80;
+    uint32_t start = 0;
+    int ret;
+
+    if (!(ctx->frame.flags & V4L2_CAVS_FRAME_PICTURE)) {
+        for (uint32_t i = 4; i < size && size - i >= 4; i++) {
+            if (buffer[i] || buffer[i + 1] || buffer[i + 2] != 1 ||
+                buffer[i + 3] >= 0xb0)
+                continue;
+            ret = cavs_request_append(avctx, buffer + start, i - start);
+            if (ret < 0)
+                return ret;
+            ret = cavs_request_append(avctx, &marker, 1);
+            if (ret < 0)
+                return ret;
+            start = i;
+        }
+    }
+    return cavs_request_append(avctx, buffer + start, size - start);
+}
+
+static int cavs_request_end_frame(AVCodecContext *avctx)
+{
+    AVSContext *h = avctx->priv_data;
+    CAVSRequestContext *ctx = avctx->internal->hwaccel_priv_data;
+    struct v4l2_ext_control control = {
+        .id = V4L2_CID_STATELESS_CAVS_FRAME,
+        .ptr = &ctx->frame, .size = sizeof(ctx->frame),
+    };
+    FrameDecodeData *fdd;
+    int ret = ff_v4l2_request_decode_frame(avctx, &ctx->picture, &control, 1);
+    if (ret < 0)
+        return ret;
+    ret = ff_v4l2_request_wait_frame(avctx, h->cur.f);
+    if (ret < 0)
+        return ret;
+    fdd = h->cur.f->private_ref;
+    if (fdd)
+        fdd->post_process = NULL;
+    return 0;
+}
+
+static int cavs_request_frame_params(AVCodecContext *avctx, AVBufferRef *frames_ref)
+{
+    return ff_v4l2_request_frame_params(avctx, frames_ref, V4L2_PIX_FMT_CAVS_FRAME, 8);
+}
+
+static int cavs_request_init(AVCodecContext *avctx)
+{
+    return ff_v4l2_request_init(avctx, NULL, 0, NULL);
+}
+
+const FFHWAccel ff_cavs_v4l2request_hwaccel = {
+    .p.name = "cavs_v4l2request",
+    .p.type = AVMEDIA_TYPE_VIDEO,
+    .p.id = AV_CODEC_ID_CAVS,
+    .p.pix_fmt = AV_PIX_FMT_DRM_PRIME,
+    .start_frame = cavs_request_start_frame,
+    .decode_slice = cavs_request_decode_slice,
+    .end_frame = cavs_request_end_frame,
+    .init = cavs_request_init,
+    .uninit = ff_v4l2_request_uninit,
+    .flush = ff_v4l2_request_flush,
+    .frame_params = cavs_request_frame_params,
+    .priv_data_size = sizeof(CAVSRequestContext),
+    .caps_internal = HWACCEL_CAP_ASYNC_SAFE,
+};
diff --git a/libavcodec/v4l2_request_cavs.h b/libavcodec/v4l2_request_cavs.h
new file mode 100644
--- /dev/null
+++ b/libavcodec/v4l2_request_cavs.h
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _CAVS_CTRLS_H_
+#define _CAVS_CTRLS_H_
+#include <linux/types.h>
+#include <linux/v4l2-controls.h>
+#include <linux/videodev2.h>
+
+/* Experimental ABI. Keep the kernel and userspace definitions identical. */
+#define V4L2_PIX_FMT_CAVS_FRAME v4l2_fourcc('C', 'A', 'V', 'S')
+#define V4L2_CID_STATELESS_CAVS_FRAME (V4L2_CID_CODEC_STATELESS_BASE + 601)
+#define V4L2_CAVS_PROGRESSIVE (1U << 0)
+#define V4L2_CAVS_FRAME_PICTURE (1U << 1)
+#define V4L2_CAVS_TOP_FIELD_FIRST (1U << 2)
+#define V4L2_CAVS_FIXED_QP (1U << 3)
+#define V4L2_CAVS_SKIP_MODE (1U << 4)
+#define V4L2_CAVS_LOOP_FILTER_DISABLED (1U << 5)
+#define V4L2_CAVS_PICTURE_REFERENCE (1U << 6)
+#define V4L2_CAVS_ADVANCED_PRED_DISABLED (1U << 7)
+#define V4L2_CAVS_PB_FIELD_ENHANCED (1U << 8)
+#define V4L2_CAVS_PB_ENHANCED (1U << 9)
+#define V4L2_CAVS_WEIGHTED_QUANT (1U << 10)
+#define V4L2_CAVS_CHROMA_QUANT_DISABLED (1U << 11)
+#define V4L2_CAVS_AEC (1U << 12)
+#define V4L2_CAVS_TV_COMPAT (1U << 13)
+#define V4L2_CAVS_REF_FRAME (1U << 0)
+#define V4L2_CAVS_REF_TOP_FIRST (1U << 1)
+#define V4L2_CAVS_REF_INTRA (1U << 2)
+
+struct v4l2_ctrl_cavs_frame {
+	__u64 reference_ts[2]; /* Newest reference first. */
+	__u32 bitstream_offset;
+	__u32 bitstream_size;
+	__u32 flags;
+	__u16 width;
+	__u16 height;
+	__u8 profile;
+	__u8 level;
+	__u8 picture_type; /* I=1, P=2, B=3. */
+	__u8 picture_distance;
+	__u8 picture_qp;
+	__u8 num_refs;
+	__u8 quant_index;
+	__u8 quant_model;
+	__s8 chroma_qp_delta_cb;
+	__s8 chroma_qp_delta_cr;
+	__s8 alpha_offset;
+	__s8 beta_offset;
+	__s8 quant_param[6];
+	__u8 reference_distance[3];
+	__u8 reference_flags[2];
+	/* Raw sequence fields. Valid only with V4L2_CAVS_TV_COMPAT. */
+	__u8 chroma_format;
+	__u8 sample_precision;
+	__u8 reserved[7];
+};
+#endif
