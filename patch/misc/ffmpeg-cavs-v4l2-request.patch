+    }
+    return ret;
+}
+
+static const AVOption cavs_options[] = {
+    { "cavs_tv_compat", "Allow legacy AVS header codes with V4L2 Request decoding",
+      offsetof(AVSContext, cavs_tv_compat), AV_OPT_TYPE_BOOL, { .i64 = 0 }, 0, 1,
+      AV_OPT_FLAG_VIDEO_PARAM | AV_OPT_FLAG_DECODING_PARAM },
+    { NULL },
+};
+
+static const AVClass cavs_class = {
+    .class_name = "cavs",
+    .item_name  = av_default_item_name,
+    .option    = cavs_options,
+    .version   = LIBAVUTIL_VERSION_INT,
