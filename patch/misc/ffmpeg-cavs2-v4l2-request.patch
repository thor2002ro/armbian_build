+++ b/libavcodec/v4l2_request_cavs2.h
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _CAVS2_CTRLS_H_
+#define _CAVS2_CTRLS_H_
+
+#include <linux/types.h>
+#include <linux/v4l2-controls.h>
+#include <linux/videodev2.h>
+
+/* Experimental frame control; keep the kernel and userspace definitions identical. */
+#define V4L2_PIX_FMT_CAVS2_FRAME v4l2_fourcc('C', 'A', 'V', '2')
+#define V4L2_CID_STATELESS_CAVS2_FRAME (V4L2_CID_CODEC_STATELESS_BASE + 600)
+#define V4L2_CAVS2_MAX_REFS 7
+#define V4L2_CAVS2_SEQ_MHP_SKIP (1U << 0)
+#define V4L2_CAVS2_SEQ_DHP (1U << 1)
+#define V4L2_CAVS2_SEQ_WSM (1U << 2)
+#define V4L2_CAVS2_SEQ_AMP (1U << 3)
+#define V4L2_CAVS2_SEQ_NSQT (1U << 4)
+#define V4L2_CAVS2_SEQ_SDIP (1U << 5)
+#define V4L2_CAVS2_SEQ_SECOND_TRANSFORM (1U << 6)
+#define V4L2_CAVS2_SEQ_SAO (1U << 7)
+#define V4L2_CAVS2_SEQ_ALF (1U << 8)
+#define V4L2_CAVS2_SEQ_PMVR (1U << 9)
+#define V4L2_CAVS2_SEQ_CROSS_LOOP_FILTER (1U << 10)
+#define V4L2_CAVS2_SEQ_PROGRESSIVE (1U << 11)
+#define V4L2_CAVS2_SEQ_BACKGROUND (1U << 12)
+#define V4L2_CAVS2_FRAME_BACKGROUND_REFERENCE (1U << 3)
+#define V4L2_CAVS2_FRAME_INTERLACED (1U << 4)
+#define V4L2_CAVS2_FRAME_TOP_FIELD_FIRST (1U << 5)
+#define V4L2_CAVS2_FRAME_REPEAT_FIRST_FIELD (1U << 6)
+#define V4L2_CAVS2_FRAME_FIXED_QP (1U << 0)
+#define V4L2_CAVS2_FRAME_LOOP_FILTER_DISABLED (1U << 1)
+#define V4L2_CAVS2_FRAME_REFERENCE (1U << 2)
+
+struct v4l2_ctrl_cavs2_frame {
+	__u64 reference_ts[V4L2_CAVS2_MAX_REFS];
+	__s32 picture_order_count;
+	__u32 sequence_flags;
+	__u32 bitstream_offset;
+	__u32 bitstream_size;
+	__u32 flags;
+	__u16 width;
+	__u16 height;
+	__u8 profile;
+	__u8 bit_depth;
+	__u8 log2_lcu_size;
+	__u8 picture_type; /* I=0, P=1, B=2, F=3, P_BG=4. */
+	__u8 picture_qp;
+	__u8 num_refs;
+	__u8 alf_flags;
+	__u8 num_luma_filters;
+	__s8 chroma_qp_delta_cb;
+	__s8 chroma_qp_delta_cr;
+	__s8 alpha_offset;
+	__s8 beta_offset;
+	__u8 alf_region_index[16];
+	__u8 quant_4x4[16];
+	__u8 quant_8x8[64];
+	__s16 alf_coefficients[18][9]; /* Sixteen luma filters, Cb, Cr. */
+};
+
+#endif
