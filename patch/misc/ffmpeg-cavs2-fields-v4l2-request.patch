+static int cavs2_request_weave(AVFrame *frame,
+                              CAVS2RequestFrame *first, CAVS2RequestFrame *second)
+{
+    AVFrame *maps[3] = { NULL };
+    AVFrame *top = first->top_field ? first->frame : second->frame;
+    AVFrame *bottom = first->top_field ? second->frame : first->frame;
+    AVFrame *surfaces[3] = { top, bottom, frame };
+    AVHWFramesContext *frames;
+    int ret, plane, row, i;
