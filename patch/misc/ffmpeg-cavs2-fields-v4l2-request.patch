+    if (!top->hw_frames_ctx || !bottom->hw_frames_ctx ||
+        top->hw_frames_ctx->data != bottom->hw_frames_ctx->data ||
+        top->width <= 0 || top->height <= 0 ||
+        top->width != bottom->width || top->height != bottom->height)
+        return AVERROR_INVALIDDATA;
+    frames = (AVHWFramesContext *)top->hw_frames_ctx->data;
+    if (top->width > frames->width || top->height > frames->height / 2)
+        return AVERROR_INVALIDDATA;
+
+    /* Completed fields retain their pool after decoder teardown. */
+    ret = av_hwframe_get_buffer(top->hw_frames_ctx, frame, 0);
+    if (ret < 0)
+        goto done;
+    frame->width = top->width;
+    frame->height = top->height * 2;
+    ret = av_frame_copy_props(frame, first->frame);
+    if (ret < 0)
+        goto done;
+    for (i = 0; i < 3; i++) {
+        maps[i] = av_frame_alloc();
+        if (!maps[i]) {
+            ret = AVERROR(ENOMEM);
+            goto done;
+        }
+        ret = av_hwframe_map(maps[i], surfaces[i], i < 2 ?
+                             AV_HWFRAME_MAP_READ : AV_HWFRAME_MAP_WRITE);
+        if (ret < 0)
+            goto done;
+    }
+    if ((maps[0]->format != AV_PIX_FMT_NV12 && maps[0]->format != AV_PIX_FMT_P010) ||
+        maps[0]->format != maps[1]->format || maps[0]->format != maps[2]->format ||
+        top->width != bottom->width || top->height != bottom->height ||
+        frame->width != top->width || frame->height != top->height * 2) {
+        ret = AVERROR_INVALIDDATA;
+        goto done;
+    }
+    for (plane = 0; plane < 2; plane++) {
+        int bytes = (plane ? FFALIGN(top->width, 2) : top->width) *
+                    (maps[0]->format == AV_PIX_FMT_P010 ? 2 : 1);
+        int lines = top->height >> plane;
+        for (i = 0; i < 3; i++) {
+            if (maps[i]->linesize[plane] < bytes) {
+                ret = AVERROR_INVALIDDATA;
+                goto done;
+            }
+        }
+        for (row = 0; row < lines; row++) {
+            memcpy(maps[2]->data[plane] + (ptrdiff_t)(row * 2) * maps[2]->linesize[plane],
+                   maps[0]->data[plane] + (ptrdiff_t)row * maps[0]->linesize[plane], bytes);
+            memcpy(maps[2]->data[plane] + (ptrdiff_t)(row * 2 + 1) * maps[2]->linesize[plane],
+                   maps[1]->data[plane] + (ptrdiff_t)row * maps[1]->linesize[plane], bytes);
+        }
+    }
+    frame->flags |= AV_FRAME_FLAG_INTERLACED;
+    frame->flags &= ~AV_FRAME_FLAG_TOP_FIELD_FIRST;
+    if (first->top_field)
+        frame->flags |= AV_FRAME_FLAG_TOP_FIELD_FIRST;
+    frame->duration = frame->duration > 0 && second->frame->duration > 0 &&
+                      frame->duration <= INT64_MAX - second->frame->duration ?
+                      frame->duration + second->frame->duration : 0;
+    frame->repeat_pict += second->frame->repeat_pict;
+    ret = 0;
+done:
